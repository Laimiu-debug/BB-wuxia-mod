// 500 Independent Dark-Wuxia Character Biographies - Part 1/5 (Tier 0A: 85 bios, wx_bio_001..wx_bio_085)

if (!("BackgroundBios" in ::Wuxia.Config))
	::Wuxia.Config.BackgroundBios <- {};

// =========================================================================
// 1. background.beggar (行乞人) - 8 bios: wx_bio_001..wx_bio_008
// =========================================================================
::Wuxia.Config.BackgroundBios["background.beggar"] <- [
	{ ID = "wx_bio_001", Text = "在城隍庙石阶上装了三年左膝萎缩的瘸子，%name%原本靠这门手艺混得风生水起，直到威远总镖局一匹惊马拖着铁木车轴直冲庙门。满街看客眼睁睁瞧见那『废人』弃了破瓦罐，单手撑墙翻过六尺砖垛，落脚比野猫还轻。戏既穿帮，半条街的香客都追着他讨回铜钱，%name%索性拍拍屁股投奔你们，心想真刀真枪里蹿高伏低，好歹能换口热汤。" },
	{ ID = "wx_bio_002", Text = "汴梁分舵当年给过%name%两只麻布袋，专门盯着盐商后巷谁家倒了馊馒头，顺带替天下丐帮递些市井口信。偏生这厮嘴馋手欠，偷摸舀了舵主两吊酒钱买猪头肉，让人用打狗棒一路从茶坊追打到护城河滩。如今身上青紫刚消，帮里是回不去了，%name%搓着手站在营火边，只求给口干粮和一根趁手的枣木棍。" },
	{ ID = "wx_bio_003", Text = "太行山脚那座漏风山神庙里，大雪封山整整七天，%name%缩在烂供桌底下，亲耳听见两名浑身是血的江湖客互相指骂穴位图谱，天亮前双双僵死在蒲团上。他识不得袖口血字里大半词句，唯独照着上头画的吐纳法门熬过了冻毙之劫。活下来后%name%便不愿再靠讨饭度日，既然老天爷留了这条贱命，总该拿去换几两纹银花花。" },
	{ ID = "wx_bio_004", Text = "北门护城河沿儿的闲汉都还记得，那年霜降有个瘦成柴棍的乞儿，为半张沾满泥灰的烧饼跟一条癞皮黄狗滚进沟里，最后硬是先把狗耳朵咬缺了半块。如今%name%小臂上仍留着三道发白的牙印，说起这事倒半点不臊。他舔舔干裂的嘴唇嘟囔道，跟提刀的悍匪拼命反倒痛快，至少人家杀得利落，不像饿狗专啃人骨头缝。" },
	{ ID = "wx_bio_005", Text = "江淮闹蝗灾那秋，%name%把祖父传下的黄铜旱烟袋典了三碗糠粥，跟着逃荒的独轮车一路往北蹭饭。走到官道驿口时，衙役拿麻绳套人去白修河堤，他趁着暮色扎进半人高的芦苇荡才捡回条命。浑身沾满干泥巴钻进你们营地时，%name%连客套话都不会说，只盯着灶上翻滚的肉汤咽唾沫，发誓只要管饱，前排挡刀他绝不缩脖子。" },
	{ ID = "wx_bio_006", Text = "西门外荒废砖窑常年冷得像冰窖，旁人都忌讳里头半夜飘磷火，唯独%name%敢卷张破草席往窑肚里钻。直到某个起雾的寒夜，他亲眼瞧见个腰悬铜铃的灰衣客领着三具直挺挺的僵尸往湘西方向挪步，吓得屏气埋在煤灰里装死到天明。天亮后%name%在灶口捡到一锭掉落的碎银，转身就投了你们这支带刀的队伍，活人堆里终归暖和些。" },
	{ ID = "wx_bio_007", Text = "方圆八十里哪座县衙的施粥棚掺了石灰水、哪位粮差在乡绅走后偷换陈米，%name%闭着眼睛都能背得一清二楚。常年跪在青石板上看人脸色讨生活，倒练出他二十步外辨别笑面虎的毒辣眼力。如今%name%早厌倦了端着缺口粗碗听施主训话，与其闻着庙门前的酸馊气挨饿，倒不如替真汉子背水扛盾，挣一份腰杆硬气的卖命钱。" },
	{ ID = "wx_bio_008", Text = "起初只是当铺里扫地跑腿的小伙计，奈何迷上摇骰子，一夜输光工钱还倒欠水帮印子钱二十两纹银。为了躲避上门剁指的讨债打手，%name%往脸上抹满锅底灰，整整七个月蹲在菜市口嚼草梗胡言乱语装疯卖傻。听说你们这帮人明日便要拔营出州界，他连夜去河边搓净那张灰脸，笑嘻嘻求着搭顺风路顺便混口兵饷。" }
];

// =========================================================================
// 2. background.cripple (负伤江湖客) - 6 bios: wx_bio_009..wx_bio_014
// =========================================================================
::Wuxia.Config.BackgroundBios["background.cripple"] <- [
	{ ID = "wx_bio_009", Text = "曾在洛阳长风镖局喊过六年趟子号，直到那趟走太行官道遇上太行十八寨截道，一记铁瓜锤生生砸碎了%name%的右膝盖骨。镖局讲体面，给了十两养伤银便客客气气请他回家歇着。九两银子化作烧刀子下了肚，棉袄也进了当铺，%name%如今拄着枣木拐棍摸进你们营门，拍着胸脯保证只要不叫他长途急奔，眼力和腕劲都还没锈死。" },
	{ ID = "wx_bio_010", Text = "三年前替茶商押货过巴蜀密林，一枚南疆五毒奇门射出的细骨吹箭钻进了%name%左肩窝。幸亏半道遇着杏林济世堂的大夫拿烧红尖刀挖毒肉，命虽保住，可每逢阴雨天半条左臂便僵得像老杉木。即便如此，%name%仍比满营愣头青值钱得多——凡是毒雾藏暗箭、草丛埋竹签的阴损套路，他光闻风味便能喊弟兄们提前卧倒。" },
	{ ID = "wx_bio_011", Text = "『大点声，左边早给砸聋了！』%name%说话总习惯把脑袋斜向右肩，活像只警惕的老乌鸦。早年他在沧州茶棚里替盐商打地下黑擂，连胜四场正得意，第五个对手却在缠手布里偷偷藏了铅砂，一记耳光直接废掉他半边听觉。被轰出茶棚后他倒看得开，战场厮杀本就吵得像雷公打铁，听不见旁人废话反而省心。" },
	{ ID = "wx_bio_012", Text = "黑风血煞宗血洗河口集市那晚，%name%肋下挨了记斜劈腰刀，肠子险些淌出来，全靠滚进屠户案板底下拿半扇死猪盖住身子，才熬到贼骑退散。伤口没钱请名医缝合，歪歪扭扭长成一条蜈蚣似的硬疤，每次猛吸气都扯得生疼。%name%却咧嘴冷笑，既然阎王爷那夜没肯勾他的名册，他便要趁着还能举刀，从恶人身上讨回几倍债。" },
	{ ID = "wx_bio_013", Text = "原本在某家县城武馆外院当护院，那年少东家的骏马被爆竹惊疯，%name%舍身扑上去死拽缰绳，反被马蹄狠狠踹断两根腰椎横突。药钱没见半文，管事反咬一口说他惊伤了名驹蹄铁，连夜将他卷铺盖扫地出门。如今%name%走起路来腰杆微塌，却把那口恶气全攒在指节里，平生最见不得穿绸缎的阔少爷摆架子。" },
	{ ID = "wx_bio_014", Text = "雁门关外那场白毛风冻死七头骡子，%name%为护住商队干粮袋，左手无名指与小指先挨冻伤又遭饿狼啃断。少去两根指头后，硬弓拉不满、细剑握不稳，连驿站掌柜都嫌他刷马慢手慢脚。听说你们不计较残缺只论胆气，%name%用油布把断指缠得严严实实，沉着脸说道，只要还能握紧盾柄或短矛，老骨头照样能替后生挡风。" }
];

// =========================================================================
// 3. background.daytaler (走脚短工) - 8 bios: wx_bio_015..wx_bio_022
// =========================================================================
::Wuxia.Config.BackgroundBios["background.daytaler"] <- [
	{ ID = "wx_bio_015", Text = "钱塘码头湿滑的跳板上，%name%扛了五年百斤粗盐麻包，两肩磨烂结痂又磨烂，如今厚得像腌透的老牛皮。上月钱塘怒潮帮陡然涨了三成码头抽头，工头克扣工钱只发一碗清汤挂面。%name%当场把竹扁担折断扔进江潮里，心里算盘打得明白：同样是拿脊梁骨换铜钱，拎着铁家伙替人搏命，总比活活累死在盐堆旁体面些。" },
	{ ID = "wx_bio_016", Text = "四十文一天，挑二十担井水倒进南岸酒楼后厨，%name%原以为这营生虽苦却安稳。谁料某个五更天摸黑进后巷，他恰好撞见两名黑衣汉子正把县衙书吏往咸菜大缸里塞，水桶当场晃出半圈冷汗。%name%没叫喊也没丢扁担，倒退着退出巷口一口气走了三十里官道，直到看见你们的招兵旗才敢停下来喘口气。" },
	{ ID = "wx_bio_017", Text = "襄阳城外青砖窑的毒烟呛了%name%整整五个伏天，吐出来的痰至今带着煤灰渣，小臂上烫满滚烫砖胚留下的白斑。前阵暴雨压垮晾坯棚，砸死两个小徒弟，窑主赶来却只心疼碎掉的青砖。%name%一口黑痰吐在东家皂靴面上，背起草席扭头就走，宁可去刀尖上讨碗饭吃，也绝不再给这种铁石心肠的财主卖苦力。" },
	{ ID = "wx_bio_018", Text = "每逢威远总镖局的红旗车队驶入集市，%name%总跑在最前头替人家卸铁皮箱笼，图的不光是二十文脚钱和剩包子，更爱偷瞄镖师们收枪换步的架势。歇晌时他拿竹竿照葫芦画瓢，虽常把自己下巴戳青，下盘却练得颇为稳当。如今%name%觉着搬箱子搬不出名堂，厚着脸皮求进队里，盼着哪天也能混身真皮甲穿穿。" },
	{ ID = "wx_bio_019", Text = "替大药行晒了整季发往杏林济世堂的硫磺、雄黄与干蜈蚣，哪怕拿草木灰在溪里搓秃三层皮，%name%袖口领间仍隐隐泛着股苦辛怪味。酒肆跑堂见了他总捂鼻子绕道，乡下媒婆更是懒得登门，倒把%name%气笑了。他自夸这身味儿蚊虫不敢近身、毒蛇见了绕路，雨夜派去荒林里放哨，保准比猎犬还灵醒。" },
	{ ID = "wx_bio_020", Text = "川江险滩的玄武岩锋利如刀，%name%曾在岸边光脚替川江袍哥盐帮的货船拉纤，腰弯得几乎贴地，胸口勒出两条紫黑绳痕。开春发大水时麻缆绷断，三名纤夫当场卷进旋涡连泡都没冒。%name%拿豁口菜刀割断肩套爬上岩缝，从此发誓再不碰江水，烂泥地里挨刀流血好歹能留具全尸，强过喂了江底老鳖。" },
	{ ID = "wx_bio_021", Text = "某位藩镇节度使修葺新辕门，把%name%征去扛了六十天大柏木，从霜降干到腊月，结账时书办却只扔来一串夹铅薄钱。他据理争辩了两句，反遭衙役拿水火棍打得满地打滚。%name%把那串假钱全砸进官马槽里，换双新草鞋便来投军，总算悟透这年头光靠老实出力换不来公道，唯有手里攥着铁才有人听你说话。" },
	{ ID = "wx_bio_022", Text = "布庄东家雇%name%带四个短工拆老宅危墙，一撬棍下去砖缝崩开，夹墙里竟直挺挺立着口朱漆厚棺。棺面贴满褪色的湘西辰州符水门黄符，凑近还能听见里头嗡嗡作响。另外几人吓得屁滚尿流，%name%连当天三十文工钱都顾不上讨，扔掉撬棍一路向东狂奔，觉着跟着一群杀气腾腾的刀客走夜路才压得住邪。" }
];

// =========================================================================
// 4. background.eunuch (净身内侍) - 5 bios: wx_bio_023..wx_bio_027
// =========================================================================
::Wuxia.Config.BackgroundBios["background.eunuch"] <- [
	{ ID = "wx_bio_023", Text = "旧日藩王府的深宅内院里，%name%曾专司剪烛试茶，练就一身踩在吱呀木板上也毫无声息的轻脚功夫。王爷获罪抄家那夜，火光映红半边天，官兵抢着搬库银，他却把两根银簪缝进夹袄钻出浆洗水沟逃命。流落市井才晓得弯腰请安换不来烧饼，%name%低垂着眼帘求个杂役名额，声音虽细，手脚却麻利得吓人。" },
	{ ID = "wx_bio_024", Text = "灾年里爹娘为了两斗糙米，狠心将年少的%name%送去京郊黑刀房净身，指望他进大户当个管事太监光宗耀祖。偏赶上边患四起、内廷裁撤杂役，没混上铜腰牌便被一脚踢回街面。顶着副尖细嗓音沿运河漂泊数年，%name%看惯了世人的窃笑与白眼，他从不当面动怒，只是笑眯眯记在心里，比谁都清楚银子和刀子有多重要。" },
	{ ID = "wx_bio_025", Text = "曾在旧内廷冷僻档房里拂了十二年樟木箱灰，那些抄没自江湖邪派的残缺药方、暗器图样堆得比人高。%name%自知没那根骨去练上乘内功，却偷偷背下不少权贵酒杯里下毒、宽袖里藏匕首的阴私法门。如今主家败落，他揣着半块干姜片投奔你们，慢条斯理说道，行军打仗光凭蛮力不够，提防茶水客栈里的黑手他最拿手。" },
	{ ID = "wx_bio_026", Text = "侍奉的管事公公贪墨军粮折色银，事发前竟想把缺页账册全栽到%name%头上，派两名番子趁三更将他捆去运河沉水。危急关头%name%拿贴身藏了十年的翠玉扳指买通梢公，滚进芦苇滩侥幸捡回性命。自那日起他睡觉总睁着半只眼，深知寻常茶馆藏不住旧主眼线，唯独躲进你们这群铁血汉子中间，才算踏实。" },
	{ ID = "wx_bio_027", Text = "自败落官邸遣散出来后，%name%原想挑担卖些胭脂丝线糊口，谁知刚进乡集便遭几个醋坛子庄稼汉拿扁担轰了出来，硬说这无须白面郎君不怀好意。他受够了走到哪儿都要解裤腰自证清白的憋屈，索性买了顶破铁盔扣在头上。%name%冷哼着告诉你们，戴上兜鍪谁管你长不长胡子，长矛刺人凭的是腕子稳，又不是嗓门粗。" }
];

// =========================================================================
// 5. background.farmhand (庄稼把式) - 8 bios: wx_bio_028..wx_bio_035
// =========================================================================
::Wuxia.Config.BackgroundBios["background.farmhand"] <- [
	{ ID = "wx_bio_028", Text = "连旱三秋，黄土地裂出能吞下草鞋的宽缝，饿极了的山狼趁暮色摸进打谷场叼鸡。屋里没半片铁刃，%name%抄起一把槐木柄粪锹迎头砸下，竟将头狼天灵盖拍得稀烂。全村老小正夸他天生蛮力，东家账房却上门催缴加倍地租，%name%掂了掂沾血的木柄，二话不说扛着铁锹走出村口，去寻个真肯按力气给银子的东家。" },
	{ ID = "wx_bio_029", Text = "春耕前两天，租来的老水牛忽然胀肚暴毙，乡绅管事带人闯进院子，硬把%name%家三亩麦田画押抵了牛价。站在荒芜的田埂边，看着自己一双宽厚得能亲手拉犁的肩膀，%name%忽然觉得可笑透顶。既然横竖都要替旁人流血流汗，倒不如握把真家伙走江湖，至少拼赢了能摸到响当当的碎银，而不是一纸写满黑字的欠条。" },
	{ ID = "wx_bio_030", Text = "江淮水田里踩了十年龙骨水车，%name%一双小腿筋骨结实得像老桑树根。大旱那夜，豪绅家三名打手偷摸来撬他们村的灌溉水闸，被巡夜的%name%当场抓个正着，一扁担劈过去直接敲断领头那厮两根肋骨。明知天亮后县衙拘票准到，他回家揣上六个冷高粱饼子，趁着雾气直奔官道，宁当乱世刀客也不进大牢啃窝头。" },
	{ ID = "wx_bio_031", Text = "冬耕深翻老坟岗边的薄地时，%name%的铁犁头咔嚓一声磕出半截青铜古戈，戈颈缠着的黑帛历经百年竟未腐烂。怪的是当晚茅屋外马蹄声绕了整宿，天亮后霜地上却半个蹄印也无。村里阴阳先生连连摇头让他赶紧远行避煞，%name%干脆拿那柄邪门铜戈换了两双厚麻鞋，跟着你们这群阳气重、煞气更重的汉子讨生活。" },
	{ ID = "wx_bio_032", Text = "柳溪屯人人晓得%name%力大如牛，肩扛两百斤稻谷还能哼着秧歌走独木桥。秋社庙会上他一时手痒，拎起武馆摆出来镇场的百斤石锁耍威风，谁知脚底踩滑半块西瓜皮，石锁飞出去精准砸碎了乡绅养着红鲤鱼的景德镇大缸。赔不起那三十两鱼缸钱，%name%挠着后脑勺逃来投军，嘴里还嘀咕那几条红鱼其实也没多肥。" },
	{ ID = "wx_bio_033", Text = "去岁盛夏，岭南老农皆传西山岭上爬过一头六足肥遗，所过之处溪涧干涸成白盐壳。%name%没亲眼见过妖蛇模样，只眼睁睁瞧着自家半人高的青苗一夜焦枯成脆灰，连蝗虫都懒得落脚。粮囤刮得比脸还干净，与其守着焦土啃观音土等死，他勒紧腰间麻绳一路北上，求着在你们营里挣一口实打实的粟米饭。" },
	{ ID = "wx_bio_034", Text = "弯腰种了七年大麻、挑了七年粪桶，%name%省吃俭用只为凑钱去杏林济世堂抓药，终究没留住老娘那口冬咳。亲手钉好四块薄松板入土，又替药铺还清最后一根欠账筹码后，他把坍了半边墙的泥屋锁死。屋里再无亮灯等他吃晚饭的人，%name%说话不多，眼神沉得像井水，只说排兵布阵若缺个顶在前头的厚身板，算他一个。" },
	{ ID = "wx_bio_035", Text = "接连四年，%name%春播秋收把脊背晒得脱三层皮，可每逢谷子上场，太行十八寨的马贼便准时呼啸下山口，连筛谷的簸箕都要踢碎带走。看着匪首哈哈大笑踩断老爹的打谷连枷，%name%心里那根弦终于崩断了。这世道既是谁攥着刀谁吃白面、谁握着锄谁啃树皮，那他这回说什么也要站到握刀的那一边。" }
];

// =========================================================================
// 6. background.fisherman (江津渔夫) - 8 bios: wx_bio_036..wx_bio_043
// =========================================================================
::Wuxia.Config.BackgroundBios["background.fisherman"] <- [
	{ ID = "wx_bio_036", Text = "在洞庭湖芦苇荡里撒了十二年铅坠丝网，某个大雾清晨，%name%拽起沉甸甸的大网，翻出来的却不是肥鳊鱼。网底裹着具穿洞庭连环水寨黑衫的浮尸，胸口赫然钉着三枚乌黑梅花镖。他连半息都没耽搁，割断价值二两银的好网便撑篙回岸，晌午就把漏水乌篷船贱卖换了干粮——湖水太深，还是陆地上看得清谁要害你。" },
	{ ID = "wx_bio_037", Text = "钱塘江口光脚踩着湿滑舢板长大，哪怕秋分大潮拍岸如攻城槌，%name%照样能在晃荡的船头稳稳拉帆。偏生去年九月一场妖风劈碎了渔船，叔父连喊都没喊出声便沉进浑浪，他抱根断桨漂出六里滩涂才爬上岸。如今%name%踩在结实黄土上仍觉像做梦，发誓往后穿重靴拎长矛，再也不把性命交给喜怒无常的老龙王。" },
	{ ID = "wx_bio_038", Text = "淮水老石桥底下水黑如墨，%name%夜里去收黄鳝笼时，无风无浪的寒渊竟咕嘟嘟翻起白沫，拱洞深处浮出一双惨金兽瞳——老船夫常说那是上古无支祁一脉的水煞。他当场松手丢了竹篓，穿着湿裤衩狂奔三里冲回镇口酒铺压惊。从此%name%宁愿跟陆上悍匪硬拼，晚上扎营却死活要求离深潭大河至少一箭之地。" },
	{ ID = "wx_bio_039", Text = "三更半夜，一艘挂着川江袍哥盐帮风灯的平底私盐船擦着雾气直冲滩头，生生撞烂了%name%花两个月编扎的竹鱼簖。他划着小艇举起挠钩想讨五两修补钱，船头舵手却抓起一把铁钉甩进水里，冷笑着拍拍腰间厚背鬼头刀。吃够了手无寸铁受窝囊气的亏，%name%转头就来投奔你们，盘算着先学会真刀法再论公道。" },
	{ ID = "wx_bio_040", Text = "一伙江面水贼瞧见沙洲边停着条孤零零的渔舟，以为能白抢些熏鱼和米酒，刚搭上跳板便遭%name%一记三股铁鱼叉捅穿了前头喽啰的腮帮子。他趁乱扎猛子从贼船底下游走，连夜弃舟躲进内陆山道。既晓得水帮必会沿着湾口逐村搜人，%name%干脆加入你们这支四处游走的兵马，笑称手里这根叉鱼的家伙扎起人来同样顺手。" },
	{ ID = "wx_bio_041", Text = "涝洼里的枯柏林常年浸在黑水中，%name%那回竟网起条碗口粗的玄鳞水蟒，毒牙滴下的黄涎把橡木船帮蚀出阵阵青烟。联想起乡野传说里南荒巴蛇遗种专在涝洼产卵，他举柴刀砍断网绳弃船跃岸，连回头看一眼的胆量都没有。如今回想那双冰冷竖瞳仍背脊发凉，%name%感慨还是跟活生生的江湖人厮杀痛快，至少人家流的血是热的。" },
	{ ID = "wx_bio_042", Text = "县衙河泊所要收渔课，渡口巡检司要拿孝敬，就连岸边水帮头目也要每月强派『平浪香火钱』。%name%蹲在礁石上拿树枝划拉半晌，算清自己得网足十九条大青鱼，才配留第二十条的鱼尾下自家锅。气极反笑之下，他把湿漉漉的蓑衣挂在税关大门钉子上当告别礼，只揣一盘浸过桐油的上蜡麻绳，扯着酸溜溜的冷笑便投奔了你们。" },
	{ ID = "wx_bio_043", Text = "暴雨倾盆的子夜，%name%曾冒死摇橹送一名肋间渗血的游侠渡过长江，北岸官兵与仇家的火把几乎烧到芦苇边。临别时那游侠扔下块裂纹青玉，顺口夸他撑篙借力的步法极有章法。当掉玉佩在茶楼听完一冬江湖评书，%name%越发觉着窝在小渡口晒鱼干太憋闷，背起破包袱就想来见识见识真刀真枪的大世面。" }
];

// =========================================================================
// 7. background.gravedigger (义庄掘土人) - 8 bios: wx_bio_044..wx_bio_051
// =========================================================================
::Wuxia.Config.BackgroundBios["background.gravedigger"] <- [
	{ ID = "wx_bio_044", Text = "十字坡老义庄守了九年阴冷松木棺，%name%早就悟出一条铁律：半夜二更棺盖咯吱响多半是死人肚胀气，或是野猫钻进供桌底，压根用不着大惊小怪。唯独前年寒露那晚，有具无名尸真顶开盖板伸出青紫长甲，%name%不慌不忙抡起铁锹连拍两下才问它想干啥。事后他嫌义庄阴气太重涨风湿，便扛着锹柄出来找活人搭伙。" },
	{ ID = "wx_bio_045", Text = "每逢冬瘟或匪患过后，南门乱葬岗总少不了%name%挥镐掘坑的身影，官府按尸头给三文钱，顺带默许他收走死人嘴里压舌的旧铜板。街坊邻里见他指甲缝里常年黑泥洗不净，老远便掩鼻绕行，他倒浑不在意。活人满嘴谎话还爱耍老千，死人至少老实安分；何况掘了十年冻土，%name%这对铁臂抡起锄斧来可不含糊。" },
	{ ID = "wx_bio_046", Text = "秋雨绵绵那夜，一名戴斗笠的湘西辰州符水门客商递给%name%三两雪花银，只求借义庄偏棚让四位满脚泥浆的『旅人』站着歇到半夜。次日清晨全村土狗缩在屋檐下不敢吠一声，里正一口咬定%name%引赶尸妖人坏了乡里风水，拿扁担将他逐出地界。如今他背着破行囊投进营门，嘟囔道世道真怪，收银子办事倒成了罪过。" },
	{ ID = "wx_bio_047", Text = "州府秋决太行十八寨悍匪后，满城脚夫都怕沾上冤魂或遭匪伙报复，唯独%name%推着吱呀作响的独轮车替无头尸首收殓撒石灰，嘴里还哼着送葬小调。哪料某位死匪的结义兄弟远远瞧见，硬把这掘土佬误认成执刀刽子手，放话要挑断他手筋。无奈之下，%name%只好钻进你们这帮杀气腾腾的兵痞堆里避祸兼混饭。" },
	{ ID = "wx_bio_048", Text = "替县城盐商在风水坡挖祖坟扩穴时，%name%一镐头刨穿青砖，底下竟露出座幽暗石室，满地生锈铜戈间直挺挺立着几尊枯槁甲士。风水先生当场厥过去，东家骑骡子跑得比兔子还快，唯有%name%慢悠悠爬出坑顺手抓了把陪葬铜钱。连前朝古墓里的干尸都面对面瞧过了，他觉得跟普通山贼拼命实在算不得什么吓人差事。" },
	{ ID = "wx_bio_049", Text = "腰间那只油亮脏布袋里，%name%永远揣着半截风干黑驴蹄、一小包朱砂和一把生糯米。新兵蛋子总笑他大白天迷信鬼神，却不知他早年在江淮湿沼清理淹水荒冢时，亲眼撞见过无月之夜泥坑里爬出浑身白毛的僵物。%name%嘿嘿冷笑着拍拍布袋，讲道咱们干这行的，刀剑留着劈活人，歪门邪道就得靠老祖宗的土方子招呼。" },
	{ ID = "wx_bio_050", Text = "五年前江岸闹大疫，%name%在自家屋后老槐树下亲手挖了三个土坑，先埋了媳妇，又埋了两个不到十岁的娃，手掌磨出的血泡破了又结硬茧。自那以后县里便雇他看守乱葬义冢，因全镇再找不出第二个面对成堆白骨手腕不抖的人。如今他离开空荡荡的破屋加入你们，不为发大财，只盼白天累得够呛，夜里能一觉睡死不做梦。" },
	{ ID = "wx_bio_051", Text = "喝下两口劣质烧酒，%name%倒也不遮掩自己被赶出义庄的腌臜由头：好好的绸面夹袄埋进湿泥烂成灰多可惜，扒下来当两吊钱买羊杂汤暖胃岂不实在？偏偏他手黑，把死去的盐行掌柜那件暗花坎肩卖去了当铺，恰巧被死者的内弟认出来。趁差役锁枷还没套上脖子，%name%连夜翻出城垛，一头扎进你们的招兵摊子里。" }
];

// =========================================================================
// 8. background.historian (访古书生) - 6 bios: wx_bio_052..wx_bio_057
// =========================================================================
::Wuxia.Config.BackgroundBios["background.historian"] <- [
	{ ID = "wx_bio_052", Text = "连考三次乡试皆名落孙山，并非%name%腹中无墨，而是他总把熬夜灯油花在拓印残破唐碑、考订前朝河防旧事上，写八股时动辄扯去古战场阵图。如今砚台崩了角，青布长衫袖口磨出黑棉絮，家底早败得精光。他仍背着半捆宣纸求着随队出行，只盼赶在山贼把荒野古碑砸去做灶石之前，能多抄录几行快要失传的铭文。" },
	{ ID = "wx_bio_053", Text = "油布挎包里塞满炭笔草图与荒祠笔记，%name%走遍半壁山川，专寻深山老猎户打听朱厌、狍鸮以及失落青铜符节的传闻。州学教谕斥他沉迷怪力乱神、有辱斯文，干脆停了他的廪米津贴。既然书院容不下真奇闻，%name%便决定跟着你们这群刀口舔血的游侠儿走天下，毕竟世上再没有谁比提刀卖命的行伍更常撞见山海异兽了。" },
	{ ID = "wx_bio_054", Text = "沙州茶馆里一名自称楼兰摸金商会管事的胡商，曾花十两定银请%name%辨认一块沙漠玉板上的前朝古篆。译到半截瞧见『水银毒机、活殉封门』八字，他猛然瞥见门外几名大汉正往短刀上抹黑油，方知东家根本没打算让识字先生活着离开。%name%趁如厕翻出后窗，踩着破布鞋连逃三驿，唯独在你们的兵器丛里才觉安心。" },
	{ ID = "wx_bio_055", Text = "某家县中大族重金礼聘%name%重修宗谱，谁料这位书呆子偏去府库翻烂了百年旧黄册，白纸黑字查出对方挂在祠堂里的先祖原是边军哗变时偷马的逃卒，竟老实写了进去。五十两润笔银转眼变成一顿鸡毛掸子与家丁拳脚。%name%揉着青肿眼眶走出高门，彻底想通了：跟你们这群坦荡杀人的糙汉打交道，至少没人逼着把贼写圣贤。" },
	{ ID = "wx_bio_056", Text = "原在鼓楼底下摆着半间旧书肆，专收残缺兵书、医方与散落江湖的旧武谱，直到溃散官军进城纵火劫掠，一屋子心血连夜烧成焦炭。%name%冒烟冲进火场，只抢出半卷焦边边防舆图，事后咳了整月黑灰。生计既断，空有一肚子古今掌故却买不来一升米，他整理好仅剩的破儒衫，愿拿认路识字的本事换口行军干粮。" },
	{ ID = "wx_bio_057", Text = "十年来%name%一直执迷于一桩被前朝史官刻意刮去的奇案——当年三千精骑开进太行迷雾峡谷后杳无音信，如今只剩乡农偶尔在废井里捞出锈蚀铜符。他虽拎起长枪便喘得像老风箱，但每逢途经废堡古垒双眼便灼灼发亮。%name%总絮叨着不知前人死法便会踩进同一个泥坑，倒也真靠旧地图替人避过两回伏击。" }
];

// =========================================================================
// 9. background.juggler (天桥卖艺人) - 6 bios: wx_bio_058..wx_bio_063
// =========================================================================
::Wuxia.Config.BackgroundBios["background.juggler"] <- [
	{ ID = "wx_bio_058", Text = "天桥瓦肆里耍了七年柳叶飞刀，堂弟敲破铜锣，%name%蒙着眼甩刀绕松木板画人形，向来博得满堂彩。偏生清明那阵邪风骤起，第三口飞刀飘偏半寸，不偏不倚把路过县丞老爷的乌纱帽钉在了茶棚柱子上。%name%连地上散落的铜板都没敢弯腰捡，拎起衣摆蹿出城门，暗想反正耍刀是本行，不如真来战场上挣银子。" },
	{ ID = "wx_bio_059", Text = "跟着山东老班主学过顶瓷碗与吞火丸，原本在乡间庙会极受欢迎。坏就坏在上回上场前%name%贪杯多灌了半斤烧刀子，一口松香油刚含进嘴便忍不住打了个大喷嚏，烈焰呼啦一下烧光了戏班半片油布棚。被师父拎着扫帚轰出来时他眉毛焦了一半，嘴硬嘀咕着自己这双快手窝在草台班子里早晚埋没，还是刀剑场里痛快。" },
	{ ID = "wx_bio_060", Text = "两根高竹竿间拉紧涂油麻绳，%name%能倒立着走个来回还不掉脚上铃铛，空中接抛铜钱更是百无一失。前阵戏班骡车在山道遇劫，匪徒刚举刀围上来，他借力翻上石壁，拿兜里杂耍用的圆石子连珠砸得贼人抱头鼠窜才脱身。逃命后%name%忽然开了窍：既然扔石头都能砸得悍匪流血，换上铁镖铁蒺藜岂不更赚？" },
	{ ID = "wx_bio_061", Text = "为了在淮阴酒肆多讨些赏钱，%name%胆大包天扯起一块白布幌子，吹嘘自己偷师过蜀中唐家堡的暗器绝技，十文钱看一回蒙眼飞针。这门吹牛生意只红火了四天，第五晚前排坐了个啃瓜子的冷面灰衣客，不言不语抬手三枚细铁钉，将%name%宽袖死死钉在长凳上。当夜他卷起幌子拔腿北逃，发誓再也不乱攀名门亲戚。" },
	{ ID = "wx_bio_062", Text = "一场秋疫扫过南北集镇，庙会冷清得连野狗都懒得来，老班主又咳血死在破砖窑里，艺人们只好各自散伙。%name%当掉画满朱漆的木雕面具换了双结实千层底，只留下一小袋磨得油光的鹅卵石。他嘴上总挂着浑话逗大家发笑，唯独夜深围着篝火盛汤时眼神会暗一瞬——走江湖太久的人，最受不了独自对着冷灶台。" },
	{ ID = "wx_bio_063", Text = "早年在赌坊外头耍转碟混铜钱，后来练出隔着两丈把铁弹丸抛进晃动铜环的巧劲，常有豪商护院赏他碎银。某晚替地下钱庄掌柜寿宴助兴，那醉鬼硬咬定%name%借着翻跟头顺走了桌案上的银锞子——摸着良心讲，其实他也只顺了两回。被十几个打手追得从二楼花窗纵身跃下，%name%拍拍尘土便扎进了你们的队列。" }
];

// =========================================================================
// 10. background.mason (营造石匠) - 6 bios: wx_bio_064..wx_bio_069
// =========================================================================
::Wuxia.Config.BackgroundBios["background.mason"] <- [
	{ ID = "wx_bio_064", Text = "雁门北岭的寒风刮得石头生疼，%name%拎着铁凿钢楔替戍边卫所修了两年烽燧，指节磨得像核桃般粗硬，脊梁敦实如庙门石梁。好不容易垒完最后一段城垛，管事军需官竟卷走工钱银两失踪无影，只扔给匠人们几袋发霉陈米。%name%冷着脸把十二斤八角锤插进腰带，南下投奔你们，盘算着往后谁欠钱便先尝尝铁锤滋味。" },
	{ ID = "wx_bio_065", Text = "盐商豪绅曾蒙住%name%双眼，重金请他在宗祠地底凿出一座带翻板暗锁的藏银石室。最后一块顶石落槽那刻，他隐约听见洞外护院摩挲刀鞘的低笑，登时脊背发寒，暗中拿火石碎屑卡死铜簧机关，趁半夜钻排污暗渠逃出生天。经此一劫，%name%再不肯替阔老修高墙密室，倒觉得露宿荒野、明刀明枪的行伍营盘干净得多。" },
	{ ID = "wx_bio_066", Text = "一块硬青石顺着纹理敲三凿就能利落剖开，%name%雕出的镇门石狮凶神恶煞，连巷口顽童路过都要绕道。坏脾气毁了他的太平日子：某座大庙方丈在石狮完工后竟想借口『眼神太煞』克扣半数工钱，%name%撬棍『不小心』一滑，半成品石座轰然砸扁了知客僧的脚趾。官司还没打完，他便背着铁锤找你们讨一份粗活做了。" },
	{ ID = "wx_bio_067", Text = "巴蜀山麓的石灰采石场里，一炮闷雷炸塌岩壁，露出条阴湿黏腻的石缝，里头蜂拥爬出几十只拳头大的鬼面赤蛛。工友们扔下铁钎哭爹喊娘往坡下滚，%name%却挥舞十二斤重锤连砸烂三只毒蛛，硬把扭伤脚的徒弟背出了采坑。脱险后他盯着沾满紫绿汁液的锤头琢磨半天，觉着自己这副稳胆子埋在石粉里实在屈才。" },
	{ ID = "wx_bio_068", Text = "沿溪造过三座单孔青石拱桥，%name%生平最自豪的便是每逢春汛山洪暴发，别处木桥冲得七零八落，唯独他的石桥纹丝不动。偏生去年盛夏一场罕见蛟水漫过河谷，一夜冲垮他的石场、工具棚与两年积蓄。看着两只曾能轻松震裂硬岩的老茧手掌，%name%叹了口气：既然老天不让安稳砌桥，那便换个行当替人砸城破盾吧。" },
	{ ID = "wx_bio_069", Text = "曾在少室禅院山门外替古塔补砌风化砂岩整整半年，每逢黎明在竹架上拌石灰时，%name%总低头偷看院里武僧光掌劈砖、扎铁桩吐纳。他蠢笨学不会那些玄奥禅理，却把武僧沉肩坠肘、借腰发力的呼吸窍门偷用在抡大锤上，从此敲一整日花岗岩都不带气喘。塔修完拿完工钱，心里反倒烧起团火，想拿这股傻力气闯闯江湖。" }
];

// =========================================================================
// 11. background.messenger (急脚驿使) - 8 bios: wx_bio_070..wx_bio_077
// =========================================================================
::Wuxia.Config.BackgroundBios["background.messenger"] <- [
	{ ID = "wx_bio_070", Text = "披件桐油布雨衣、胸口斜挎漆木羽檄筒，%name%曾在官道驿站间昼夜狂奔。那年腊月大冻雨，借来的官驿瘦马踩上黑冰摔断前腿，他愣是踏着齐膝雪泥徒步狂跑四十里把公文按时送进府衙。谁料驿丞只心疼死马折银，反赏了%name%二十记竹板；伤未痊愈他便一把火烧了腰牌，发誓再不替吃人血肉的官爷卖脚力。" },
	{ ID = "wx_bio_071", Text = "官差闲暇时，%name%常替洛阳长风镖局走偏僻羊肠小道递送密信，抢在车队之前摸清山谷里有无贼影。三州六县哪条野径能绕开关卡、哪家客栈掌柜爱往马料里掺沙子，他脑子里画着张活地图。可惜上回走漏行踪被太行山匪记住长相，独来独往成了活靶子，%name%干脆投奔你们，好歹走夜路时身旁多了十几把硬家伙。" },
	{ ID = "wx_bio_072", Text = "替两镇藩军递送加急军报途中，%name%雨夜滑下泥坡，竹筒磕在乱石上裂开了朱漆封泥。他本只想偷瞧一眼文书有没有被雨水洇花，不料满纸竟全是吃空饷、倒卖军粮的暗账。心知哪边主将发现封泥破损都不会留活口，%name%索性把那份催命鬼文书一把火烧个精光，改头换面钻进你们这支四处流徙的兵马里躲风头。" },
	{ ID = "wx_bio_073", Text = "素来吹嘘中原官道上连野兔都跑不过自己的草鞋，直到某年秋末夜穿荒岭，%name%撞见路旁竟凭空冒出间挂红灯笼的茶棚——明明七天前那儿还只剩几堵焦黑断墙。棚内飘出甜腻异香与娇媚轻笑，他陡然想起老辈人讲过的青丘妖魅，急忙狠咬舌尖借痛醒神。那夜%name%埋头狂奔二十里连喘气都不敢停，从此死活不肯再跑单帮夜路。" },
	{ ID = "wx_bio_074", Text = "朝廷一纸朱批裁撤西北三处偏驿，把干了十来年的老驿卒连同两月欠饷一起扫出了大门。%name%如今仍改不掉五更前惊醒绑紧裹腿的旧习，寻常步兵走半日的山坡，他背着干粮袋一顿饭功夫便能翻过。官家既不稀罕快脚杆子，他索性带着那双磨穿十双麻鞋的铁腿投军，大声笑着说冲锋陷阵或探路报信全听差遣。" },
	{ ID = "wx_bio_075", Text = "私下替镇上富户捎带书信赚外快，%name%平生最得意从不误事，偏偏那个大雾早晨栽了跟头。因信封墨迹遭露水晕开一角，他竟冲进人家搭满白幡的灵堂，高声恭贺大公子高中秀才。被十几个披麻戴孝的亲眷挥着哭丧棒追出三里地，%name%气喘吁吁逃到镇外，彻底想通了：与其替外人跑断腿挨打，不如披件皮甲正经讨生活。" },
	{ ID = "wx_bio_076", Text = "雁门外的砾石驿道冷得能把睫毛冻成白霜，%name%曾在月黑之夜听见山脊传来凄厉如刮铁的群嚎，连久经沙场的边军老斥候都脸色骤变，低声吐出『阴山天狗』四字。那夜他死伏在枯草沟里听着黑影掠过坡顶，天亮才敢爬回驿站交差。如今%name%把驿马缰绳换成兵刃，直白说道：荒郊野岭怪事太多，还是人多胆壮活得长。" },
	{ ID = "wx_bio_077", Text = "一年之内两回在桑树林遭劫道毛贼跳出来喝问买路财，%name%两回都凭一双飞毛腿翻沟越坎，跑出五十步外还回头朝喘成狗的贼人吐舌头。痛快是痛快，可惜光靠甩掉强盗换不来半文酒钱，兜里照样叮当响。%name%挠着下巴找上门来，笑称自己逃命本事早练到了宗师境，如今只差跟诸位好汉学几招回头捅人的真本事。" }
];

// =========================================================================
// 12. background.miller (乡集磨坊主) - 8 bios: wx_bio_078..wx_bio_085
// =========================================================================
::Wuxia.Config.BackgroundBios["background.miller"] <- [
	{ ID = "wx_bio_078", Text = "溪畔那座吱呀转了二十年的水磨坊，十里三村的麦子都靠%name%碾成白面，十斗里只留一斗本分磨费。败退的官军溃兵过境那日，抢光面缸不说，连那头拉磨的瞎眼老驴也被扒皮炖了汤，临走还一把火点着杉木水轮。胡须里尚沾着未洗净的面粉灰，%name%攥紧满是烟灰的拳头投奔你们，胸口那团冷火总得找地方烧出去。" },
	{ ID = "wx_bio_079", Text = "几杯浊酒下肚，%name%倒也不装清白：去冬粮价飞涨，他贪图小利往县衙采买的粗面里掺了点磨细的白石膏粉，本以为神不知鬼不觉。哪晓得县太爷啃馒头咯崩崩断了半颗槽牙，一嚼满嘴石灰墙味儿。差役封坊抄家前，%name%连夜跳进磨渠游出镇子，厚着脸皮求收留，连连保证绝不对自家弟兄的口粮动半点歪心思。" },
	{ ID = "wx_bio_080", Text = "一年两回亲手抬起数百斤青石磨盘重新凿纹，练得%name%胸膛宽如粮囤，双臂能把扫帚杆当干柴折断。有回两名惯偷半夜摸进麦仓翻找碎银，撞见这敦实汉子站在梁架上，还没来得及亮匕首，便被%name%抱起块备用手推小磨石凌空砸断领头贼的锁骨。怕同伙秋后算账，他锁上坊门带上铁撬棍，索性跟着你们换个活法。" },
	{ ID = "wx_bio_081", Text = "祖传的中原官道驴拉磨坊原是个稳妥饭碗，%name%做梦都想着攒够彩礼娶铁匠家寡居的妹子过安生日子。偏赶上一秋之内两路藩镇强派军粮，逼他白白碾磨发霉官麦，只给一摞擦屁股都嫌硬的空头印票。债主拿铁链锁死磨盘那天，%name%扯下沾满麸皮的围裙扔在地上，抄根炉钩投军去也，非要挣回真金白银不可。" },
	{ ID = "wx_bio_082", Text = "乡集里数%name%的麸皮仓最干净，直到一场秋涝把成群肥鼠赶进地窖，紧跟着钻进来一条饭碗粗的铜头沼蛇，张口朝麻袋喷出乌黑毒液。小伙计吓得翻墙狂逃，%name%却抓起沉甸甸的硬木捣杵，硬生生把毒蛇砸成了肉泥。那晚过后他守着吱呀转动的磨盘反倒觉出无趣，浑身筋骨莫名发痒，干脆把坊契盘给表弟出来闯荡。" },
	{ ID = "wx_bio_083", Text = "春秋两季，%name%的石磨总替路过渡口的威远总镖局碾炒面与小米干粮。每回端着热腾腾的面片汤，听那些浑身刀疤的老镖师吹嘘深山伏击、前朝古冢和塞外风沙，他心里那点安稳念想便渐渐发了霉。熬到侄儿长大能独当一面，%name%拍净肩头白灰，把磨坊钥匙往柜台上一放，迈开大步追着镖车尘土踏入了江湖。" },
	{ ID = "wx_bio_084", Text = "整整十四年，%name%日复一日盯着那头蒙眼老灰驴围着砂岩磨盘打转，把乡亲们的汗水碾成精细白面送进豪绅粮仓。直到老驴某天清晨倒在谷糠堆里再没站起来，他低头看着地上被驴蹄踩出半尺深的圆沟，猛地打了个寒颤——自己这半辈子何尝不是头蒙眼拉磨的牲口？卖掉石磨换得二十两碎银，%name%买了件厚棉袍便来投奔你们。" },
	{ ID = "wx_bio_085", Text = "孤零零建在山坡上的磨坊常遭附近黑风血煞宗巡山喽啰盘剥，每逢月圆便提刀上门强索十袋细面，美其名曰『孝敬山寨弟兄』。第四回上门时，%name%把从老兽医那儿讨来的巴豆粉细细研碎拌进了粗面里。远远瞧着半数贼人捂着肚子在溪边滚成一团，他趁着暮色一把拉栓关门，撒腿向南狂奔三天三夜投进了你们营盘。" }
];
