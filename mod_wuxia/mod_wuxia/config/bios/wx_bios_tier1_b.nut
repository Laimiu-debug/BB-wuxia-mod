// 500 Independent Dark-Wuxia Character Biographies - Part 4/5 (Tier 1B: 110 bios, wx_bio_263..wx_bio_372)

if (!("BackgroundBios" in ::Wuxia.Config))
	::Wuxia.Config.BackgroundBios <- {};

::Wuxia.Config.BackgroundBios["background.graverobber"] <- [
	{ ID = "wx_bio_263", Text = "腰带上总拴着半截臭烘烘的风干黑驴蹄子，旁人嫌晦气，%name%却当成救命祖宗供着。前年他跟把头钻进河南一座前朝王侯冢，棺里老主子竟直挺挺坐起来咬断把头半条胳膊，亏他手快将驴蹄塞进尸口，顺势抠走压舌玉蝉溜之大吉。如今楼兰摸金商会悬红追讨那枚玉蝉，他干脆拎刀钻进大伙营里避风头。" },
	{ ID = "wx_bio_264", Text = "旁人下墓带罗盘朱砂，%name%只带一把撬碎过三面青铜古盾的分水刺。大漠流沙下掘开前朝兵马陵那夜，三尊镇陵金甲卫顶着满身铜绿挥戈砍来，同伙七个死了五个，他靠装死滚进陪葬马骨堆里才熬到天亮。自打爬出那条阴风阵阵的墓道，他发誓往后只在大太阳底下跟活人拼刀，再不钻黑窟窿。" },
	{ ID = "wx_bio_265", Text = "『鸡鸣灯灭不摸金，可灯灭了账本还在啊。』蜡烛在东南角噗地变绿那会儿，掌眼老九喊着撤，%name%偏舍不得供案上那半册残缺拳谱。他伸手一拽扯动翻板，铁蒺藜瞬间将老九扎成刺猬，自己只蹭破半边屁股侥幸脱身。商会骂他坏了行规断了香火，连鬼市都不敢收他手里的冥器，只好背着洛阳铲来寻活路。" },
	{ ID = "wx_bio_266", Text = "隔着三步就能闻见%name%衣领里洗不掉的陈年尸蜡与冷檀味，一看便是常年掏死人兜的老手。去年在关中荒岭盗掘古穴，他撞见醒转的血影剑魔，那枯瘦邪物一剑削飞他半片左耳垂，却没追出石门外的日头。捡回残命后他将摸金符典给当铺换了坛烈酒，冷笑道与其替死鬼翻身，不如跟活人明刀明枪挣银子。" },
	{ ID = "wx_bio_267", Text = "早年混在楼兰摸金商会时，%name%原是个油滑透顶的造假掌铲，专挑新烧陶罐埋进粪坑沤三天充汉瓦骗冤大头。偏偏有回贪心真刨穿了一座前朝守陵祭司的石室，满地白骨咔哒咔哒自己站起来追杀，吓得他把半生攒下的碎银全撒了买路。死里逃生后他算彻底服了软，乖乖收起盗锄来你帐下混口阳间饭。" },
	{ ID = "wx_bio_268", Text = "抓一把封土搓碎放舌尖抿两下，%name%便能断出底下是渗水烂棺还是连环翻板弩。他在洛阳北邙荒坡倒腾了八年土货，挣来的黑钱全赔进了地下骰坊和替惨死师弟收尸的棺材账上。眼下州府严查掘冢案，巡检司的画影图形贴满城门，他把探阴爪卷进破毡毯，乐呵呵拍着胸脯说替你探路查埋伏绝不走眼。" }
];

::Wuxia.Config.BackgroundBios["background.houndmaster"] <- [
	{ ID = "wx_bio_269", Text = "旁人逛暗门子钻赌坊欠一屁股印子钱，%name%欠下的却是六条关外猛獒大半年啃生牛骨的肉账。先前供奉他的姑苏豪庄遭绿林血洗，庄主连夜卷细软逃命，独留满院饿红眼的恶犬无人过问。他咬牙赊账养活犬群，最后被债主带打手堵门逼得走投无路，只好攥着旧牛骨哨来你队里挣工钱填窟窿。" },
	{ ID = "wx_bio_270", Text = "右手小指缺了一截，那是%name%早年替一头刚下崽的母狼狗挡毒蛇留下的记号。他在淮阳某处盐商别院驯了九年护院猎犬，手下犬群隔着高墙都能闻出黑衣夜行客的汗腥味。偏偏东家小舅子醉酒拿烧红铁钎烫狗寻乐，被护崽头犬一口咬穿裤裆，%name%没被乱棍打死已算走运，连夜卷铺盖投了江湖。" },
	{ ID = "wx_bio_271", Text = "塞外马贼最忌惮的并非官军强弩，而是月黑风高时顺着马粪味悄无声息摸进营的猎犬。%name%曾从关外雪窝掏过一窝带阴山天狗血统的野崽，费尽心血喂养三年，结果月圆之夜那孽畜发了疯性，将同窝三条细犬全咬死在木桩上。打那以后他悟出个道理：畜生终究信不过血统，唯独长枪和袍泽靠得住。" },
	{ ID = "wx_bio_272", Text = "城西狗市贩子最怕%name%蹲在竹笼前扒拉犬牙，哪条狗咽喉藏暗喘、哪条脊骨挨过闷棍，他摸两把肋骨便心知肚明。从前在河北崔家外院管狗房，他替商队挑过三十余条追匪猛犬，后来新管家嫌他死脑筋不肯吃肉钱回扣，寻个丢了银锁的由头将他逐出庄门。如今他腰挂骨哨，嘴里总嘀咕活人不如狗讲信用。" },
	{ ID = "wx_bio_273", Text = "城南地下斗犬窟的沙坑早被狗血浸成了暗褐色，%name%在那儿干了五年缝皮肉、熬止痛汤的差事。有回坐庄恶霸为翻本，逼他给一条断了两根肋骨的老黑獒强灌虎狼催命散，他当场一铁叉扎穿恶霸脚背，扛着老狗杀出巷口。老狗熬过寒冬终究埋在荒坡，%name%抹了把眼角，决意换个不必瞧牲口互咬的活法。" },
	{ ID = "wx_bio_274", Text = "走巴蜀密林的商队常吃五毒山狼轻骑的暗亏，唯独%name%能凭一把干狼粪灰与尖厉骨笛惊散狼群。他在南岭大户人家掌管过八年猎苑，最熟驱犬兜抄包夹、专咬匪徒脚踝不松口的合围战术。可惜东家今年迷上了炼丹长生，裁撤猎苑改建丹炉，他便拎起护身短矛来你麾下卖这一身驯兽识踪的本事。" }
];

::Wuxia.Config.BackgroundBios["background.hunter"] <- [
	{ ID = "wx_bio_275", Text = "瞧一眼%name%右肩那道翻卷如蜈蚣的陈年爪疤，便知他为何总爱把弓弦绞得比常人紧三分。腊月里他在长白林海追杀一头偷吃屯粮的老黑瞎子，雪坑崩塌差点被拍碎天灵盖，全靠临死前反手一箭捅穿熊眼。那张油亮熊皮事后被里正白白孝敬了知县，气得他一把火烧掉茅棚，背上牛角弓闯了江湖。" },
	{ ID = "wx_bio_276", Text = "每猎杀一头吃过人肉的孽畜，%name%就在桦木箭杆尾端刻一道深杠，如今壶里三支旧箭早已刻满。去年深秋他在荒坳撞见一头白首赤足的凶猿啃食死牛，隔着六十步一箭正中眉心却只擦出一溜火星。晓得深山起了邪瘴、单凭猎弓再镇不住林子，他干脆下山寻帮硬手抱团讨生活。" },
	{ ID = "wx_bio_277", Text = "进林子前先往烂木山神像脚下泼半口冷烧酒，这是%name%跟老爹学了二十年的老规矩。他最擅趴在雪窝里憋气半个时辰一动不动，专等风向转北、鹿群低头舔盐渍时连放双箭。前年税吏进村逼收「山泽皮毛捐」，连他亡妻陪嫁的银镯都搜了去，他一箭射飞税吏乌纱帽，自此有家难回。" },
	{ ID = "wx_bio_278", Text = "大字不识半个，可%name%只要蹲身拨弄两下草丛里的兽粪，便能算出阴山苍狼几时过境、头狼是不是瘸了后腿。他在秦岭北麓靠卖貂皮鹿茸养活过一家五口，直到一场过境兵灾将整条山沟烧成白地。将亲人骨灰罐埋在老松树根下后，他背起七斗硬弓走出山口，冷冷道如今猎人头比猎兽价钱公道。" },
	{ ID = "wx_bio_279", Text = "深山夜半忽闻婴儿凄厉啼哭，蠢货提灯去救，老猎户立刻搭箭上弦。%name%曾在西山荒涧亲眼见一只攒角蛊雕叼着牧童往绝壁飞，他连发三支雁翎箭逼那妖禽松口，虽未救下娃娃，却拣回半根斑纹怪羽。打那夜起他睡觉从不解牛皮护臂，耳根微微一动便能听出三百步外枯枝折断的脆响。" },
	{ ID = "wx_bio_280", Text = "箭镞上该不该抹草乌毒膏，猎户圈里素来争执不休，%name%却连弓弦都敢拿桐油浸过防潮。他在巴蜀老林剥过吞鹿巴蛇的青鳞，也从五毒探子的吹箭底下滚崖捡过命。乡邻嫌他浑身草药腥臭与血煞气太重，连媒婆都绕着他茅屋走，他倒乐得清净，挎着剥皮猎刀随你四海奔波。" },
	{ ID = "wx_bio_281", Text = "大雪封山那年，%name%凭一张旧竹弓养活了村尾五户孤儿寡母，乡民见了他都喊一声「活灶王」。谁料开春刚化雪，财主家管事就带打手上门，咬定那头梅花鹿是老爷山场跑丢的牲口，非逼他赔银三十两。他没费口舌，抡起剥剩的鹿骨头砸裂管事脑门，连夜翻过山梁投进了你的营寨。" },
	{ ID = "wx_bio_282", Text = "别看%name%左眼蒙着一层灰白翳膜，闭上那只眼反倒省了瞄准工夫，百步外照样射得穿挂树铜钱。那是早年给商队当向导时替东家挡绿林流箭落下的残损，东家却只扔下二两碎银便打发他滚蛋。自此他再不信半句江湖义气，只认两桩实事：入夜前擦干弓胎露水，开战前数清兜里工钱。" }
];

::Wuxia.Config.BackgroundBios["background.killer_on_the_run"] <- [
	{ ID = "wx_bio_283", Text = "州府城门洞里贴着三张海捕文书，把%name%画成个歪嘴吊睛的恶鬼，他自己路过茶摊端详半晌，竟还跟着捕快骂了句『真他娘欠剐』。三年前他讨薪时失手拿杀猪刀捅穿了粮行东家的肺管子，自此亡命天涯。如今混进你麾下卖命，他图的不仅是赏银，更是借大伙的刀光枪影遮住自己的脚印。" },
	{ ID = "wx_bio_284", Text = "『说老子宰了县丞家三口？头两个确实不是我动的刀，第三个倒是我嫌他嚎得太吵顺手抹的。』%name%说起旧案时神色平静得像在谈论切腊肉。他从前替盐枭看护暗仓，东家东窗事发便推他顶罪，逼得他杀出重围一路北逃。只要你不深究他早年姓甚名谁，这人临阵下刀绝不留半分余地。" },
	{ ID = "wx_bio_285", Text = "逢年过节见着大红灯笼，%name%手心便止不住冒冷汗，生平最忌讳喝人喜酒。五年前他在外乡挣足彩礼赶回老家，正撞见放印子钱的乡绅将他未过门的媳妇绑上花轿。那夜喜堂没吹唢呐，只剩一柄滴血腰刀和满院惨嚎。背着四条人命逃亡至今，他只求痛快战死沙场，绝不落进衙门受凌迟。" },
	{ ID = "wx_bio_286", Text = "每次乘渡船过河，%name%都死死盯着浑浊江面出神，仿佛怕当年绑了磨盘沉底的那位账房先生浮上来索命。他早年替江南某家黑当铺干过灭口脏活，专治不肯画押的硬骨头，直到东家想连他也一并沉江。他反杀两名盯梢打手逃出生天，眼下黑白两道都在悬赏他这颗脑袋，只好找支硬队伍托身。" },
	{ ID = "wx_bio_287", Text = "瞧%name%平时闷头补草鞋、说话轻声细气，任谁也猜不到他背着沧州府一桩官命大案。那日酒肆里两个醉醺醺的押粮官强夺他亡兄留下的破铁剑，还往他汤碗里吐浓痰，老实人血气冲顶，砸碎酒坛割断了二人喉咙。逃亡两载他早已看透生死，既然脑袋别在裤腰带上，不如跟你搏场富贵。" },
	{ ID = "wx_bio_288", Text = "为躲开捉刀捕快鼻子底下的追缉，%name%咬牙拿烧红铁筷烫毁了右颊那颗显眼黑痣，连乡音都硬生生憋成了关中腔。昔日在太行山下劫过知府小妾软轿，不料落网同伙经不住夹棍将他全咬了出来。如今他夜宿总把短刀横压枕下，风吹草动便暴起瞪眼，活脱脱一头刚挣脱铁夹的孤狼。" }
];

::Wuxia.Config.BackgroundBios["background.lumberjack"] <- [
	{ ID = "wx_bio_289", Text = "在荒林里抡了十几年柴斧，%name%撞见过最邪门的事并非黑熊拍门，而是一棵三人合抱的枯柏被劈开时汩汩冒血浆。那树精夜里竟拔起盘根追出二里地，将同帮樵夫全抽死在山涧，唯有他仗着宽背重斧剁断毒藤逃出生天。自打见识过都广建木树精的凶威，他发誓往后只砍会喘气的活物。" },
	{ ID = "wx_bio_290", Text = "十二斤重的豁口开山斧在%name%手里轻若柴刀，一口气能放倒半亩红松。早年在辽东木场拉大锯时，他跟着劈山盟的醉汉偷学过两手旋风抡斧的腰马劲道，结果试招一斧劈散了管事的算盘桌。工头扣光半年工钱还放恶犬咬人，他怒劈门栓扬长而去，听说你这儿急缺碎盾重手便径直找上了门。" },
	{ ID = "wx_bio_291", Text = "替藩镇官窑烧了七年硬木炭，%name%两只铁掌茧皮厚得能徒手抓起红炭颠两下。寒冬监工逼樵夫冒暴雪钻绝谷砍青冈木，雪崩活埋了三个乡亲，监工却只顾着盘算少交了多少车炭。%name%闷声将一担湿柴倒进监工暖盆熏了他满脸黑灰，随后提斧走人，说这身蛮力拿去劈贼寇才不算糟蹋。" },
	{ ID = "wx_bio_292", Text = "斧柄缠满七层磨得油亮的麻绳，尾端还系着半截褪色红布条，%name%说进了阴山深林能挡山魈迷魂。他在太行绝谷卖柴糊口，练就一双扛三百斤湿木爬陡坡不喘气的铁腿与宽厚肩背。今年绿林匪徒封路抽买路钱，连背柴进城的穷汉都要扒层皮，他干脆丢掉扁担，提着重斧来跟你换顿热饭。" },
	{ ID = "wx_bio_293", Text = "巴蜀峡江放木排本是拿命博饭的绝活，滚木稍一错位便能将人挤成肉泥，%name%却在急流里硬熬了八年。去年上游暴发山洪，他为抢救卡死在礁石缝里的皇木楠料，抱斧跃入旋涡砍断绞索，上来时左腿被磕掉一块肉，东家反怪他刮花了木皮。心彻底凉透后，他觉着沙场上的刀斧反倒更讲规矩。" },
	{ ID = "wx_bio_294", Text = "流寇夜袭山村那晚，全村青壮躲进菜窖发抖，唯独%name%红着眼拎起劈柴大斧死堵自家院门。头两个扑上来的劫客当他是个笨拙泥腿子，谁料他把贼人木盾当成老榆树节疤，两斧下去连盾带小臂全剁成两截。乡邻怕惹山寨报复，凑了五两碎银求他远走高飞，他只好背斧踏入江湖。" },
	{ ID = "wx_bio_295", Text = "嗓子早年救山火时被浓烟呛哑了，%name%说话总像拉扯破风箱，可干起搏命活计比三头壮骡还顶用。他在深林听风声便能辨出头顶枯枝几时砸落，这份机警带进战阵，闪躲冷箭飞石竟也出奇灵光。家中老母去年腊月病故后，荒沟里再无牵挂，他磨亮大斧下山，想趁筋骨尚硬闯出一份身家。" },
	{ ID = "wx_bio_296", Text = "县里乡绅将后山千亩好松划作自家祖坟禁林，穷人拾两根干枝都要挨二十板子。%name%偏不信这个邪，除夕雪夜摸进禁林伐了棵碗口粗的油松给病危老爹打薄棺，偏巧撞上提灯巡山的恶奴。混战中他挥长柄砍树斧放倒三名家丁，连木料都顾不上扛便逃离故乡，如今只能跟着大伙四海为家。" }
];

::Wuxia.Config.BackgroundBios["background.manhunter"] <- [
	{ ID = "wx_bio_297", Text = "公门当差讲究「见花红不见交情」，%name%干了九年外班捉刀捕快，腰间熟铁链锁过江洋大盗，也铐过哭天抢地的逃税佃户。上月他千里追凶擒回一名杀官悍匪，知府收了匪首亲家的厚贿，转天竟判作误伤轻发落。他当堂把木腰牌砸碎在签押房门槛上，宁肯跟着草莽挣干净银子，不再替贪官擦屁股。" },
	{ ID = "wx_bio_298", Text = "『死尸只换半份花红，捆成粽子拎进大堂才够喝花酒。』这是%name%挂在嘴边的老生意经。他专擅使带钩长朴刀挑断逃犯脚筋，再抖手甩出套索锁死咽喉，九载公差从未空手而归。可惜前阵子在洛阳西市错拿了藩镇监军的远房侄子，害自己反倒上了协查海捕，只得改名换姓混进你营里避难。" },
	{ ID = "wx_bio_299", Text = "太行十八寨聚义厅曾立过黑赏，谁砍下%name%这颗项上人头，赏银三百两外加两坛陈年烧春。只因前年他乔装走街货郎摸上分寨，一宿割下七名喽啰的左耳拎回县衙请赏。后来衙门换了怕事的新县令，生怕招来山寨血洗先革了他的外班差籍，没了官面护身符，他必须寻座硬靠山才能熬过今冬。" },
	{ ID = "wx_bio_300", Text = "破庙灰堆里半截烟锅灰、官道泥泞中偏外八字的草鞋印，落进%name%眼里全是明晃晃的指路牌。他曾随老捕头苦练十年追踪锁拿，连梁上飞贼踩瓦蹭掉的半粒霜尘都能掂出轻重。老捕头去年在荒庙遭黑风血煞宗暗算分尸，%name%辞去差事背刀独行，边替你拿赏银边暗访仇家行踪。" },
	{ ID = "wx_bio_301", Text = "别家捕快靠敲诈窑子商铺肥得流油，%name%偏是一根筋，抓人只领衙门明贴的赏银，结果十年下来倒欠药铺一屁股刀伤债。知县嫌他蠢笨不懂孝敬，专把最要命的剿匪苦差往他头上派，上回竟令他单枪匹马去拿五名马贼。他割回两颗匪首人头后彻底寒心，转头便投奔了你这支按命付饷的队伍。" },
	{ ID = "wx_bio_302", Text = "进客栈先瞄前后退路，再盯生客虎口有没有刀茧，这是%name%改不掉的老毛病。昔年在江淮水泽追捕水寇，他曾潜伏芦苇荡挨了三天毒蚊叮咬，硬生生生擒一名洞庭小头目。如今当地官军自己跟水寨暗通分赃，容不下他这根芒刺，他冷笑两声卷刃走人，说这乱世是非全凭手中刀硬不硬。" },
	{ ID = "wx_bio_303", Text = "双手虎口结着铁青色厚茧，那是%name%常年死拽套索、勒铁链磨出来的印记。早年在关中当捉刀人时，他专替威远总镖局与州府追逃犯，最爱瞧亡命恶徒被铁钩锁住手脚时那副色厉内荏的熊样。大旱过后州府库银告罄，连欠三月赏钱，他连夜把锁链往肩上一甩，决定换个管饱饭的新东家。" },
	{ ID = "wx_bio_304", Text = "两年前奉命围捕一伙抢劫官粮的饥民，%name%带人踹开破砖窑，却见领头那个饿得脱相的汉子竟是昔年救过他命的同乡老哥。他假装踩滑扭断脚踝，硬生生放跑了一窑乡亲，回衙后挨了四十记杀威棒并革去公籍。养好棒疮后他再无官身，只余一身缉凶拿贼的真功夫，静候你发落差遣。" }
];

::Wuxia.Config.BackgroundBios["background.militia"] <- [
	{ ID = "wx_bio_305", Text = "在宗族祠堂外练了三年刺杀长矛，%name%原以为团练不过是农闲混两顿白面馒头的闲差。直到去年霜降，三十余名绿林劫客夜袭寨墙，他硬是挺着烤硬的白蜡杆死守豁口，接连戳翻三个翻墙贼。天亮后乡绅却把首功全记在自家傻儿子名下，只赏他一斗发霉陈米，气得他扛矛头也不回出了村。" },
	{ ID = "wx_bio_306", Text = "『前排举盾莫退，后排长枪戳眼』，老团总拿湿藤条抽出来的口诀，%name%至今烂熟于心。早年随本县乡勇去解邻镇匪围，正规官军躲在三里外擂鼓观战，拿乡勇当肉盾填壕沟。同村十二个壮丁只活着爬回四个，他摩挲着满是血泥的破棉甲想通了：既然一样要拼命，何不跟真懂用兵的头领挣真钱？" },
	{ ID = "wx_bio_307", Text = "岭南水田争抢水渠，宗族团练动起家伙比官匪厮杀还要狠毒。%name%生来嗓门洪亮、下盘如桩，年年替本族扛着大藤牌冲在头阵，脑门挨过五六回铁锹扁担愣是没趴下过。去年族长巴结新任知县，竟把他在械斗中伤人的旧案抛出来顶罪，他连夜翻出祠堂，发誓往后再不为哪个大姓白流一滴血。" },
	{ ID = "wx_bio_308", Text = "别瞧不起%name%颈间挂着那只豁口旧铜哨，前年雪夜正是靠它吹响三短一长，全寨老少才赶在邪派药人破栅前退进石碉。他在垛口弯弓射干了三壶猎箭，虎口崩裂得三天端不起饭碗。可灾年过后庄子终究散了伙，老弱各奔西东，他拎着补过三回鞘的腰刀四处寻路，只求再守一回不垮的阵线。" },
	{ ID = "wx_bio_309", Text = "藩镇抓壮丁的差役刚进村口，富户忙着塞银子买替身，穷小子只能钻进山洞躲灾。%name%原是村里团练枪法最稳的帮教，偏不肯替地主家纨绔去边关填命，趁黑撬开祠堂兵库拿走一杆铁头枪和半袋干粮。他懂得听鼓列阵，也吃得下急行军的苦，只求你莫像官老爷那般把弟兄当草芥。" },
	{ ID = "wx_bio_310", Text = "胸口绑着一块拿破铁锅底敲扁打圆的护心镜，虽丑得让人发笑，前年却真替%name%弹飞过绿林暗箭手的一记冷箭。村里凑钱办团练时连把好钢刀都买不起，全靠铁匠拿废犁头改铸枪尖。跟着乡亲打退过两拨流寇后，他渐渐觉出自己生来就是吃这碗刀枪饭的胚子，干脆拜别父母出门闯江湖。" },
	{ ID = "wx_bio_311", Text = "石桥阻击马贼那晚暴雪没膝，团练里半数人偷偷扯了号衣溜走，唯有%name%抱紧长矛死蹲在鹿角拒马后头。天亮援兵赶到时，他眉毛结满冰棱，脚下横着两具马贼尸首，手中枪杆早崩裂了一截。县丞口头夸他是忠义良民，连半两药钱都没报销，他这才彻底断了替衙门卖苦力的念头。" },
	{ ID = "wx_bio_312", Text = "在山寨烽火台上值了四年夜哨，%name%最擅借狼烟浓淡与远处尘柱辨别贼兵多寡。绿林摸哨探子曾被他抡着硬木棍放倒过两个，寨里大娘见了他总爱塞两个热烤红薯。可惜一场蝗灾啃光了庄稼，团练连稀粥锅都揭不开，他把红薯塞回老娘手里，背着旧腰刀走出山坳，来你帐下挣份嚼谷寄回家。" }
];

::Wuxia.Config.BackgroundBios["background.monk"] <- [
	{ ID = "wx_bio_313", Text = "问起为何被逐出少室禅院，%name%摸着油亮光头嘿嘿直乐：『洒家不过在灶膛底下偷烤了半只野鸡，又顺手把来告密的知客僧倒栽进了泔水缸。』在寺院挑了七年井水、抡了七年烧火棍，他虽没资格进藏经阁，却隔着武僧院矮墙偷练出一身铜筋铁骨与罗汉散手。如今破僧袍洗得发白，化缘全靠铁拳讲理。" },
	{ ID = "wx_bio_314", Text = "『佛祖管心里那盏长明灯，不管洒家肚里这坛烧酒。』%name%左肩扛铁禅杖，右腰拴着个油漆斑驳的大酒葫芦，走起路来叮当乱响。他早年原是沙场杀才，血债缠身夜夜噩梦才剃度躲进古庵，谁知路见山匪强抢民女实在压不住无名火，一杖砸烂了匪首脑瓜。既然守不住清规，便干脆以金刚怒目重入红尘。" },
	{ ID = "wx_bio_315", Text = "每逢血战收尾，旁人急着扒尸甲摸铜钱，%name%总要盘膝坐在焦土上低声诵完半卷往生咒才肯动筷。早年行脚湘西荒村，他亲眼见赶尸妖道驱使铁尸傀屠戮整座古刹，老方丈为护残经被撕碎在佛龛前。从此他把黑铁念珠缠紧双拳，立誓逢一具邪祟便超度一具，哪怕为此双手再沾无边杀孽。" },
	{ ID = "wx_bio_316", Text = "曾在峨眉金顶庵山下的挂单寮寄宿三冬，替老禅师补过漏雨瓦顶，也换来几句吐纳澄心的真传点拨。%name%性子沉静得像口千年古井，纵使利刃架颈心跳也不曾乱过半分。故乡小寺毁于藩镇战火后，他背着一只缺口木鱼云游四海，说众生皆苦，能护着一队活人少死几个，也算积下实在功德。" },
	{ ID = "wx_bio_317", Text = "说穿了不怕大伙笑话，%name%当初剃光头纯粹是为逃避官府丁税与债主上门，连《金刚经》开篇都是胡乱诌的。偏偏躲在荒山废庙啃了三年树皮野菜，听惯了夜半狼嚎鬼哭，反倒莫名修出一副泰山压顶不改色的死猪不怕开水烫定力。如今废庙塌了半边墙，他抄起齐眉棒下山，自称酒肉穿肠过，银钱留心中。" },
	{ ID = "wx_bio_318", Text = "在名刹戒律院扫了六年青石阶，%name%看透了高僧对达官贵人低眉谄笑、对饿殍香客紧闭山门的丑态。大饥荒那年寺仓堆满陈谷却不肯施半勺米汤，他半夜砸开粮锁放流民扛走三十袋，挨完八十戒棍后被削去度牒轰下山来。他仍留着晨起蹲桩吐纳的旧习，只是不再拜泥塑金身，只信自己这双硬掌。" },
	{ ID = "wx_bio_319", Text = "随身灰布搭裢里塞满干艾绒、金疮草与卷边佛经，%name%走到哪儿都飘着一股苦涩药香。早年淮水闹瘟疫时，他孤身替无数无主浮尸敛骨焚化，自己却百邪不侵，乡民传他得了罗汉护体真诀。其实哪有什么神通，不过是多年禅宗调息底子扎实罢了；如今世道妖风四起，他愿随你行脚，一手渡死人，一手救活人。" },
	{ ID = "wx_bio_320", Text = "临阵交手前不喊杀也不念经，%name%独爱轻敲腰间木鱼，嘴里慢悠悠念叨『施主莫慌，挨完这掌便不疼了』。昔日在洛阳破坊帮人做法事度日，一伙地痞收例钱砸了佛案，被他三两下卸掉四个人的下巴。衙门怕惹黑道报复反倒将他驱逐出城，他合十叹声阿弥陀佛，转身便来投奔你的大旗。" }
];

::Wuxia.Config.BackgroundBios["background.poacher"] <- [
	{ ID = "wx_bio_321", Text = "哪家藩王围场的铁蒺藜最矮、哪处巡山骑兵换班有半刻钟空当，%name%闭上眼都能画得一清二楚。他在官山禁苑偷猎了七年白鹿紫貂，全凭一身钻荆棘无声、踩霜叶不响的贼本事。上个月残雪露了踪迹，被二十名巡林卫和恶犬撵了四十里山梁，割断弓弦钻狗洞才捡回条命，急需找处营寨避祸。" },
	{ ID = "wx_bio_322", Text = "皮货铺收紫貂最忌讳箭窟窿戳烂背毛，因此%name%硬生生逼出一手专挑眼眶和咽喉下手的阴损箭法。他在长白官林外围干了多年无本买卖，专拣守山兵喝闷酒打盹的雪夜开张。后来林子里闯入一伙关外战帮猎手，把他辛苦埋下的三十副铁夹洗劫一空，他咽不下这口恶气，来你这儿挣钱换张好硬弓。" },
	{ ID = "wx_bio_323", Text = "天生一副瘦猴身板，%name%爬上三丈高的老松树杈一趴就是大半日，巡山衙役在树底撒尿都没发觉头顶有人。他从不跟虎豹正面硬拼，专擅在兽径挖陷坑插竹签，等猎物瘸了腿再补一记冷箭。旁人骂他手段卑劣不像豪杰，他咬着草根冷笑：『能把肉平安背回家，管他什么君子小人？』" },
	{ ID = "wx_bio_324", Text = "摸摸光秃秃的左耳廓，%name%对公门官军的怨毒比陈年老醋还酸。五年前荒灾，他不过偷潜进知府后山射了两只灰兔给病妻炖汤，就被护林卫抓去割下左耳钉在村口树干上示众。从此他成了禁林里最阴魂不散的冤家，不光偷鹿，还专放冷箭扎护林卫马屁股，直到赏格高得连族叔都想卖他才远遁江湖。" },
	{ ID = "wx_bio_325", Text = "蜀中老林深处不光藏着梅花鹿，还常有南疆五毒探子遗落的青竹毒针。%name%每回潜山偷猎都爱顺手牵羊，刮下毒针麻膏抹在自家竹箭尖上，放倒一头野彘省掉一半气力。有回倒霉射惊了进山打猎的世家公子坐骑，害人家摔断两颗门牙，惹得一队带刀护院漫山搜捕，他只得连夜逃出川境投你。" },
	{ ID = "wx_bio_326", Text = "月黑风高对寻常弓手是死局，对%name%反倒是开张的好钟点。常年钻禁林下铁索、听鹿鸣，他熬出一双暗夜里能辨百步人形的贼亮猫眼。可惜去年偷掏青丘旧穴时撞见了真正能口吐人言的惑心妖魅，吓得他扔下猎弓连滚带爬逃出十里，自此再不敢单人夜行，宁可跟着大伙抱团闯暗林。" },
	{ ID = "wx_bio_327", Text = "官府在山口竖起「封山禁猎碑」，却不管山下佃户活活饿死在田埂上。%name%便拉着几个胆大后生趁夜钻进禁谷张网捕雁、射杀野雉，天亮前悄悄分肉救济村里孤老。直到庄里出了个贪图十两赏银的软骨头去县衙告密，他一箭钉穿告密者家门板，背起自制桑木短弓远走他乡。" },
	{ ID = "wx_bio_328", Text = "城里武馆教头练射箭总逼学徒盯着草靶子死站，%name%路过瞧见直撇嘴：『野兔山鸡哪有站原地等你瞄半柱香的？』他在太行禁山里练就了一手疾奔中侧身回射的野路绝活，姿势虽难看像只受惊野狗，冷箭却又急又刁。眼下禁山被黑风寨占去，私猎彻底断了财路，他便来你帐下另觅买主。" }
];

::Wuxia.Config.BackgroundBios["background.raider"] <- [
	{ ID = "wx_bio_329", Text = "三年前%name%在县城茶肆摆了三桌酒，当众将手按进铜盆发誓脱离太行十八寨、从此做个本分良民。谁料半年不到，旧日二当家便摸上门逼他带路踩盘子，不从就要烧他新盖的瓦房。他反手一刀捅死传话喽啰，一脚踢翻那只生锈铜盆，冷笑道：『白道既容不下，老子便换杆堂堂正正的大旗砍人。』" },
	{ ID = "wx_bio_330", Text = "曾在洞庭连环水寨当过五年水鬼头目，%name%最拿手大雾天撑着小划子摸上商船割断铁缆。那年大寨主私吞半船皇纲，转手把底下弟兄全出卖给官军水师顶缸。他在满江火箭里潜游三里逃出生天，背上烙着巴掌大的焦疤，发誓迟早攒够银子雇人杀回洞庭湖，亲手掀翻那座黑心水寨。" },
	{ ID = "wx_bio_331", Text = "黑风血煞宗收徒素来逼人饮血酒、斩活人立投名状，%name%早年落魄糊涂入了伙，跟着洗劫过两处镇甸。可当寨主喝令将满屋发抖的孩童全推入火坑时，他那柄见血无数的厚背刀头一回没劈下去，反倒劈翻了身旁督战头目。顶着邪宗追杀令逃出荒山后，他只想寻支硬气队伍把余生卖个明白。" },
	{ ID = "wx_bio_332", Text = "哪条官道的「招子」放得高、哪家黑店的馒头掺了蒙汗药，%name%进门端一眼茶碗便能看出七八分。他在中原旱路上干了八年截镖拦路的黑道营生，直到官军联合威远总镖局扫平了他那座山头。弟兄们死剐殆尽，唯有他乔装赶猪贩子漏网，如今改吃佣兵饭，黑白两道的行规门道全在肚里。" },
	{ ID = "wx_bio_333", Text = "摸着肋下那道寸许深的陈年刀疤，%name%从不避讳这是当年拜把子大哥背后送的「散伙礼」。那晚他们洗劫了一支西域驼队，分赃时大哥嫌他多揣两块玉佩，趁他醉倒直接捅进黑刀。他靠装死从乱尸坑爬出来，一路乞讨逃进关内，如今认死一个理儿：白纸黑字付饷的东家远比结义兄弟靠谱。" },
	{ ID = "wx_bio_334", Text = "年少轻狂时在太行山口喊过「此路是我开」，偏偏有回踢上铁板，截住了洛阳长风镖局老镖头的暗镖。老镖头没要他狗命，只折断他那口豁口破刀，请他吃了两大碗浇肉面，劝他莫将好筋骨糟蹋在烂泥沟。老镖头前年病逝后，%name%再没回山当剪径贼，提着新打钢刀投到你麾下挣份坦荡银钱。" },
	{ ID = "wx_bio_335", Text = "绿林里混了十年，%name%攒下的不是金银，而是满身风湿旧创与还不清的血债。去年悄悄潜回老家祭扫荒坟，才听邻人说老娘临终前还在替他挨家磕头赔罪。这个杀人不眨眼的悍匪在坟头枯跪一整夜，天明割袖立誓金盆洗手，只是除了一身砍杀搏命的老手艺，实在不知还能靠什么挣银子度日。" },
	{ ID = "wx_bio_336", Text = "行军路过两山夹一沟的险隘，%name%总比旁人早一步按紧刀柄——无他，当年他自己就在这种绝地里伏击过不知多少商旅。昔日他替塞外马贼打过前站，后因匪首克扣伤药银闹翻，趁夜盗匹老马奔入关内。只要你赏罚分明、不吞弟兄血汗钱，他这份刀口舔血的老辣经验抵得上十个新丁。" }
];

::Wuxia.Config.BackgroundBios["background.retired_soldier"] <- [
	{ ID = "wx_bio_337", Text = "在雁门关风雪里守了十二年墩台，%name%退伍时没见着半两安家银，只领回一张泛黄路引与一条逢阴雨便抽筋的伤腿。守备老爷说库银拿去修了戏台，敢讨饷就按哗变斩首。他默默将磨破的铁叶棉甲卷进包袱走出卫所，心想横竖都是卖命，不如卖给按日结铜板的民间头领来得实在。" },
	{ ID = "wx_bio_338", Text = "营里新丁见着关外战帮冲锋就打哆嗦，%name%却连眼皮都不抬：当年在宣府九边卫所，他挺一杆丈八长枪硬顶过三回铁骑突阵。那场死战后全伍十人只活他一个，上官非但无赏，反怪他们丢了半面破认旗。熬到四十岁削籍回乡，老屋早被河水冲垮，他只好重拾长枪再吃回头草。" },
	{ ID = "wx_bio_339", Text = "睡前定要用干布擦净箭羽、绝不把弓弦乱丢地上，这是%name%在白马义从营挨千总马鞭抽出来的死规矩。他在边塞射落过不少塞外游骑，眼力虽不及壮年锋利，听鼓变阵的战阵本能却刻进骨头缝里。前年旧部遭藩镇军头拆编吞并，他不愿替军阀打内战，便流落江湖投奔了你。" },
	{ ID = "wx_bio_340", Text = "同%name%说话得凑近右耳，他左耳早年在神机火器营操弄虎蹲臼炮时被炸膛铁砂震聋了大半。当年袍泽死于劣药炸膛的竟比死在马贼刀下的还多，管事匠官却照样往黑火药里掺河沙贪墨。伤退后领了三两抚恤金被轰出大营，他虽再不碰那催命铁管，一身临阵稳健的刀盾老功夫却丝毫未荒废。" },
	{ ID = "wx_bio_341", Text = "那顶瘪得像只破尿壶的旧铁盔遭人笑话过无数回，%name%却视若珍宝：左坑是关外大斧劈的，右坑是辽东重锤砸的，全仗它留住这颗脑袋。在边军熬了十余年队正，他生平最恨军头喝兵血、拿发霉黑饼打发弟兄冲锋。归田种了两年薄地终究手痒，闻听你这儿不欠饷、酒肉管够，立刻挎刀入了伙。" },
	{ ID = "wx_bio_342", Text = "真从死人堆里滚出来的老兵从不吹嘘斩过几员悍将，%name%逢人只爱显摆当年如何凭半袋炒面配雪水爬回边城。十五年九边戍卒生涯冻坏了他的双膝，也炼就一身崩山不乱的铁定力。见着尸傀怨灵照样稳稳端住枪杆，照他的话说：『烂骨头哪有催命克饷的监军老爷吓人？』" },
	{ ID = "wx_bio_343", Text = "原已解甲归田指望安度残年，偏偏去年藩镇抓民夫修寨墙，差役硬要拉%name%刚满十六的独子去充炮灰。老卒二话不说扯开衣襟亮出满胸箭疤替儿顶差，半道趁押解兵醉酒一板斧劈开木枷逃了出来。如今他将妻儿托给远亲照料，自己重穿旧甲挣卖命钱，只盼攒足盘缠举家南迁。" },
	{ ID = "wx_bio_344", Text = "每逢拔营前，%name%总要挨个蹲下检查年轻弟兄的草鞋绳与绑腿布，嘴里絮叨个没完。当年雁门拉练时，他亲眼见五个新兵因脚底磨烂掉队，被尾随孤狼啃得只剩鞋帮。半辈子沙场磨尽了他少年锐气，气血虽不如小伙子炽烈，可到了阵线将崩的死局，最扛得住压的往往仍是这根老木桩。" }
];

::Wuxia.Config.BackgroundBios["background.squire"] <- [
	{ ID = "wx_bio_345", Text = "替清风剑派三师叔背了四年剑匣、刷了四年青骢马，%name%虽仅习得入门三招直刺与吐纳根基，举止礼数却比市井浪荡客齐整十倍。去年师叔在荒驿中了五毒软筋散惨死，临终将半册血浸剑谱塞进他怀里催他逃生。埋了师父衣冠后，他决意先在血火江湖里打熬筋骨，日后好替师门讨这笔血账。" },
	{ ID = "wx_bio_346", Text = "在丹江云顶太和玄门扫了五年石阶，%name%日日趁清晨看师兄们云雾练剑，入夜便拿竹扫帚柄躲在柴房偷学。原指望重阳考核能入外门拜师，谁知掌院执事竟将名额卖给了捐献五百两香火银的盐商纨绔。他一怒摔断扫帚下山，胸中烧着股不服输的少年气，誓要靠真刀实剑挣个前程。" },
	{ ID = "wx_bio_347", Text = "曾随西岳紫霞观一名成名剑客游历关中，日常管着牵马磨剑、茶坊打探消息，也跟着偷学了一手轻灵快剑与护脉呼吸。不料那师尊表面满口侠义清风，暗地却替恶霸屠村灭口，被%name%无意撞破后竟拔剑追杀。他连夜顺走师父一柄旧铁剑跳窗遁走，从此彻底看穿了所谓名门正派的里子。" },
	{ ID = "wx_bio_348", Text = "河北神枪崔家门规森严，唯嫡系少爷方许入演武秘阁，%name%身为外院伴读随侍，只能日日举包铁木枪当活靶子挨打。挨了六年闷枪，他虽没蹭到什么镇族绝学，倒练出一身铁打的抗揍筋骨与老到的卡位步法。去年少爷比武失手打残别家公子，崔家推他顶缸，他索性一枪挑翻柴房锁闯荡四方。" },
	{ ID = "wx_bio_349", Text = "嵩阳铁剑门崇尚重剑无锋，门徒皆臂粗腰圆，%name%替大师兄扛了三年二十斤的生铁大剑，竟也顺势将双臂熬出几分沉猛蛮劲。师门遭黑风血煞宗夜袭那晚，大师兄血战断后，塞给他一块门徽铁牌命他南下求援。等他拼命跑回山门只剩满坡焦炭，从此孤身一人提剑浪迹天涯。" },
	{ ID = "wx_bio_350", Text = "腰间总悬着一只嵌铜丝的旧檀木剑鞘，里面插的却是把十文钱一把的粗铁剑。%name%曾追随一位号称「关中独行侠」的剑客当随侍，主公讨伐山海凶兽时折戟毒林，连尸骨都未能寻回。念着旧主临行前赠鞘的恩情，他没舍得丢下这份体面，正盼着跟你立功挣钱，亲手换柄配得上剑鞘的利刃。" },
	{ ID = "wx_bio_351", Text = "在名门大派当随侍弟子，武艺未必学得最精，伺候车马打理行囊的眼力却绝不含糊。%name%会起钉修马蹄、懂拿烈酒擦剑刃血锈，还跟着教习学过几手规整的六合基础枪法。因实在受够同门师兄动辄拿他当奴仆扇耳光，他留下一张歪扭辞呈便背包裹下山，宁可当泥腿子也要堂堂正正握兵刃。" },
	{ ID = "wx_bio_352", Text = "照宗门旧例，随侍弟子若二十岁前过不了三关试剑，便得终身留在后山挑粪种菜。%name%连闯前两关毫发无损，偏在第三关撞上收了礼的偏心执事，硬判他步法违背古制。小伙子当众折断木剑掷在演武场中，昂首走出山门，眼里烧着团烈火：『真武艺是搏杀出来的，不是给老头磕头磕出来的！』" }
];

::Wuxia.Config.BackgroundBios["background.thief"] <- [
	{ ID = "wx_bio_353", Text = "洛阳城东三家典当行至今贴着悬赏，专拿那个只摸掌柜私房银、还顺手给账房留半块烧饼的「夜狸猫」。%name%生就一双指节纤长的妙手，一根铜簪便能拨开三道弹簧暗锁。可惜上月在藩镇通判府房梁打盹时被野猫惊动，险些让护院乱箭射成刺猬，干脆暂歇梁上行当，来你军营避避风头。" },
	{ ID = "wx_bio_354", Text = "听见旁人靴底踩青石咔哒作响，%name%总要直皱眉头——干他这行的，鞋底全缝三层浸水晒实的旧棉絮，踏过霜瓦连野猫都惊不醒。早年在姑苏摸进慕氏剑庄外院偷走一枚玉佩，被护院剑客撵了七条街，靠钻进臭水暗渠憋气半刻才脱身。眼下银两花光、身手仍在，替你摸黑探营再合适不过。" },
	{ ID = "wx_bio_355", Text = "『早晓得那漆匣里盘着条活生生的南疆赤尾蝎，打死老子也不撬那扇花窗！』%name%亮出右手虎口发紫的旧疤连声叫苦。他原先只挑大户人家顺些银锭首饰，从不伤人，偏那回倒霉摸进了五毒奇门暗桩落脚院。侥幸灌半斤烧酒逼出余毒后，他连夜逃出州城，发誓宁可明抢再不乱撬黑匣子。" },
	{ ID = "wx_bio_356", Text = "营里弟兄最忌讳跟%name%拼酒划拳，只因他袖口轻晃，你腰袋里的碎银便会自己长腿跳进他碗底。他从城隍庙扒手帮起步，后来熬出一手翻墙溜索的轻身绝活，专找贪官污吏后院光顾。直到上回失手惊动家丁，搭档竟狠心抽走绳梯独逃，他摔断两根肋骨死里逃生，彻底寒心改吃佣兵饭。" },
	{ ID = "wx_bio_357", Text = "寻常梁上客多半贪财恋色，%name%偏犯了武痴毛病，前年潜进某处武馆教头卧房，放着枕边三十两纹银不偷，单顺走半册虫蛀的轻身步法残卷。他躲在破庙里照猫画虎硬练半年，腿没摔断，蹿房越脊倒真比昔日快出三尺。眼下那教头托捕快满城拿他，他索性一头扎进你队里躲清静。" },
	{ ID = "wx_bio_358", Text = "提起去年腊月在开封粮商大院钻烟囱却被铁栅卡住屁股的糗事，%name%能当场跟你掀桌子。那夜他顶着满脸锅底灰，硬拿短匕撬弯两根生铁条，从三丈檐头滚进雪堆才保住狗命。虽在贼道沦为笑柄，可那股钻缝逃生、见势不妙脚底抹油的滑溜身法，在乱军围杀中反倒最能保命。" },
	{ ID = "wx_bio_359", Text = "自诩劫富济贫纯属往脸上贴金，可%name%早年确实把偷来的半箱棉袄悄悄丢进过城西施粥棚。谁料失主花重金雇来江湖捉刀人满城搜捕，那群领棉袄的乞丐里却没一个替他遮掩。尝尽世态炎凉后他收起烂善心，靴筒里藏紧两柄分水短刺，来你帐下明码标价挣这份干净血汗银。" },
	{ ID = "wx_bio_360", Text = "别人在火堆旁磨刀擦枪，%name%却爱把玩一只从死牢摸来的锈铁锁，闭目静听锁簧咔哒轻响。他在江南当过六年江洋水寇的踩点暗探，最精夜翻寨墙抹哨兵脖子、悄无声息拉开大门栓。前头目被官军剿灭后，他揣着两根细铁丝与满脑子贼道门道投奔而来，拍胸脯说世上没哪道寨门锁得住他。" }
];

::Wuxia.Config.BackgroundBios["background.wildman"] <- [
	{ ID = "wx_bio_361", Text = "无人知晓%name%原是谁家弃婴，长白采参客帮在深林老熊洞里撞见他时，他正裹着腥臭野猪皮生啃冻硬的鹿腿。下山两年他仍只会含糊蹦出几个土词，分不清碎银与河卵石的差别，唯独瞧见烤滋滋冒油的肥羊肉双目放光。厮杀起来毫无章法，全凭堪比老熊的疯魔蛮力与厚皮糙肉，挨两刀愣是不眨眼。" },
	{ ID = "wx_bio_362", Text = "巴蜀绝谷采药人曾亲眼目睹%name%赤膊攀在峭壁古藤上，与一头白首赤足的小次山朱厌巨猿对吼争抢野梨。那番血斗在他胸膛撕出三道狰狞白疤，也逼出一身铜浇铁铸般的蛮横筋骨。后来一场雷火烧毁了他栖身的岩穴，他循着远处炊烟茫然走出大山，浑浑噩噩撞进了你的营地。" },
	{ ID = "wx_bio_363", Text = "寻常武夫误入都广建木老林不出三日便迷死在毒瘴中，%name%却在参天巨树的枯洞里独活了十余载。吃惯了树皮灵脂与山蛇苦胆，他五脏六腑硬生生熬出几分抗毒耐打的奇异体魄。初进集镇时听不懂酒保喊价，顺手掀翻整张柏木长案，好在你用两斤烧牛肉和一壶甜米酒轻松将他哄进队里。" },
	{ ID = "wx_bio_364", Text = "满脸乱蓬蓬的黑髯直连到眼眶底下，十指指甲厚如弯钩，%name%见着大车木轮转动都要蹲地好奇地戳两下。乡老传言他是几十年前躲兵祸遁入神农架绝谷的流民遗孤，族人老死殆尽后，独留他与豺狼野猪为伴。虽然连左右步都分不清，可只要塞给他一根粗硬木棒，挡路敌手多半筋折骨碎。" },
	{ ID = "wx_bio_365", Text = "别指望%name%听懂什么阵法号令或江湖规矩，在他浑浊却凶厉的眼里，天下活物只分两类：分肉给他吃的同窝伴，以及抢他肉吃的猎物。早年有伙绿林劫客进山抓他当苦力，半夜反被他徒手拧断了三个看守的脖子。发饷时你只需将铜板换成大块卤肉烈酒，他便敢替你撕烂任何扑上来的恶兽。" },
	{ ID = "wx_bio_366", Text = "关外山民曾把%name%错当成食人山魈供奉三年，逢年过节往山口石台摆猪头浊酒，直到胆大猎户偷瞧见这怪物竟会敲火石生火烤猪耳。他天生肺活量骇人，临阵扯破喉咙一声野嚎，连百战老马都要受惊人立。深林闹兽潮后他跟着猎户下山见世面，如今正兴冲冲拿敌军铁盾试自己拳头有多硬。" }
];

::Wuxia.Config.BackgroundBios["background.witchhunter"] <- [
	{ ID = "wx_bio_367", Text = "瞥见%name%腰间那串黑狗血浸过的长铁钉与冷银短剑，茶馆里正讲荒冢鬼话的闲汉立刻噤声。他在湘西毒瘴里追剿了七年赶尸妖道，亲手泼火油烧过三十余具披甲铁尸傀，全程眼皮都没眨一下。旁人畏惧邪祟损阳气、沾之必疯，他却冷笑着抹过剑身朱砂：『再凶的千年尸王，断了脖颈照样挪不动步。』" },
	{ ID = "wx_bio_368", Text = "三年前云梦荒村接连失踪九名壮丁，乡民请来法师画符无功，最终是%name%背着硬弩孤身进山，三箭钉死一头幻作寡妇模样的青丘惑心妖魅。他自己也付了代价，左肋被妖爪撕出三寸乌黑暗伤，至今逢阴雨仍往外渗寒气。自打亲手剥穿美色皮囊底下全是腐骨，他看世人的眼神便再无半分温热。" },
	{ ID = "wx_bio_369", Text = "南疆五毒奇门生平最恨两类人，一是蜀中唐家堡的暗器手，二是像%name%这样专掀毒坛、专捅蛊师喉管的铁面缉异人。他全家早年丧命于五毒试药散出的紫瘴，唯有他靠生嚼雄黄熬过三夜捡回残命。如今他随身挂着烈醋葫芦与淬银弩箭，无论对面是吹箭毒手还是炼体药人，见着先放血验真身。" },
	{ ID = "wx_bio_370", Text = "眼窝深陷发青，瞧着宛如十年没合过眼——对%name%而言事实也差不离。前年夜宿幽谷荒庙，他遭一头梦魇讹兽钻入梦境索魂，硬是咬烂舌尖借剧痛挣脱幻障，反手一剑挑穿那妖物眉心诡眼。从此他每晚只敢倚在篝火边打半个时辰盹，醒来头一件事便是清点辟邪符灰与弩箭是否齐整。" },
	{ ID = "wx_bio_371", Text = "朝廷礼部嘴上斥责怪力乱神，暗地却常砸重金雇%name%这种冷面行家去收拾荒冢尸变与邪宗血祭的烂摊子。他在前朝古墓里同守陵祭司拼过命，也拎火把烧穿过邪派药人的炼丹地窟，手上沾染的邪血比老屠夫还厚。上月雇他的钦差遭政敌下狱，他断了暗饷，只好转入民间佣兵继续猎邪挣饭。" },
	{ ID = "wx_bio_372", Text = "江湖游方术士抓鬼爱踏罡步、烧黄纸，%name%偏嗤笑那是骗寡妇银子的把戏。在辰州与赶尸邪宗缠斗八年，他总结出的靖邪真经不过十二个字：『先砍摇铃妖道，再卸尸傀膝盖。』他定力冷硬如铁石，休说荒冢怨灵凄厉夺魄，纵使九尾妖魅贴耳吹气，他亦能面不改色将淬银短剑送入对方心窝。" }
];
