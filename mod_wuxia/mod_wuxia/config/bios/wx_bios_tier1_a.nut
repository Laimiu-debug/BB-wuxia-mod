// 500 Independent Dark-Wuxia Character Biographies - Part 3/5 (Tier 1A: 102 bios, wx_bio_161..wx_bio_262)

if (!("BackgroundBios" in ::Wuxia.Config))
	::Wuxia.Config.BackgroundBios <- {};

::Wuxia.Config.BackgroundBios["background.anatomist"] <- [
	{ ID = "wx_bio_161", Text = "杏林济世堂将%name%逐出师门那夜，众人从药房地窖里翻出了半具黑风血煞宗药人的尸骸，胸腹早已被柳叶刀剖得纤毫毕现。同门骂他亵渎亡魂，他却只顾着往油纸本上抄录经脉膨大之象。如今他背着那只泛血腥气的漆皮药匣随队行走，倒不是心怀仁慈，只因厮杀过后满地新伤旧尸，没人会拦着他细看筋骨纹理。" },
	{ ID = "wx_bio_162", Text = "十指指甲常年泛着诡异青紫，舌尖更是麻得尝不出咸淡，这全是%name%早年专攻南疆五毒奇门解药落下的毛病。为了验出蟾酥与蛇胆的君臣配伍，他狠心拿自个儿当药罐试了七回毒，差点没挺过寒冬。平日缝合刀口时总爱生嚼大蒜，嘴里念叨着脓血稠度，随行只图攒些异兽苦胆与奇虫毒囊。" },
	{ ID = "wx_bio_163", Text = "在洛阳府衙义庄当了八年仵作，%name%对活人的寒暄一窍不通，却能单凭伤口皮肉外翻的弧度断出凶手使的是雁翎刀还是分水刺。后来他验出一桩盐商暴毙案乃知县外甥暗下断肠散，未及递状便撞见两名衙役提刀堵门。连夜翻墙遁入江湖后，他索性把验尸的精准劲儿挪到了救活人身上，手稳得令伤兵直打寒颤。" },
	{ ID = "wx_bio_164", Text = "巴蜀边镇的药铺掌柜们曾抢着买%name%炮制的毒蛟筋膏与白猿胆丸，谁料同行眼红，暗中往他卖给乡绅的跌打散里掺了巴豆与生漆。一夜之间铺子被砸，连拉车的老骡也被公人牵走。吃过这回暗亏，他悟出光会认草药护不住身家，不如跟着刀口舔血的弟兄混饭吃，既能收诊金，又能亲手剖些山泽异兽的脏腑。" },
	{ ID = "wx_bio_165", Text = "为了弄清湘西行尸为何断筋不僵，%name%曾花光半生积蓄贿赂一名辰州符水门赶尸匠，点着牛油残烛在荒庙里临摹了三夜黑筋穴位图。结发妻子嫌他浑身尸臭，一把火烧了半摞手稿便卷着细软跟粮商跑了。他倒浑不在意，拾掇起银针与药剪便投了这支队伍，坚信战阵乱世才是天下最慷慨的医道讲堂。" },
	{ ID = "wx_bio_166", Text = "雁门卫所的伤兵营里常年缺药少绷带，军需官把上好金疮药全倒卖给了私商，逼得%name%硬生生练就了一手烈酒洗创、烧红铁钎止血、猪肠线缝皮肉的凶悍医术。有回醉酒千总烂腿身亡，上司偏要把黑锅扣在他头上。他趁换岗偷摸扛走两箱药材扬长而去，如今替弟兄们接骨拔箭，图个银钱敞亮、不受窝囊气。" }
];

::Wuxia.Config.BackgroundBios["background.apprentice"] <- [
	{ ID = "wx_bio_167", Text = "在中州振武堂擦了三年白蜡枪杆、扫了三冬演武场积雪，%name%却连套完整的六合枪法都没摸着，只因馆主专把真东西留给送厚礼的富商少爷。他只能蹲在柴房门缝后偷记步法，半夜对着草垛闷头猛扎。直到馆主又要榨他五两银子才肯教第四式，这倔小子干脆啐了一口，背起包袱来江湖上讨真本事。" },
	{ ID = "wx_bio_168", Text = "淮阳小武馆里最沉不住气的便是%name%，上月喝了二两烧刀子，便敢在茶摊前接钱塘怒潮帮码头恶汉的挑衅。那一架砸烂三张八仙桌，自己锁骨也挨了一记肘击，馆主怕赔银子，当众宣布将他逐出门墙。如今他腰间仍倔强地缠着那条磨毛的旧练功带，憋着一口气要在真刀真枪里讨回脸面。" },
	{ ID = "wx_bio_169", Text = "舅父原是花钱送%name%去拳馆治气喘的，谁知教头拿他当免费长工，整日挑大缸水、舂沙袋，反倒把一对肩膀压得如老榆木般敦实。前年流匪夜袭集镇，那平日吹得天花乱坠的教头头一个钻进地窖插上门闩。他抄起院里练功铁棍守到天明，事后把武馆招牌一脚踹歪，头也不回地踏上了吃佣兵饭的路。" },
	{ ID = "wx_bio_170", Text = "昔日在清风剑派一处外门别院熬药烧火，%name%无意间从灶膛边捡出三页包过话梅的残破吐纳剑诀，夜夜躲在晾衣架间拿着竹枝比划。不料被巡夜大师兄撞个正着，挨了二十记藤条后连鞋都没穿全就被撵出后门。那半吊子剑招用来吓唬地痞尚可，真要化成保命本钱，还得跟这班见惯血光的人慢慢打熬。" },
	{ ID = "wx_bio_171", Text = "为了抵减束脩，%name%在城南武馆兼着喂马看门，勤勤恳恳蹲了两年四平马步，本以为熬出头便能学两手拿手刀法。偏生某个雷雨黄昏，他提灯去后院添草料，撞见大师兄正把私吞的账银往师娘袖筒里塞。不等天亮挨黑手，他麻利地卷起铺盖顺走一把钝铁刀，在路口听闻招人便一咬牙按了手印。" },
	{ ID = "wx_bio_172", Text = "一心想进威远总镖局吃皇粮，%name%连考了三回入门试：头两回抱不起百斤石锁，第三回演枪时紧张得一脚绊在石阶上啃了满嘴泥。考官嗤笑着劝他回家挑粪，他愣是没哭没闹，攥着满手血泡转身就走。如今投身这群刀头舔血的汉子，便是要拿实战疤痕狠狠抽那帮眼高于顶的镖头一记耳光。" },
	{ ID = "wx_bio_173", Text = "变卖了亡父留下的半亩薄田，凑足四十贯铜钱拜入一名自称关外刀客的江湖教头门下，%name%苦练了半年五虎刀势，却没料到师父在地下赌坊输红了眼，趁月黑风高卷着所有学徒的束脩逃得无影无踪。只剩他握着一把崩口木刀站在空院里发愣，痛定思痛后明白，与其花钱听吹牛，不如拿命在路边现学现卖。" },
	{ ID = "wx_bio_174", Text = "跟过一位瘸腿老趟子学武，整整两年只练弓步扎马与单调的力劈华山，同街那些耍花枪的轻薄少年常笑%name%学的是『砍柴把式』。直到庙会冲突里，他面不改色地一棍砸断了挑事者的枣木齐眉棍，连带震裂了对方虎口。闹出伤人官司后，老教头塞给他三串铜钱促他远行，嘱咐他切莫丢了这股子朴拙狠劲。" }
];

::Wuxia.Config.BackgroundBios["background.bastard"] <- [
	{ ID = "wx_bio_175", Text = "生母不过是姑苏慕氏支脉偏院里的浆洗丫鬟，%name%连祠堂门槛都不配跨进半步，更不许碰库房里的正经钢剑。少年时他总躲在花窗阴影里偷窥嫡兄演剑，拿根扫院竹帚把每一式挑刺暗记在骨头里。老家主刚咽气，主母便将生母遗物变卖殆尽，他摸走门房一把锈刀翻出高墙，从此再不认那块金漆匾额。" },
	{ ID = "wx_bio_176", Text = "淮阳豪商的私生子身份曾替%name%换来几两月银与一位金刀门退役护院的指点，直到嫡长兄醉酒在画舫失手打死一名弹琵琶的歌伎。族老们连夜商议，竟打算让他这名不入族谱的贱种去公堂顶罪。暴雨夜他光着脚攀过砖墙逃命，如今回望那些锦衣玉食，只觉远不如手里这口沉甸甸的钢刀来得实在。" },
	{ ID = "wx_bio_177", Text = "年节家宴永远没有%name%的座次，偏偏他生着与家主如出一辙的冷硬眉眼，脾气也犟得像头驴。前年腊月因受不了嫡兄拿生母出身百般羞辱，他抄起铜暖炉砸歪了对方的鼻梁，挨了三十记家法水火棍后被彻底逐出偏门。怀里如今只剩半块磕角的旧玉佩，喝醉了便拿它敲酒碗，骂尽高门大宅里的虚伪礼法。" },
	{ ID = "wx_bio_178", Text = "洛阳大宅里亲爹连他小名都记不全，真正拉扯大%name%的，是门下一名曾在长风镖局走过夜路的独眼老门客。老头没教他四书五经，倒把全套粗陋却要命的缠斗刀法与吐纳诀倾囊相授。见族里为补税银亏空硬把亲妹嫁去给贪官填房，他吐了口血沫摔门而出，发誓要在泥潭里挣出个没人敢划掉的名号。" },
	{ ID = "wx_bio_179", Text = "官府贴出告示命大户抽丁赴雁门充军时，继母眼皮都不眨便篡改了岁数，将最碍眼的庶子%name%顶上了花名册。押解途中行至荒坡草店，他把生母攒下的两根银簪全塞给贪财解差，趁夜挣脱麻绳遁入山林。挨过三日饿后他彻底想通：同样是提着脑袋卖命，替这支队伍搏银子总强过替那窝白眼狼挡箭。" },
	{ ID = "wx_bio_180", Text = "哪怕在烂泥地里啃干粮，%name%也死活不肯拿袖口擦拭兵刃，喝汤前总要先吹开浮油，这股讲究劲儿全是从蜀中旧宅带出来的毛病。在那深院里他半主半仆活了十八载，直到某夜发现老管家暗往他药罐里添慢毒才猛然惊醒。抽剑刺穿管家手背逃亡后，他不再盼着认祖归宗，只信银钱与冷铁不欺生。" }
];

::Wuxia.Config.BackgroundBios["background.belly_dancer"] <- [
	{ ID = "wx_bio_181", Text = "往昔随沙州驼铃商帮东行时，%name%总赤足踩着胡毯在驼毛大帐里旋舞，铜铃响处目光早将豪商腰间的钱袋与护卫配刀扫了个遍。某夜一名醉醺醺的瀚海弯刀盟头目试图将其强拽出帐，三枚细若牛毛的淬麻银针便自绣花袖口无声滑出，当场了结了那场腌臜交易。如今换上行脚短打，走起路来依旧轻得像阵漠北流沙。" },
	{ ID = "wx_bio_182", Text = "弯腰反折身子用睫毛挑起地毯上的铜钱，这是%name%在吐鲁番杂耍班里挨藤条熬出来的绝活，练就了一副柔韧如柳的腰肢与惊人平衡感，寻常悍匪连衣角都摸不着。后来马贼血洗绿洲集市，班主因交不出抽头银被乱刀砍死在鼓架旁，%name%趁乱抓起一把防身短刃逃进关内。战阵之上才发现，昔日躲避醉汉咸猪手的滑步，拿来避开钢刀劈砍竟同样管用。" },
	{ ID = "wx_bio_183", Text = "曾在西域圣火明尊教一座大漠外坛充当献舞杂役，四年间日日绕着烈焰铜盆踏步吐纳，私下顺带偷学了护坛教众几手奇门暗器与卸力转腰的诀窍。一场遮天沙暴刮塌偏殿后，%name%揣着半袋无花果干和一束磨尖骨针逃向中原。平日总爱斜倚行囊浅笑拨弄银镯，可一旦兵刃相接，身法快得宛若火影乱窜。" },
	{ ID = "wx_bio_184", Text = "凉州到甘州官道上的酒肆里，人人都爱看%name%披着红纱旋身起舞，却没几个醉醺醺的卫所书吏察觉那双涂着青黛的眼睛正死死盯着桌上的调兵文书。帮暗桩套了三年情报，临了上家却想杀人灭口免留后患。反手拿发簪捅瞎刺客左眼脱身后，%name%再不愿替阴沟里的主子卖命，宁可来这亮堂处搏命分银。" },
	{ ID = "wx_bio_185", Text = "仗着身量纤瘦、眉目俊俏，%name%当年在丝路驼市常蒙起茜红面纱扮作胡姬献艺，专挑肥头大耳的马贩子下手，一记锁腕寸劲便能把动手动脚的色鬼拧得跪地求饶，顺手再摸走对方荷包。直到惹毛了一名好色通判被画影图形，才洗净脂粉换回男装随众奔走，虽不再摇铃起舞，那双藏针快手却愈发毒辣。" },
	{ ID = "wx_bio_186", Text = "荒年里被亲叔卖进河西乐舞商队，%name%靠顶火碗、翻跟头与袖底甩飞针讨生活，硬是在沙盗与官兵夹缝间活了下来。耗尽积蓄总算赎出自己卖身契，可胞妹仍陷在边镇酒楼里还差六十两赎银。如今将战阵当成另一座高台，只因踏错半步便要掉脑袋，唯有赢下每场死斗才能早日带亲人离了那风沙苦海。" }
];

::Wuxia.Config.BackgroundBios["background.bowyer"] <- [
	{ ID = "wx_bio_187", Text = "双手常年被鱼鳔胶与烤水牛角熏成焦黄色，%name%在河间府开弓铺二十年，经手鞣制的桑木角弓连边军老射手都竖大拇指。偏生新来的兵备道爷一口气征走四十张成弓充作军礼，却连半文木料钱都不肯给。他咽不下这口恶气，拎走架上那张最称手的未漆硬弓弃铺远走，发誓往后只让流血的汉子用自己的弓。" },
	{ ID = "wx_bio_188", Text = "眼见神机火器营的三眼铳与神臂弩抢走了大半主顾，老实巴交的制弓匠%name%怎么也不服这口气。铺子撑到腊月终于关张，他背上刨弓木挫与自制竹胎长弓入了行伍，总爱在营火旁嗤笑火药遇雨便成烂泥。为了向世人证明老祖宗的筋角弓宝刀未老，每逢接战他都憋足了劲专挑对方披甲头目的面门招呼。" },
	{ ID = "wx_bio_189", Text = "禁不住辽东山寨开出的双倍雪花银，%name%曾在僻静窑洞里偷偷给绿林悍匪压制过一批六斗重弓。不料官兵端了匪窝后，一眼认出弓把内侧烙着的半月匠记。赶在公差拍门前，他一把火烧了账本卷着弓弦逃往南方，如今落脚这支队伍，闲时仍像伺候娇妻般拿羊油细细擦拭弓背上的每一缕筋丝。" },
	{ ID = "wx_bio_190", Text = "平生最大一桩蠢事，便是听信江湖货郎鼓吹，抵押整座作坊买下一条干瘪的岭南毒蛟筋，妄想造出张传世宝弓一举扬名。谁知焙火上胶时那怪筋轰然崩断，不仅震裂了工作台，还削去他半条左眉。欠了一屁股木行烂账后，%name%只好提着旧弓混迹沙场，一边挣银还债，一边盼着亲手猎头真异兽剥筋泄愤。" },
	{ ID = "wx_bio_191", Text = "最初%name%压根不算武人，只是跟在白马义从营巡逻队后头修弓换弦、削刮箭杆的沉默随军匠。可每修好一张强弓总得亲自拉满试射，日复一日在黄昏土坡上调息校靶，竟练出比许多老卒更稳的准头与肺活量。义从营遭伏溃散那夜，他背着半筒狼牙箭杀出重围，从此干脆丢下木刨，凭百步穿杨的手艺混饭吃。" },
	{ ID = "wx_bio_192", Text = "营地里谁要是敢拿箭羽蹭脏泥或用钝头劣箭，准得挨%name%半个时辰的臭骂，单凭箭矢破风声他便能听出鹅翎是不是粘歪了半厘。早年给洛阳团练头目做弓，因看不惯对方克扣经费采购朽木箭杆，当着全营面将整捆劣箭拗折在膝头，结果当场被轰出大营。如今自己造箭自己射，夜里睡觉都要抱着防水牛皮弓囊。" }
];

::Wuxia.Config.BackgroundBios["background.brawler"] <- [
	{ ID = "wx_bio_193", Text = "在钱塘江码头替怒潮帮盯了十年装卸份子钱，%name%一双拳骨砸得比鹅卵石还扁平坚硬。那夜对手盐枭雇来名快刀客，一刀掀翻了他半条小臂皮肉，帮里堂主却连帖接骨黑膏都舍不得赊账。缠紧麻布条走出医馆后，他彻底看透了码头义气的成色，干脆投了这班明码实价的刀客，免得再替白眼狼白挨黑刀。" },
	{ ID = "wx_bio_194", Text = "开封城外废弃粮仓的地下黑擂里，%name%光着膀子挨过不知多少闷拳，专供绸衫老爷们磕着瓜子下注取乐。有回庄家暗递眼色叫他第四回合故意趴窝，可对手偏生往他脸上啐了口浓痰。火冒三丈的他顺手捶塌了对手颧骨，又一记摆拳放倒咆哮的擂主，抓起半匣赌银翻窗逃命，从此再不打那假惺惺的笼中架。" },
	{ ID = "wx_bio_195", Text = "淮阳渡口最乱的酒肆雇%name%看了三年场子，不管多少醉醺醺的漕帮汉子闹事，他都能在不洒出自家半碗黄酒的功夫里把人叠成罗汉，落了个『拆凳阎王』的浑名。坏就坏在有回把一名微服嫖赌的府衙书办倒栽葱塞进了咸菜缸，惹下通缉官司。如今混迹佣兵营，总算能名正言顺地挑硬骨头砸个痛快。" },
	{ ID = "wx_bio_196", Text = "大雪封山那冬，%name%与一位遭逐的少室禅院酒肉和尚挤在破土地庙里啃冻萝卜，帮老和尚劈了一冬柴火，换来每日鼻青脸肿的罗汉散手喂招，硬生生把两条小臂磕得如铁梨木般死硬。开春老僧坐化在泥塑佛脚下，他埋了恩人便揣着两条缠手布闯荡南北，平日寡言少语，一闻见血腥味指节便咔吧作响。" },
	{ ID = "wx_bio_197", Text = "昔日在扬州替放印子钱的恶霸讨债，%name%拧断过不少赖账赌徒的手腕，自认早没了良心。直到东家逼他去把一名寡妇的盲眼闺女拖进窑子抵十二贯利钱，他盯着孩子发抖的瘦肩愣了半晌，转身一记铁山靠撞碎了东家的锁骨，顺带将借据全抛进运河。惹得三县打行悬赏要他双耳，便干脆随队远走避风头。" },
	{ ID = "wx_bio_198", Text = "川江激流里拉过七年盐船纤绳，%name%那一身滚地锁喉、铁头撞胸的野路子摔打功夫，全是在齐踝烂泥滩上替袍哥盐帮抢泊位时拼出来的。前年山洪冲垮了胞兄的平底木船，盐帮不但不救济反倒催讨船租，他气得砸烂账房算盘扬长而去。如今卸下麻绳缠紧布拳套，只盼攒够银钱回老家起两间瓦房。" },
	{ ID = "wx_bio_199", Text = "西市泼皮见了%name%绕道走，倒不是他拳法多精妙，而是挨了一块青瓦拍额头也只会咧嘴吐口血沫，顶着血糊拉碴的脸继续往前死掐。原在乡绅庄院护院收租，一次催粮被农夫草叉扎穿小腿，东家嫌晦气直接将他扔在乱坟岗边。靠着条贱命硬熬过来后，他只认一条死理：谁给热饭不丢弃伤兵，他就替谁砸开前路。" },
	{ ID = "wx_bio_200", Text = "心里总藏着个做风流剑客的蠢念头，%name%早年搬砖攒了半年工钱去学剑，结果手劲太莽，三天捏裂两把木剑，演练拆招时还失手一拳打飞了教头的门牙。彻底死了拿细剑的心后，他认命地箍上铁指虎靠贴身猛锤吃饭，只是每回把悍匪捶得满地找牙时，嘴里仍要荒腔走板地哼两句不知从哪偷听来的酸诗。" }
];

::Wuxia.Config.BackgroundBios["background.butcher"] <- [
	{ ID = "wx_bio_201", Text = "在洛阳南门肉市五更杀猪十四年，%name%练就了一手漆黑里听声辨骨的绝活，厚背剔骨刀贴着颈椎缝隙一旋，三百斤肥猪连哼都来不及哼便断了气。大旱那年饥民暴动冲抢肉案，他红着眼劈翻三名挥棒的流匪，见官兵吹哨围拢，便提着滴血杀猪刀混出城门。如今上阵砍人，只觉和案板上剔槽头肉没甚两样。" },
	{ ID = "wx_bio_202", Text = "县集庙会上一头疯牛挑翻两座布棚、顶伤三名衙役，满街武夫皆不敢近前，唯独系着油腻牛皮围裙的%name%大步上前，拿砍骨刀背震昏牛额，顺势一刀割断喉管，动作稳得像切嫩豆腐。偏生结发娘子嫌他身上洗不净猪油臊气，跟绸缎庄账房跑了。他抹把脸拾掇起磨刀石离家，从此改宰那些更欠收拾的恶汉。" },
	{ ID = "wx_bio_203", Text = "深秋夜里被黑风血煞宗蒙面人掳进山洞，只因那些邪派术士需要手稳心冷的屠户替溃烂的炼体药人剜除腐肉、锯断坏疽残肢。在血污恶臭的石窟里提心吊胆熬了两个月，%name%趁炼丹炉炸裂乱作一团时一刀剁翻看守，滚下荆棘坡捡回条命。经历过那等阴间差事，战场上再惨烈的断臂残肢也惊不动他半根眉毛。" },
	{ ID = "wx_bio_204", Text = "曾随边镇辎重队在雁门关外专职宰杀折腿战马、腌制咸肉，常替战死卒子剥下破损铁甲，倒把皮甲叶缝与腋下筋络的弱点摸了个门清。军需官贪墨了他整整三季工钱还骂他贱业污秽，%name%临走前将那狗官的鹿皮马靴浸进了腌肉卤缸，提着斩骨厚刀投奔江湖，宁可真刀真枪搏前程也不受闲气。" },
	{ ID = "wx_bio_205", Text = "巴蜀老猎户拖回一头浑身生毒泡的山泽怪彘，整条街的屠户都怕沾染尸瘴躲进门后，唯独%name%灌下两大碗烧酒、拿湿布蒙住口鼻，稳稳当当将那畜生开膛破肚，连半滴毒囊都没划破。虽得了十两赏钱，愚昧邻里却传他沾了妖邪晦气，再无人肯买他的猪肉。铺子倒闭后，他背着砍骨重刀走上江湖，倒也落个清净。" },
	{ ID = "wx_bio_206", Text = "肉案上从不注水、也常拿大骨头白送巷口乞儿，%name%本想安稳做一辈子本分屠户，偏偏管片衙役每逢赶集都要白拎二斤上好五花肉。第七回对方伸手来抓时，他面无表情地抡起斩骨刀狠狠剁在肉墩上，刃口离那厮指尖不过半寸，生生劈裂了半尺厚的枣木墩。不等大牢铁链上门，他卷起盐袋与磨石便投了这支队伍。" },
	{ ID = "wx_bio_207", Text = "平日一天说不上五句囫囵话，%name%比起听酒徒吹牛，更习惯钢刃刮过软骨的闷响。在淮阳大户人家后厨宰了十年全羊，每晚收工总躲在熏肉房后拿厚背刀劈砍悬吊沙包，练得双腕如铁钳般沉稳。问他为何放着安稳厨役不做来吃刀口饭，他只闷声道：给阔佬片羊肉赏钱太薄，换作阵前劈贼子，银子来得更爽快。" },
	{ ID = "wx_bio_208", Text = "靠着城外乞丐巷口一口狗肉老汤锅起家，%name%脾气暴烈却最护自己人，常拎着根比马蹄铁还厚的剔骨大刀喝退寻衅地痞。县里恶少因讨债不成，暗中拿砒霜毒死了他养了六年的看门黄狗。他当夜踹烂恶少院门，削掉对方半只耳朵又砸松四颗门牙，趁海捕文书未发前收拾行囊远走，这份凶悍护短的性子至今未改。" }
];

::Wuxia.Config.BackgroundBios["background.caravan_hand"] <- [
	{ ID = "wx_bio_209", Text = "替威远总镖局喊了十一年『合吾』，%name%不仅嗓子叫风沙磨得像破锣，还能单看坟头乌鸦惊飞的方向便断出山坳里藏着伏兵。前年总舵分号一名贪心镖头私吞了孝敬太行十八寨的买路银，害得四名年轻趟子——包括他亲表弟——惨死乱箭之下。他一怒之下交还号衣，从此肩扛长枪浪迹江湖，见了满嘴仁义的东家总要多留八个心眼。" },
	{ ID = "wx_bio_210", Text = "上回替洛阳长风镖局押送三只火漆封口的『陈年砖茶』箱南下码头，行至荒坡却遭十余名黑衣快刀客截杀，箱板劈裂后滚出的竟是整摞私盐引票。劫匪得手远遁，镖局为了遮丑反将失镖罪名全扣在几名幸存趟子头上。被摘去黄铜腰牌的%name%骂骂咧咧走了人，发誓往后凡是不给开箱验货的差事，给一座金山也不接。" },
	{ ID = "wx_bio_211", Text = "随沙州驼铃商帮穿越戈壁贩运玉石与大黄时，%name%曾为躲避瀚海弯刀盟的夜袭，连续三宿缩在跪卧骆驼的臭肚子底下啃干馕、饮驼血。压垮他最后一点耐心的是一场黑沙暴：商队老东家宁可死拉着两匹蜀锦不放，也冷眼看着发高热的提水童子被流沙吞没。如今改投刀客行伍，只因这里手里的铁器终归先护着身边喘气的活人。" },
	{ ID = "wx_bio_212", Text = "沿着南疆五毒奇门地界边缘押运六趟药材，%name%每回都往绑腿与靴筒里塞满硫磺雄黄粉，睡前必拿竹竿敲遍草窝防毒蛇与冷箭。第七趟过瘴林时，他肩胛还是挨了支倒钩吹箭，抠门货主竟从他微薄脚钱里硬扣了半瓶解毒散的银子。伤愈后他头也不回地离开商行，如今走哪都绷紧弓弦，见了无风乱晃的灌木丛便先挥刀探路。" },
	{ ID = "wx_bio_213", Text = "只需把耳朵贴在官道车辙边听半刻，%name%便能靠榆木车轴的吱呀闷响，分辨满载的是生铁、糙米还是私藏官银。七年来他护着粮车在洞庭连环水寨眼皮底下闯过无数暗滩，练就一手窄路护车长枪与雨夜生火本事。前年雪天过木桥摔伤膝盖，冷血镖头嫌他瘸腿便直接辞退，谁知休养一月腿骨便硬朗如初，正好来此处谋个前程。" },
	{ ID = "wx_bio_214", Text = "荒郊野店里一碗滚烫羊肉汤刚端上桌，%name%瞥见店小二油黑拇指死死避开碗沿，当即心头警铃大作，借口系鞋带将酒汤泼进桌底。半夜果真有两名翻窗摸黑的绿林贼子扑来，叫他拎着短枪穿糖葫芦般戳翻在地，护住了整车绸缎。事后东家只丢给他两贯缺斤短两的私铸铜钱，气得他干脆不干了，这般机警脑瓜岂能贱卖给守财奴。" },
	{ ID = "wx_bio_215", Text = "经人介绍替川江一名阔绰客商押运『官窑青瓷』出山，直到独轮木车陷进泥坑摔裂货箱，%name%才骇然看见稻草里裹着两具铁链锁喉的湘西干尸与整桶火药硫磺。他可不想为了偷运邪门禁货把脑袋留在荒岭，当夜趁账房熟睡牵走一匹健骡，顺手取走自己应得的那份佣银便消失在雾里，宁可明着搏命也不替鬼祟主顾背黑锅。" },
	{ ID = "wx_bio_216", Text = "十四路绿林的拜山切口、三十座税卡把总的胃口深浅、以及一比四落单时如何靠三寸不烂之舌体面脱身，%name%统统背得滚瓜烂熟。因早年肩胛受过箭伤加上风湿入骨，骑不得烈马才退出了长途快镖，但只要提着朴刀步行随队，沿途哪家客栈的黑心包子不能吃、哪条抄近山道埋伏多，全营上下找不出第二个比他更熟的老油条。" }
];

::Wuxia.Config.BackgroundBios["background.companion"] <- [
	{ ID = "wx_bio_217", Text = "三年前腊月那场冻雨里，咱们被山匪追进无顶关帝庙，断水断粮守到三更，是%name%把怀里最后半块发霉麦饼掰给你，又递来半葫芦发酸的劣质米酒润喉。整夜他握着崩口单刀冻得十指黏在刀柄上，嘴里却还拿那尊缺耳泥像打趣。从那宿共守残火起，他便认准了你这面破旗，给座州府衙门的铁饭碗也不换。" },
	{ ID = "wx_bio_218", Text = "前年深秋芦苇荡遭伏那一仗，冷箭钉穿了你的小腿肚子，半数新募来的散人见势不妙扔下兵器就往河堤逃命。唯有%name%破口大骂着冲回来，一把将满身泥血的你甩上宽背，单手舞着豁口厚刀硬生生劈翻两名扑上来的水匪杀出血路。直到今天喝酒时，他还总掰着指头催你欠他的三坛老汾酒，可真遇险境仍会头一个挡在你身前。" },
	{ ID = "wx_bio_219", Text = "你与%name%头一回并肩搏命，是在一场瓢泼大雨夜的荒村义庄外。当时一名邪道术士驱使七八具僵硬行尸围住了折轴镖车，你们背靠背踩在齐踝黑泥里死战到天明，他一边拿包铁枪尾砸碎尸傀下巴，一边还有闲心嘲笑这些死鬼嘴里的腐臭胜过酸菜缸。打那惨淡黎明过后，战场上你们连声招呼都不用打，一个眼神便知如何替彼此补位。" },
	{ ID = "wx_bio_220", Text = "最初结识%name%不过是在岔路口破酒馆里拼桌吃肉，偏生一名输红眼的赌徒暗中朝你后颈甩出淬毒金钱镖。千钧一发之际，他随手拎起锡酒壶将毒镖砸落桌角，事后却咧嘴坦白，纯粹是不想你溅出来的血污了他刚花三十文买的酱驴肉。正是这份不装腔作势的实在劲儿，陪着你扛过了六载风餐露宿、荷包见底的苦日子。" },
	{ ID = "wx_bio_221", Text = "早先那个薄命行帮在北境阴风峡折戟沉沙后，全队只剩你与%name%从死人堆里爬了出来，拿半截断矛替老头领和弟兄们挖坑掩埋，对着血红落日发誓总要重振旗鼓。至今他腰间仍拴着旧头领留下的瘪口锡酒壶，看见新兵蛋子糟蹋磨刀石或马虎擦甲便会黑着脸厉声斥骂，硬是把那些亡魂留下的规矩在这座新营盘里守了下来。" },
	{ ID = "wx_bio_222", Text = "围着篝火吹牛斗酒时，%name%从来不是嗓门最响的那个，可当年队伍穷得只剩三匹瘦骡与满架锈刀时，是他悄悄把自家棉袄拿去换了一捆牛皮筋线，顶着霜冻连熬两宿，就着炭火把全队松脱的札甲片逐一铆牢。跟着你转战四个州府流过不知多少碗血，他摸透了你皱眉时的所有盘算，却仍心甘情愿守在你左翼最凶险的缺口上。" }
];

::Wuxia.Config.BackgroundBios["background.cultist"] <- [
	{ ID = "wx_bio_223", Text = "敞开灰布破衫，%name%胸口赫然烙着七圈拿艾柱与香火烫出的黑灰圆疤，那是在废砖窑底的无生幽冥教暗坛里领受的印记。每回看见鲜血渗进泥土，他便会低声呢喃『真空家乡无生老母已睁眼』，即便拿马尾线自缝眉骨裂口也挂着诡异微笑。他肯随队拼杀，并非贪图碎银，而是深信唯有白骨堆叠才能渡过这浊恶红尘。" },
	{ ID = "wx_bio_224", Text = "随古墓拜阴教的疯癫长老在坍塌前朝大墓里绝食闭关五个月，%name%听着阴冷滴水声熬干了半身阳气，坚称漆黑棺椁里的锈甲亡将夜夜用古语向他授艺。后来官军拿潮湿谷糠熏烟封墓，他半窒息着从盗洞爬出，双眼已浑浊发白如煮熟鱼目。如今每夜宿营他仍习惯往枕头底下塞一撮坟头土，旁人避之唯恐不及，唯独上了阵却悍不畏死。" },
	{ ID = "wx_bio_225", Text = "曾在黑风血煞宗雾锁深谷的外坛当过五年祭血杂役，日日喝着苦涩铁根药汤，挨着长老的柏木戒尺打熬皮骨，早将皮肉剧痛练成耳边一阵麻木嗡鸣。血月夜里两派长老火并屠坛，%name%揣着半枚沾血兽骨符牌逃下荒山，如今流落佣兵行列，不过是把每次刀剑搏杀都当成向云端邪神献祭鲜血的法场。" },
	{ ID = "wx_bio_226", Text = "官军铁骑剿灭河谷秘密莲坛那夜，三座村寨化作冲天火海，唯独%name%将一卷焦黑残破的布面宝卷死死缝进夹袄里层，趁浓烟逃出生天。在他阴沉冰冷的眼里，这朽烂世道本就是具等待真火焚净的腐尸。行军路上他沉默得像尊泥胎，唯有途经焚毁村庄或乱葬荒冢时，嘴角才会泛起一缕教人脊背发凉的平静笑意。" },
	{ ID = "wx_bio_227", Text = "早年在湘西边地追随过一名赤脚疯道人，深信凡人皮囊不过是关押饿鬼的破竹笼。每逢开战前，%name%总会从怀里摸出三枚泛绿锈的古墓铜钱抛向尘土，若三枚尽数背朝天便会捂嘴怪笑不止。弟兄们都忌讳与他同帐睡觉，因为他半夜常清晰呼喊陌生死者的名姓，可真要迎着枪林硬冲时，全营没谁比他脚步更沉稳。" },
	{ ID = "wx_bio_228", Text = "从前在隐秘山洞暗庙里专司添注尸油长明灯，整日吸入致幻黑麻烟雾以『剥去凡胎怯意』，直到去年冬日兵勇炸塌了洞口。捡回一条命的%name%从此鼻端总萦绕着焦柏与腐脂味，常在昏黄暮色里对着空地低声应答。上了厮杀场他压根不躲寻常劈砍，仿佛急着拿自家残躯去验证皮肉究竟是不是一捧借来的烂泥。" }
];

::Wuxia.Config.BackgroundBios["background.deserter"] <- [
	{ ID = "wx_bio_229", Text = "在雁门九边卫所顶着刀子般的朔风熬了六年，守备老爷把军盐全倒卖给关外私商，发给兵卒的只有生虫霉糠。拖欠饷银满第七个月那个暴雪夜，%name%拿破红胖袄换了牧民一件臭羊皮，扛着官造长枪翻出夯土寨墙一路南逃。战阵刺杀与结阵防骑的底子早已刻进骨头，只是往后只要见了官军旗帜便本能地想先摸清退路。" },
	{ ID = "wx_bio_230", Text = "当年在地方官军长枪阵第三排迎战关外铁骑，号角刚吹响，骑白马的贵戚总兵便掉头先跑，前排弟兄瞬间被马蹄踏成肉泥。眼见大势已去，%name%甩掉沉重枪杆滚进结冰灌溉沟，扯过一头死骡盖在身上装死熬到天黑。提起那次溃逃他至今脸上发烫，却又死鸭子嘴硬地辩称，好汉不拿热乎性命去给草包将官垫背。" },
	{ ID = "wx_bio_231", Text = "站夜岗、啃冻馍、替长官修马厩，%name%本来样样都能忍，直到肥头大耳的百户硬要没收老娘步行八十里送来的半只风干羊肉。血气上涌的他抄起伙房大铁勺砸塌了百户下巴，赶在执法队敲锣拿人前抓起腰刀钻进芦苇荡。虽然如今落草吃佣兵饭，可擦拭兵刃、叠放衣甲依旧留着军营里挨板子抽出来的死板规矩。" },
	{ ID = "wx_bio_232", Text = "原在地方神机火器营里负责扛火药桶、填黑硝，日子过得战战兢兢，直到秋操时一门偷工减料的铜炮当场炸膛，把身旁三名同乡崩得连块整骨头都没剩。耳鸣了整整半年的%name%当夜便卷铺盖逃离大营，发誓往后只握看得见刃口的冷兵器，绝不再碰冒烟硫磺管，只是每逢电闪雷鸣仍会下意识抱头往马车底下钻。" },
	{ ID = "wx_bio_233", Text = "腿肚上还沾着稻田里的黑泥，%name%便被地方节度使的抓丁队拿麻绳套脖子拽进了军营，顶着藤条抽打苦练了四十天刺枪齐步。队伍头一回宿在茂密竹林边时，他趁夜解掉磨脚草鞋，像泥鳅般溜过打盹哨兵的眼皮，一路往反方向狂奔了五十里。尝过官军大营的苦楚后他算明白过来：既然横竖得拿命换饭，不如自己挑个肯现结银子的东家。" },
	{ ID = "wx_bio_234", Text = "发大水那年奉命提枪守着渡口木栅，上峰死令不许放一名灾区流民过河，违者斩立决。见一名怀抱病婴的妇人哭着磕破额头，心软的%name%咬牙抬起拦马杠放过去二十来口人，结果当场被眼尖的伍长告发。面临五十军棍加绞刑架，他趁押解途中背捆腰刀跳进浑浊大江凫水逃命，如今流落江湖，胆气虽不算最壮却极讲义气。" },
	{ ID = "wx_bio_235", Text = "操练枪法从不偷懒、靴带也系得比谁都齐整，偏偏%name%戒不掉熄灯后躲在茅厕沟边摇骰子的臭毛病。某个倒霉透顶的半夜，他输红眼竟把身上那领官发旧铁叶甲押上了台面，结果一把输给军需官手下的老千亲兵。眼见天亮点卯便要吃鞭子下大牢，他硬着头皮钻进夜香车底混出营门，从此靠这身军旅武艺浪迹四方。" },
	{ ID = "wx_bio_236", Text = "在南方府兵大营兼着识字造册与执戟站岗，%name%不小心翻出陈年花名册，发现领饷的八十名『在役精锐』其实早在上夏瘴疫里埋进了乱葬坡。不过随口向同乡嘟囔了两句，次日夜里便在酒馆暗巷遭两名蒙面人抹脖灭口。拼死捅伤一人脱身后，他连夜翻过三座山头远遁江湖，深知有时候官府的刀比绿林贼还黑。" }
];

::Wuxia.Config.BackgroundBios["background.disowned_noble"] <- [
	{ ID = "wx_bio_237", Text = "从前穿着一尘不染的月白绸衫，号称清风剑派外门世家最俊俏的公子，偏生%name%在青楼争风吃醋时喝大了酒，抬手一剑挑断了知府内侄的脚筋。老爹为保住全族田产功名，当着列祖牌位亲手折断他的佩剑，提笔将他从族谱上墨笔勾销。如今绸衫早已磨成补丁短打，可只要青钢剑入手，那截手腕仍快得让人心惊。" },
	{ ID = "wx_bio_238", Text = "仗着祖母溺爱，%name%竟偷偷挪用宗族三百两祭田租银，全砸进了扬州画舫与斗蟋蟀场里，笃定老太太还会替他兜底。不料这回族长铁了心，关了他十天黑柴房，扒光玉带扳指，在飘雪的清晨直接将他踹出朱漆大门。怀里只剩一把少时练手的长剑和半肚子不甘，饿极了方知高门体面在冷风里连半个炊饼都换不来。" },
	{ ID = "wx_bio_239", Text = "生于河北神枪崔家旧部繁衍出的武勋大族，%name%自小既临颜柳大字，也在演武厅练得一身端正枪剑底子。族老们为了巴结京中权阉换取盐引，竟打算逼他入赘一名骄横丑女，他怒火攻心，当场掀翻定亲酒席、拔剑割断锦袍广袖扬长而去。如今蹲在营盘边啃着冷硬杂粮饼，他反倒笑称这粗茶淡饭咽下去舒坦得多。" },
	{ ID = "wx_bio_240", Text = "姑苏诗礼名门一心指望%name%考取举人光耀门楣，他却偏偏拿祖父珍藏的宋版诗集去黑市换残缺剑谱，夜夜翻墙与码头拳师、盗墓浪子吃酒谈兵。直到叔父在祖宗祠堂里撞见他正拿短剑演练暗杀步法，震怒之下烧了他的铺盖，命家丁乱棍打出铜钉大门。提起那段陈年旧事他只耸肩一笑，说祠堂香灰熏得人喘不过气，还是泥路痛快。" },
	{ ID = "wx_bio_241", Text = "念在同胞手足情分，%name%当年替暗中勾结黑风血煞宗走私铁料的长兄扛下四十记荆条家法，脊背被打得皮开肉绽。谁料伤还未好，那衣冠楚楚的长兄竟伪造书信，反咬一口将所有勾结邪派的罪名全推到他头上以换取族老宽宥。只穿单衣滴着血被撵出家门那晚，他便明白正统剑招只能防贼，防不住自家人背后的冷刀。" },
	{ ID = "wx_bio_242", Text = "在淮阳武门宗族比试里惨败给死对头家的小辈，丢尽老父颜面而被逐出家门后，%name%落魄得曾连啃三天观音土与榆树皮。即便穷到靴底开口笑，他依旧死活不肯典当剑鞘上那两枚氧化发黑的祖传银箍，最后总算咬牙咽下傲气，替镖车刷锅喂马才混进这支刀客队伍，一心盼着有朝一日凭满身战功教老宅的人高攀不起。" }
];

::Wuxia.Config.BackgroundBios["background.executioner"] <- [
	{ ID = "wx_bio_243", Text = "在北地府城菜市口执掌九环鬼头刀十一载，%name%手起刀落从不拖泥带水，只要死囚亲属肯塞两贯『顺刀银』，便能保准一刀顺着颈骨缝劈开、绝不让亡魂多抽搐半下。斩满第九十九颗人头那秋，他死活不肯再接差事——行里老话讲，满百便要背冤鬼回家。将染血红布头巾掷进大河后，他提刀入了江湖，换个地方赚干净卖命钱。" },
	{ ID = "wx_bio_244", Text = "常年抡动四十斤重斩首大刀，%name%生生练出两条粗过常人小腿的铁臂，每逢秋决前必灌半斤烈酒稳住心跳。那年知府为凑政绩拿私盐冤案顶缸，跪上锯末席的竟是他儿时一同摸鱼长大的发小。监斩官刚丢下红签，他反手拿厚重刀背狠狠拍碎了监刑衙役的肋骨，趁火铳兵手忙脚乱点药绳的空档，夺路狂奔逃出城门。" },
	{ ID = "wx_bio_245", Text = "昔日在刑场当差时，%name%最懂得拿热腾腾的白面馒头蘸死囚脖颈喷出的温血，高价卖给痨病鬼换酒喝，见惯人头滚落早没了半点忌讳。直到某回斩杀一名南疆五毒奇门妖人，刀锋将落未落之际，那疯子仰面朝他眼里啐了口腥臭黑痰并厉声咒骂。此后夜夜梦见毒蜈蚣钻眼，他索性辞了阴森刑差，盼着借沙场阳刚煞气压住那股邪祟。" },
	{ ID = "wx_bio_246", Text = "十一年的法场生涯把%name%锤炼得冷峻沉稳：他太熟悉刀刃切进颈椎的阻力、知道如何将全身腰胯劲力从脚跟灌进劈斩里，更能一眼看穿跪地求饶之徒眼底藏着几分凶意。前年饥民暴乱烧毁了府衙大牢，新任知县干脆安排自家表亲顶了他的缺。他默不作声地用油布裹紧厚背大刀走出衙门，世道既乱，这门斩首手艺在哪都能卖个好价钱。" },
	{ ID = "wx_bio_247", Text = "城里百姓迎面撞见%name%都要吐口唾沫绕着走，连酒铺掌柜都专门留一只豁口粗碗给他单盛酒，生怕沾了刑场晦气。却极少有人知道，每逢秋决散场后的黄昏，这个面相凶恶的刽子手都会悄悄花掉半数赏钱，在十字荒路口替无主孤魂烧几刀黄草纸。受够了街坊看瘟神般的眼神，他干脆投奔刀口舔血的弟兄，至少这里人人敬重干净利落的一刀。" },
	{ ID = "wx_bio_248", Text = "原是边镇军法处的行刑刀手，专负责斩杀偷马贼与溃兵，一身猛力练得炉火纯青。有回军牢暴动，一名身高八尺的凶悍重犯挥舞精铁手铐直扑监斩参将，%name%跨步迎上，一记沉腰力劈竟将铁链、腕骨与半边锁骨齐刷刷一刀斩断。谁知那胆小参将非但不奖赏，反倒忌惮他太过凶残寻由革职，他啐了一口，拎刀另寻赏识真本事的去处。" }
];

::Wuxia.Config.BackgroundBios["background.flagellant"] <- [
	{ ID = "wx_bio_249", Text = "早年跟着恶匪血洗过一座渡口小村，只为抢六袋发潮小米，后来高烧三日耳边尽是焦尸诵经之声，惊醒后%name%撕碎了皮甲剃光须发。整整三个寒暑，他光着上身踏雪行脚，沿途拿带倒刺的野荆条狠狠抽打肩背赎罪，硬生生把满身血痂熬成赛过熟牛皮的厚茧。如今投身血战，只想知道老天爷究竟还愿不愿意收走他这副贱皮囊。" },
	{ ID = "wx_bio_250", Text = "因早年手上人命太重，少室禅院山门武僧死活不肯收%name%为徒，这疯汉便硬是在寺院外山柏树林里蹲了整整两冬。天不亮便拿胫骨猛撞花岗石碑，拿鹅卵石一遍遍捶打胸膛，血水混着雪渣冻成红冰也不停歇。有位路过老禅师叹其痴狂，随手丢给他半本大路行气桩诀，从此他最爱在阵前迎着重锤狞笑，露出一口缺了三颗的烂牙。" },
	{ ID = "wx_bio_251", Text = "腰间与双腕常年缠着十二斤生锈井绳铁链，走起路来哗啦作响，%name%逢人便说唯有这股冰冷沉铁才能镇住当年蝗灾饿死他三个儿女的凶煞。赤脚踩过碎石官道，脚底厚茧裂口里时常渗出血丝，他却连眉头都不皱一下。随这支武人队伍四处征伐，在他眼里不过是以妖兽恶贼的刀枪当磨石，替自家苦修添几道更深的印记。" },
	{ ID = "wx_bio_252", Text = "亲眼瞧见县里古刹方丈在禅房啃烧鹅喝陈酿，任由院墙外几十名饥民活活饿死，%name%一把火烧了僧衣愤而离寺。他深信安逸享乐只会烂透骨髓，此后专挑将熄未熄的木炭堆赤脚走桩，冬雨夜靠着乱葬岗石碑闭目吐纳，愣是把一身外门抗打功夫炼得近乎麻木。寻常流矢划破皮肉、木棒震裂肋骨，于他而言不过像蚊虫叮了铁钟一口。" },
	{ ID = "wx_bio_253", Text = "那年误闯湘西瘴泽一座闹邪的荒祠，为抵御那股教人昏睡送命的阴雾，%name%狠心咬穿自己半截舌尖借剧痛提神，赤手空拳砸碎了三具扑来的干瘪行尸才拼死脱身。至今他说话仍带着含混大舌头，每日五更起床必先拿粗麻绳猛抽双腿直至皮肉发紫，坚称唯有让滚烫血气在经脉里沸腾，方能撞破世间一切妖邪瘴魅。" },
	{ ID = "wx_bio_254", Text = "拄着破竹杖沿五个州府赤足化缘，恶犬咬腿不躲、门房抡棍赶人亦不还手，%name%靠着这股近乎疯魔的死硬劲儿练就了一身挨打不倒的横练功底。直到某夜投宿荒山黑店，撞见掌柜正要把迷晕的借宿小童拖进灶房，他生受六记菜刀深砍面不改色，铁臂一拧折断黑心掌柜腰椎。既破了戒律，干脆跟着佣兵仗拳行恶道，也算另类修行。" }
];

::Wuxia.Config.BackgroundBios["background.gambler"] <- [
	{ ID = "wx_bio_255", Text = "曾在洛阳夜市赌档里风光了整整三年，%name%指缝间藏匿灌铅象牙骰子的手速快过油灯火苗晃动。坏就坏在一回太贪心，竟摸到淮阳金刀门护院坐镇的私局里出千，叫眼毒的看场头目一柄水果短刀直接钉穿掌边，削去半截左手小指充作学费。疼出一身冷汗逃出城后，他索性把出千的滑溜指法全挪到了藏匕拆招上。" },
	{ ID = "wx_bio_256", Text = "掌心同时暗扣三张骨牌、袖筒藏锋而不露半点鼓胀、十步内屈指弹出磨薄铜钱削熄烛芯，这些鬼把戏%name%信手拈来。从前专在运河盐商的大船上设牌九局宰肥羊，不料两名输光家产的盐枭暗雇水鬼将他装进麻袋沉江。危急关头他靠袖底暗藏的剃刀划破麻布游出生天，从此悟出真刀真枪搏命虽凶险，至少比沉在江底喂鱼敞亮。" },
	{ ID = "wx_bio_257", Text = "开封地下赌坊的账本上记着他三十八两印子钱，面馆寡妇追着他要十二两赊账酒肉钱，城西一名卫所把总更是恨不得剥了他的皮——全因%name%半夜赌赢了人家的青骢坐骑，结果天没亮又在另一张桌子上输了个精光。这只眉眼滴溜乱转的笑面狐狸爽快按了入队手印，图的就是讨债恶汉们绝不敢追进山匪扎堆的荒岭里来。" },
	{ ID = "wx_bio_258", Text = "其实那回%name%根本没动手脚，只是双贼眼太尖，一眼瞧出钱塘怒潮帮地下宝局铜盖底下拴着根极细的马尾暗线，偏生喝了二两黄汤管不住嘴，当着四十名怒火中烧的码头苦力面一把扯断了机关。当夜暴怒的人群砸烧了半条街，帮里直接开出五十两花红买他项上人头。如今紧跟着刀斧成群的队伍讨生活，手里仍闲不住地摩挲着两颗磨圆骨骰。" },
	{ ID = "wx_bio_259", Text = "这辈子没正经磕头拜过半个武师，%name%那手刁钻快剑竟是某夜三更在边镇黑烟客栈里拿两副破牌赢来的——对手是个输得痛哭流涕的落魄剑客，实在拿不出银子，只好把油渍麻花的入门剑谱与防身短刃全押在了赌桌上。躲避捕快藏在草料棚里的半年他照猫画虎练了个七七八八，倒发现瞧出敌手肩头虚招，跟看穿赌徒偷鸡唬人竟是一模一样的门道。" },
	{ ID = "wx_bio_260", Text = "二十出头混迹巴蜀木帮与盐夫聚堆的斗鸡巷，%name%专靠喂养铁距公鸡与暗控盘口发财，长年盯着两条鸡爪交错搏杀，练就了一双能瞬间捕捉重心偏移与胆怯破绽的毒辣贼眼。后来因暗给对手战鸡喂巴豆败露，被暴跳如雷的木帮把头放恶犬满街追咬。他纵身翻过六尺土墙顺走把短刃逃出川界，干脆拿自家脖子当筹码来战阵上赌一把大的。" },
	{ ID = "wx_bio_261", Text = "走遍江淮三府，老赌鬼们谁不知道%name%最拿手的便是装醉耍赖：酒汤洒满前襟、舌头打结连路都走不稳，可就在对手哈哈大笑伸手搀扶的刹那，要么荷包早已易主，要么腰眼已抵上一截寒光闪闪的短刺。自从赢走知府小舅子三百两银票被全城茶楼赌坊画影禁入后，他干脆背起行囊闯荡绿林，把每场伏击都当成一张待掀翻的烂赌桌。" },
	{ ID = "wx_bio_262", Text = "每回拔刃交手前，%name%总要往腮帮子里含一枚穿红绳的万历旧铜钱沾沾喜气，逢人便赌咒发誓，只要攒够一百两战利赏银便立刻洗手回乡买六亩水田安度余生。营里大伙都清楚，真叫他揣上那一百两，他转头就能拿六亩水田押枯松枝头哪只老鸹先起飞——可谁也不得不承认，刀剑交错的生死瞬息间，这小子灵活得就像条滑不留手的泥鳅。" }
];
