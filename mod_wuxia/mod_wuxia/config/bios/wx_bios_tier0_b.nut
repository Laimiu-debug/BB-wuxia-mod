// 500 Independent Dark-Wuxia Character Biographies - Part 2/5 (Tier 0B: 75 bios, wx_bio_086..wx_bio_160)

if (!("BackgroundBios" in ::Wuxia.Config))
	::Wuxia.Config.BackgroundBios <- {};

::Wuxia.Config.BackgroundBios["background.miner"] <- [
	{
		ID = "wx_bio_086",
		Text = "太行深井塌方那年，三个工友连惨叫都没传出来就被碎石捂死了，唯独%name%攥着半截断镐，在渗水的窄缝里硬刨了五天五夜，顺着老鼠洞爬见了天日。从此他黑夜里听不得水滴声，反倒不怵刀剑叮当。照%name%的话讲，井下闷死连口棺材都省了，地面上挨一刀，好歹还能睁着眼看清是谁要了自己的命。"
	},
	{
		ID = "wx_bio_087",
		Text = "顺着一条细银脉往斜下掘到三十丈深，一镐头砸裂了青砖墓顶，白惨惨的阴风裹着铜甲锈气呼呼往外倒灌。矿监怕走漏风声招来官府和湘西赶尸客，干脆下令封死坑口把整班矿工活埋。%name%趁乱撬开矿车铁链逃进荒岭，包袱里只剩半块带着绿锈的前朝古墓铜牌，每到阴雨天摸着仍冰手。"
	},
	{
		ID = "wx_bio_088",
		Text = "「井下不喊真名，笼鸟一歪立马往回爬。」靠这两句老把头传下的保命口诀，%name%在宣府煤窑里熬走了七任窑主，腰间至今挂着一只熏黑的空竹笼。上月老坑冒出呛人硫磺烟，监工还挥着牛皮鞭逼人下井挖煤，%name%反手一镐背砸碎了监工膝盖。既已断了煤窑饭碗，他便提着铁镐来吃这口更痛快的刀口饭。"
	},
	{
		ID = "wx_bio_089",
		Text = "太行十八寨一股流匪血洗冶铁矿场那夜，跪地磕头的账房先生照样挨了一记开山斧。缩在黑矿渣堆里的%name%没求饶，抄起炉边烧红的铁钎捅穿了一名喽啰小腹，摸走对方腰袋里两块碎银趁火光钻进了林子。如今%name%常咧着焦黑牙口冷笑：刨铁石一天挣十二文，刨人骨头反倒划算些。"
	},
	{
		ID = "wx_bio_090",
		Text = "巴蜀自流井深处的苦卤能把生铁泡得酥烂，却没把%name%这身皮肉泡化，反倒腌出一层比老牛革还硬的盐霜厚茧。川江袍哥盐帮与官盐司火并那晚，绞盘断绳、井架塌成一片火海，他摸着黑顺着竹筒爬出井口。自那以后，%name%见着窄巷地洞就犯恶心，发誓往后再不替哪个东家往地底下钻。"
	},
	{
		ID = "wx_bio_091",
		Text = "岭南废铜坑尽头结着厚如棉絮的白丝，新来的工头不信邪，非说里头藏着紫铜矿脉。一锄头劈下去，拳头大的鬼面赤蛛像黑雨般从洞顶坠落，%name%拎起桐油矿灯照着蛛网猛砸过去，顶着满背火泡连滚带爬冲出了坑口。如今回想起来仍后脊发凉，所以%name%每逢宿营，总要先把铺盖底下的石缝翻检三遍。"
	},
	{
		ID = "wx_bio_092",
		Text = "淮北官窑常年替地方藩镇铸造刀枪，%name%在炉前抡了九年十斤重的大锤，两条膀子粗得像截老槐木。监军盘库时查出少了三斤精铁，要把整班炉工押去前线充军当炮灰，%name%连夜灌下半碗生桐油吐得七荤八素，被当作染了时疫的死尸丢进乱葬岗才捡回一命。如今胃口虽落了病根，挥起家伙却半点不含糊。"
	},
	{
		ID = "wx_bio_093",
		Text = "辰州朱砂矿里的赤红石粉把半个村子的壮丁都咳垮了肺，唯独%name%凭着一副厚实胸膛扛了下来，只在手背与指甲缝里留下洗不净的暗红斑印。矿主欠了半年工钱连夜卷款逃往沙州，%name%砸开库房连块铜钱都没见着，只扛走两把精钢尖镐。既然欠债的早溜没影了，他决定跟着江湖队伍赚些现成的血汗银。"
	}
];

::Wuxia.Config.BackgroundBios["background.minstrel"] <- [
	{
		ID = "wx_bio_094",
		Text = "醒木一拍，茶馆里满座屏息——直到%name%说得嘴顺，把黑风血煞宗二当家早年被人退婚的糗事添油加醋编进了《太行群雄传》。当晚二楼雅座飞出三柄冷刀，掀翻了半张八仙桌，%name%踩着酒坛从后窗滚进臭水沟才保住脖子。打那以后他算是看透了：单凭一张巧嘴混江湖，不如躲在真刀真枪的营盘里稳妥。"
	},
	{
		ID = "wx_bio_095",
		Text = "凭着三寸不烂之舌与半册虫蛀的《武林旧闻》，%name%在江南水乡茶肆里专讲姑苏慕氏剑庄的秘辛，每逢招式紧要处便抱拳讨赏。可惜上月茶棚角落偏巧坐着位真慕氏外门弟子，冷笑着问他『剑谱第三页写的是什么』。%name%支吾半晌没答上来，挨了一顿结实刀鞘后，只好拍拍长衫灰尘改行吃这碗行伍饭。"
	},
	{
		ID = "wx_bio_096",
		Text = "昔年跟着走乡串村的三弦瞎子学唱《湘西赶尸录》，%name%记性极佳，哪路邪宗忌讳公鸡血、太华肥遗现世前河水会发烫，他张口便来。有回在荒村祠堂唱到三更灯火骤绿，窗纸外竟真飘来一股焦臭瘴气。师父吓得折断琴颈回乡种地，%name%倒觉得世道既已如此荒唐，不如提着兵刃亲眼瞧瞧真妖物长啥样。"
	},
	{
		ID = "wx_bio_097",
		Text = "原本在草台戏班里专演市井泼皮与贪官师爷，嗓门亮得能压过三面大铜锣。藩镇兵祸一把火烧光了戏楼，班主卷着绣袍行头逃之夭夭，%name%脸上白粉还没擦净就被乱兵赶出了城门。他虽不通高深拳脚，却极擅在酒桌上套人话、拿酸词挤兑敌手，常说战场上砍不倒的铁汉，有时两句戳心窝的浑话就能让他露破绽。"
	},
	{
		ID = "wx_bio_098",
		Text = "评书讲到高潮处总爱吹捧大侠散尽千金，轮到%name%自己，却把祖传檀木醒木与折扇全押在了地下骰宝台上。债主没剁他手指，只笑吟吟让他去威远总镖局门口打听货期和暗桩。%name%嗅出里头藏着劫镖杀头的腥味，连夜脱下长衫换了身粗布短打，一头扎进你的营盘躲风头，嘴上还直夸贵队看着正气凛然。"
	},
	{
		ID = "wx_bio_099",
		Text = "新任知府严查江湖野史，把茶坊里讲前朝古墓与藩镇秘闻的摊子砸了个干净，独独拿不着%name%的罪证——他从不带底本，三百回段子全装在脑仁里。可没了茶客打赏的铜板，满肚子奇闻终究填不饱肠胃。%name%按着咕咕乱叫的肚皮盘算半宿，决定跟着刀客们闯一遭，既挣饱饭，也顺手攒点真正能卖钱的新段子。"
	}
];

::Wuxia.Config.BackgroundBios["background.peddler"] <- [
	{
		ID = "wx_bio_100",
		Text = "摇了十二年拨浪鼓，%name%闭着眼都能分辨哪家媳妇舍得买胭脂、哪道山坳藏着剪径的绿林汉。去岁秋雨夜在太行山口撞见一伙持刀喽啰，他二话不说把自己埋进翻倒的针线筐里装死，任凭匪徒顺走半袋干姜和三匹土布。事后掐指一算，本钱赔了个底朝天，既然做买卖攒不住钱，不如干脆拿这条命入股讨饭吃。"
	},
	{
		ID = "wx_bio_101",
		Text = "挑担走乡时除了针头线脑，%name%总在木箱夹层藏几包自配的「跌打活血散」——其实八成是炒焦麦麸掺桂皮。偏巧有回卖给了杏林济世堂一位落难药童的亲戚，当场被人识破砸断扁担，还在十里八乡贴了告示断他销路。生计彻底泡汤后，%name%搓着手嘿嘿直笑：卖假药总怕挨揍，不如真刀真枪挣得踏实。"
	},
	{
		ID = "wx_bio_102",
		Text = "曾跟在沙州驼铃商帮的驼队尾巴后头做些卖盐换水的小本生意，挣的都是骆驼蹄缝里漏下来的零碎铜钱。一场遮天蔽日的黑风沙卷过戈壁，大商队摇着铜铃头也不回，只把%name%和一头折了腿的瘦驴丢在荒滩。他宰驴充饥熬回关内，从此对谁都满脸赔笑，心里却打着一把极精的算盘，绝不肯吃半文暗亏。"
	},
	{
		ID = "wx_bio_103",
		Text = "贪图南疆十倍差价，%name%悄悄背着两篓生石灰和硫磺钻进瘴气林，指望找苗寨换些毒虫干与解毒草。谁料撞见五毒奇门的人在林间试药，青烟漫起处飞鸟成片坠地，他捂着浸尿湿布连滚带爬逃出三十里，草鞋底都蚀烂了。货没倒成，%name%倒练出双见势不妙跑得比山兔还快的腿脚，连闻着腥风都比常人早半刻。"
	},
	{
		ID = "wx_bio_104",
		Text = "寒冬挑着精盐与铁针翻越关外雪坡，%name%原指望找长白采参客帮换几根老参须回乡养老。夜宿破驿时，两头眼冒绿光的阴山天狗苍狼撞破朽木门，他抓起一包细盐劈头撒进头狼眼里，挥着火把侥幸熬到天亮。如今%name%左肩留着四道狼爪疤，喝酒上头时总爱撸起袖子吹嘘，说自己也是跟山海凶兽过过招的人。"
	},
	{
		ID = "wx_bio_105",
		Text = "十里一卡、五里一税，藩镇新设的厘金局连针头糖块都要抽走四成铜板。那天税吏伸手去抢%name%留给病母的一小罐麦芽糖，向来低头赔笑的%name%头一回黑了脸，抄起枣木扁担把抽税木案掀了个底朝天。官差满城画影图形，他索性把拨浪鼓丢进护城河，背着空货架混迹江湖，发誓往后银子只进自己腰包。"
	},
	{
		ID = "wx_bio_106",
		Text = "旁人走村卖货，%name%专爱拿两撮盐巴换荒宅老屋里的铜器旧物，指望哪天捡漏卖给城里古董铺。上个月从一座死绝户的土窑收了面背刻兽纹的绿锈铜镜，揣进怀里连做七夜血梦，浑身冷汗不止。他把铜镜砸碎丢进枯井，大病一场后觉得沾了邪祟，非要跟着杀气重的刀客队伍才压得住惊，连工钱都肯少要两文。"
	},
	{
		ID = "wx_bio_107",
		Text = "论起听银成色、掂铜钱轻重，十个典当行掌柜也未必胜过%name%这双摸惯碎银的手。他在淮阳城外跑了八年乡集，脚底磨出铜钱厚的硬茧，辛辛苦苦攒下的家底却在一场乱兵过境里被抢了个精光。想通了『手里没铁，攒再多银子都是替别人存着』这个理，%name%背起干粮袋便来投军，只求按月发饷绝不克扣。"
	}
];

::Wuxia.Config.BackgroundBios["background.pimp"] <- [
	{
		ID = "wx_bio_108",
		Text = "烟花暗巷里的脂粉味腌了%name%整整十年，哪家盐商爱听小曲、哪位千总欠着赌坊印子钱，他比州府户房还门儿清。偏生上月牵线搭桥走了眼，错把藩镇幕僚的外室引荐给了淮阳金刀门的阔少，两家在画舫上拔刀见血，反倒把%name%当祸根满城追拿。他脱下油腻缎袍换上粗麻短打，嘴里至今念叨这趟买卖亏大了。"
	},
	{
		ID = "wx_bio_109",
		Text = "城隍庙后头的黑市鬼摊全靠%name%这张巧嘴穿针引线，大到失窃的残页孤本，小到偷来的官驿健马，经他手都能喊出三成溢价。坏就坏在贪心不足，他把一张前朝古墓地形图同时卖给了两伙盗墓贼，害得双方在墓道里火并死伤大半。幸存的头目悬赏十两买他左耳，%name%只好一头扎进你的刀枪阵里躲避风头。"
	},
	{
		ID = "wx_bio_110",
		Text = "自诩阅人无数、一眼看穿皮囊的%name%，去岁秋夜在城外野渡替豪客物色歌伎，撞见个撑油纸伞的白衣女子，眉眼勾得人骨头都酥了。他殷勤凑上去搭话，借着灯笼火光却瞧见对方裙摆下拖着几缕雪白狐尾。连滚带爬逃回城后，%name%高烧三日戒了青丘妖魅般险恶的风月场，发誓往后只跟粗糙汉子打交道。"
	},
	{
		ID = "wx_bio_111",
		Text = "在地下牌九档口替庄家招揽肥羊，%name%全凭一副『哥俩好』的热络劲儿，把多少乡绅少爷劝得典田卖屋。后来酒后失言，把庄家往铜骰里灌水银的把戏漏给了一名醉酒军汉，当场引来一顿乱刀砍砸。他掀翻条凳挡了两刀，从后院狗洞狼狈钻出，身上只剩三钱碎银和满脑子不值钱的市井暗规。"
	},
	{
		ID = "wx_bio_112",
		Text = "往常都是%name%叼着黄铜旱烟袋，翘着二郎腿给商号评点哪个趟子手实诚、哪个打手虚张声势，稳稳吃那份抽头。谁料世道兵荒马乱，商号倒闭大半，昔日求他牵线的绿林恶汉反倒堵上门来翻旧账。没了中间差价可赚，%name%把烟杆往靴筒一插，干脆亲自来领份军饷——好歹他最懂怎么跟亡命徒称兄道弟。"
	}
];

::Wuxia.Config.BackgroundBios["background.ratcatcher"] <- [
	{
		ID = "wx_bio_113",
		Text = "州府粮仓底下的暗渠常年不见天日，里头窜着肥猫般大的灰毛硕鼠，寻常猎犬见了都要夹尾退避。%name%提着熏艾烟筒和三股小铁叉，一钻就是七年，手疾眼快得能在油灯一晃的工夫钉穿鼠颈。后来仓官贪墨霉粮放火平账，一把火烧净了他的营生，%name%掂掂铁叉嘀咕：戳耗子和戳山匪，手腕发力倒差不离。"
	},
	{
		ID = "wx_bio_114",
		Text = "江南大宅阴沟里不知何时爬进了巴掌宽的赤足蜈蚣，接连毒死三名家丁。%name%领了二两定金钻进暗渠，顺着腥气摸到尽头，竟撞见五毒奇门暗桩偷养毒虫的密封陶瓮。他不敢声张，拿浸过雄黄酒的捕鼠麻网兜头罩死几条毒物，拿完赏银连夜卷铺盖离城，生怕哪天被毒派高手顺着脚印摸上门来。"
	},
	{
		ID = "wx_bio_115",
		Text = "别人都嫌义庄阴冷晦气，%name%却最爱接义庄的捕鼠活——那儿啃惯腐肉的肥鼠不怕人，赏钱足足翻倍。直到某个梅雨夜，他循着窸窣声撬开角落一口薄皮棺材，里头坐起来的却不是鼠群，而是一具指甲乌黑、眼眶发青的湘西尸傀。%name%拿铁钩卡住尸傀下巴顶出三步才夺门逃命，从此再也不肯钻半步黑地窖。"
	},
	{
		ID = "wx_bio_116",
		Text = "烧酒作坊雇%name%清剿糟房里的偷酒鼠，却没料到他比耗子还嘴馋，每逮十只大鼠，总要拿空心芦管从封泥陈坛里偷抿两大口。有回灌多了烈酒，昏头昏脑把巡夜的肥管事错认成了成精老鼠王，抄起铁鼠夹照着人家小腿咔嚓就是一下。赔不起药钱，%name%只好连夜逃出州界，来你的队伍里混口安稳酒喝。"
	},
	{
		ID = "wx_bio_117",
		Text = "隔着十步远就能闻见%name%身上那股酸腥的陈年阴沟味，连酒馆伙计收他铜板都要捏着鼻子。可论起听声辨位与钻窄缝的耐性，十条细犬也比不上他——他在潮湿石缝里跟狡猾的独眼老鼠斗了半辈子，懂得怎样憋住呼吸一动不动蹲满半个时辰。如今荒年粮仓空荡，无鼠可捕的他，只得改行帮活人抓仇家挣赏钱。"
	},
	{
		ID = "wx_bio_118",
		Text = "城外臭水河与荒窑沟里捉毒鼠、刮蟾酥，是连天下丐帮底层小乞儿都嫌脏的贱活，%name%却靠这手艺硬是养活了瘸腿老爹五年。老爹入土那天，他把熏烟袋与竹笼一把火烧在坟前，拍拍布满细密鼠咬伤疤的手背站起身来。跟地沟里的畜生打交道够久了，往后不管能活几天，%name%总要挺直脊梁在亮堂地界讨生活。"
	}
];

::Wuxia.Config.BackgroundBios["background.refugee"] <- [
	{
		ID = "wx_bio_119",
		Text = "藩镇节度使的催粮兵过境那夜，全村谷仓烧成了白地，%name%背着那口救命黑铁锅一路向南逃了四百里。沿途啃过榆树皮、嚼过观音土，饿极了连路边死马的蹄筋都抢着吞。如今只要营地里顿顿有稀粥咸菜，哪怕前面横着刀山火海，%name%也不带皱半下眉头——饿死比砍死慢多了，也憋屈多了。"
	},
	{
		ID = "wx_bio_120",
		Text = "关中连旱三年，水井干裂得能塞进拳头，乡老跪在龟裂河床上磕破额头，说山中出了太华肥遗毒蛟吸干了水脉。%name%不信求神能求来米汤，眼睁睁看着邻居一家老小倒毙在破庙门槛外，他默默拔起门栓混进了南下流民潮。一路熬到今日，他脸上早已没了惊慌，只剩一双盯着干粮袋发亮的枯瘦眼睛。"
	},
	{
		ID = "wx_bio_121",
		Text = "守着三亩薄田和两间泥瓦房，%name%前半辈子最大的盼头不过是秋收后多酿一坛浑酒。谁知黑风血煞宗一股劫匪下山抢粮，半炷香工夫便把村口老柳树挂满了人头。躲在猪圈粪坑里憋着恶臭熬过一夜后，%name%摸起半截锈镰刀跟上了过路商旅，嘴里念叨的不再是庄稼收成，而是怎样才能熬过今冬。"
	},
	{
		ID = "wx_bio_122",
		Text = "逃荒路上在山野破庙躲暴雨，十几个饥民挤在泥塑神像底下瑟瑟发抖。半夜庙门被一头羊身虎齿的北山狍鸮撞碎，凄厉哭嚎回荡梁间，%name%趁乱翻出破窗滚下泥坡才捡回一条命。自那以后他夜里从不肯闭紧双眼，旁人笑他神神叨叨，他只哑着嗓子说：见过啃活人的凶兽，反倒不怎么怕拎刀的活人了。"
	},
	{
		ID = "wx_bio_123",
		Text = "城隍庙外施粥棚大锅刚揭盖，饿红了眼的流民便如潮水般涌上前，体弱的当场被踩折肋骨。%name%为了护住手里那半碗照得见人影的米汤，拿碎瓦片划开了两个地痞的脸，从此在流民堆里闯出几分狠名。天下丐帮管事瞧中他肯拼命，想收他入帮行乞，%name%啐了一口：要饭还得看人脸色，不如提铁家伙自己挣。"
	},
	{
		ID = "wx_bio_124",
		Text = "梅雨连下四十日，江淮大堤决口把半个县淹成浊浪滔天的泽国。%name%扒着一块榆木门板在黄水里漂了三天两夜，眼睁睁看着肿胀牛尸与抓不住稻草的乡邻沉进漩涡。被人从苇荡捞上岸时，他浑身泡得惨白，手指却死死攥着一把生锈柴刀。既然老天爷收不走这条贱命，%name%干脆拿它来换几顿热饭。"
	},
	{
		ID = "wx_bio_125",
		Text = "灾荒年景里，官道旁有穿玄袍的管事支起浓香肉粥大锅，专挑筋骨还算结实的流民招去当『庄丁』。%name%喝完两碗才发觉不对，同车青壮个个昏沉不醒，赶车汉子腰间隐约露出邪派炼体药人宗的血铜牌。趁马车过桥颠簸，他用鞋底藏的碎瓷片割断麻绳跳入冰河，发誓这辈子再也不吃白送的肉粥。"
	},
	{
		ID = "wx_bio_126",
		Text = "祖屋早被乱兵拆了烤火，亲眷也在逃难途中散落得音讯全无，%name%怀里唯一留着的，是从焦黑瓦砾堆里刨出来的半截灶神木牌。他既不图扬名立万，也不懂门派恩怨，只在夜深营静时把领到的铜钱一枚枚擦亮包进布角。问他拼命图什么，%name%搓搓冻裂手指憨笑：攒够十两银子，回老家重新垒个灶台。"
	}
];

::Wuxia.Config.BackgroundBios["background.servant"] <- [
	{
		ID = "wx_bio_127",
		Text = "在高门深宅里端茶倒水十二年，%name%练就了一身低眉顺眼、走路无声的本事，连老爷咳嗽两声要喝哪壶茶都能猜个八九不离十。不料两房嫡庶争家产请来了黑道杀手，一夜之间朱漆大门成了屠场。%name%没去抢金银细软，只顺了灶房两挂腊肉和一把切菜钢刀翻墙逃生，如今虽仍习惯弯腰应诺，挥刀却毫不含糊。"
	},
	{
		ID = "wx_bio_128",
		Text = "门阀大院的规矩森严得很，少爷醉酒砸了官窑瓷瓶、调戏了护院女眷，最后趴在长凳上挨四十记竹板的永远是贴身小厮%name%。屁股上的血痂还没褪尽，少爷又打算把他推去顶一桩命案的死罪。%name%连夜收拾包袱，顺手把少爷卧房里那张绣金锦垫扯下来裹了双脚，头也不回地翻出了高墙。"
	},
	{
		ID = "wx_bio_129",
		Text = "曾在姑苏某座临水剑庄的外院照料马厩与行囊，%name%虽没资格偷窥内院高深剑诀，却最懂得给刀剑擦油防锈、捆扎干粮和拿捏各路武林客的脾气。后来剑庄卷入藩镇旧怨，遣散了大半杂役。走出角门那天，%name%掂量着手里二两遣散银，寻思伺候一个东家也是伺候，伺候一队刀客还能分点战利品。"
	},
	{
		ID = "wx_bio_130",
		Text = "大宅家仆活命的头一条是管住眼睛与舌头，偏偏%name%生了双太尖的耳朵，巡夜打更时撞听见大管家与绿林山寨暗通款曲，打算里应外合劫掠东家库银。他既不愿替抠门东家白白挡刀，也不敢留下来等灭口，揣上攒了五年的月钱趁黑翻墙溜走。如今他睡得极浅，营外稍有风吹草动便能摸起兵刃坐起身。"
	},
	{
		ID = "wx_bio_131",
		Text = "昔年在盐商巨富府里专管衣箱茶具，如今沦落到宿破庙啃冷饼，%name%身上仍改不掉那股细致讲究劲儿。每次拔刀迎敌前，他总要把破皮甲擦得油亮，连喝浑水也要拿布角滤一遍。同袍笑他穷讲究，可真到了清点箭矢、分装伤药和缝补绷带时，谁也离不了%name%那双利索手脚，连干粮经他打理都能多撑两天。"
	},
	{
		ID = "wx_bio_132",
		Text = "老东家晚年怕死，听信游方妖道蛊惑，在后花园地窖里摆七星续命灯，派%name%每夜三更去添香油。直到中元节子夜，灯焰陡然转青，偏院刚入殓的老管家尸首竟顶开棺盖直挺挺站了起来，把半座宅院闹得鸡飞狗跳。%name%拎着铜油壶一路狂奔十里地，发誓往后宁可在亮处拼刀子，也不进达官贵人的深宅半步。"
	}
];

::Wuxia.Config.BackgroundBios["background.shepherd"] <- [
	{
		ID = "wx_bio_133",
		Text = "一根麻绳兜住鹅卵石，在头顶呼呼抡圆了甩出去，四十步外能把荒坡野狼的眉骨砸塌——这手投石绝活护了%name%家三十只羯羊整整六年。去秋太行十八寨下来打草谷，贼人提刀赶光了羊群，顺手烧了羊圈。手里空剩一条浸满汗碱的飞石索，%name%索性揣进怀里来吃军粮，说砸野狼与砸匪徒无非石子大小不同。"
	},
	{
		ID = "wx_bio_134",
		Text = "阴山脚下的寒风一变腥味，羊群便会挤成一团发抖，%name%凭这兆头躲过三回阴山天狗苍狼群的夜袭。他惯常披着件膻味冲天的老羊皮袄，哪怕三伏天也舍不得脱，说那厚毛既挡夜露也能卸半寸冷刃。如今草场被关外战帮霸了去，没羊可放的%name%握着空缰绳走进酒肆，目光沉静得像头盯紧了草丛的老牧犬。"
	},
	{
		ID = "wx_bio_135",
		Text = "在乱石坡寻走丢羔羊时，%name%撞见两具身穿不同门派劲装的尸首，手里还攥着半卷染血绢帛。他老实巴交想刨个土坑掩埋图安生，偏巧被追杀赶来的淮阳金刀门弟子撞个正着，一口咬定他私藏秘籍。百口莫辩之下，%name%甩出一记飞石打熄对方火把才钻林脱身，从此有家难回，只得随队伍漂泊四方。"
	},
	{
		ID = "wx_bio_136",
		Text = "西山草甸起白雾那天，山坳里传来阵阵凄厉婴儿啼哭，头羊吓得发疯般朝悬崖乱窜。%name%听老辈人说过西山蛊雕善以婴啼诱人，咬牙横起牧杖拦阻，终究只抢回一只瘸腿羊羔，其余二十多头全跌进了雾谷。东家逼他签身契赔羊，他连夜把烤羊腿塞进布囊翻山逃走，骂道山中恶禽害人，财主比畜生更毒。"
	},
	{
		ID = "wx_bio_137",
		Text = "漫山遍野只有风声、铜铃和咩咩羊叫，%name%一个人在荒岭上放了十年羊，话越来越少，眼力却毒辣得惊人。隔着两里草坡，他便能数清山脊上晃动的是几个人影、背着长枪还是硬弓。县里强征军粮牵光了羊群，他不哭不闹，只把枣木牧杖削尖包上铁皮，跟着大伙儿走南闯北，闲歇时偶尔还对着驮马低声哼牧歌。"
	},
	{
		ID = "wx_bio_138",
		Text = "威远总镖局一支迷途镖队曾在暴雪夜困在青石岭，全靠%name%领着他们顺羊肠窄径绕过雪崩才保住镖银。总镖头临别塞给他二两雪花银，比他替财主放三年羊攒的工钱还多。掂量着那两块沉甸甸的银锭，%name%头一回觉得天天盯着羊屁股太亏，卷起毛毡便顺着官道上的马蹄印下了山。"
	},
	{
		ID = "wx_bio_139",
		Text = "岭南荒坡水草肥美，唯独隔三岔五会从谷底飘起一股甜腥雾气。有回羊群误闯瘴坳啃了带露野草，半个时辰不到便口吐白沫倒毙殆尽，连两条看羊黑犬也翻了白眼，只有蹲在上风口嚼生蒜的%name%侥幸无恙。背着一屁股赔羊债，他干脆往腰带系了串大蒜头来吃江湖月饷，坚信只要鼻子够灵，阎王爷也难近身。"
	},
	{
		ID = "wx_bio_140",
		Text = "在荒坡上剪羊毛、剥羊皮、熬羊油治冻疮，%name%那双满是厚茧的手看着粗笨，给羔羊接生和给老羊放血却稳得不带眨眼。兵燹烧毁草场后，他背着半张硝好的黑羊皮一路乞讨到州城。论冲锋陷阵或许算不得虎将，可若谁的皮甲干裂发硬、脚底磨烂流血，%name%掏出半罐羊油三两下就能拾掇妥当。"
	}
];

::Wuxia.Config.BackgroundBios["background.slave"] <- [
	{
		ID = "wx_bio_141",
		Text = "三两给老父抓药的印子钱，不到两年在典当行账册上利滚利变成三十两，%name%就这么戴着铁脚镣被押进采石场抵债。三年里脊背被浸油藤条抽得像块老松皮，双臂却抡大锤抡出了石块般的硬筋。趁山匪夜袭石场乱作一团，他用铁锤砸断脚环，揣着半块冷窝头跑进夜色——既然这条命早不属于自己，豁出去拼反倒痛快。"
	},
	{
		ID = "wx_bio_142",
		Text = "沙州盐滩的白碱日头毒得能晒脱一层皮，赤脚泡进卤水里钻心地疼。%name%替兄长顶罪沦为官府苦役，原定做满五年放籍，可监役每到年底总要编造『损毁铁锹』『偷懒误工』再加两年刑期。他终于看透那纸官契就是张擦屁股纸，趁运盐驼队受惊踏乱木栏，光脚狂奔出三十里，连手腕上的旧铁箍都没顾上卸。"
	},
	{
		ID = "wx_bio_143",
		Text = "一场输光薄产的押宝，让%name%按下指印签了十年死契，被债主卖去给藩镇修筑边境土堡。寒冬腊月光着膀子扛石夯，稍微慢一步便是一记马鞭抽在肋下。挨了四年毒打，他别的没学会，倒练出挨闷棍不哼声、缩肩护住心口的贱骨头本事。如今契主在兵乱里丢了脑袋，%name%摸摸空荡荡的脖颈，头一回觉得活得像个人。"
	},
	{
		ID = "wx_bio_144",
		Text = "债主收不回银子，干脆把%name%连同七八个欠债汉子打包卖给了深山里一伙身穿暗红袍子的邪派人马。那些疯子整日逼苦役抬着散发尸臭的药桶进出地窟，动辄拿落单者去试炼体毒药。%name%靠装哑巴装痴呆熬了半年，终于在运炭车翻下山坡时滚进灌木逃生，只要离那些炼药疯子越远越好，让他提刀卖命也心甘情愿。"
	},
	{
		ID = "wx_bio_145",
		Text = "不过是替邻村孤寡出头砸了乡绅的私粮车，便被衙门判了个充役三年，偏偏%name%家里凑不出孝敬狱卒的『脱锁银』，硬生生在阴冷潮湿的州府大牢多熬了二十个月。最后还是新知县嫌囚粮费钱，把半死不活的他一脚踹出了牢门。蹲在日头底下缓了整整半日，%name%吐出口血沫：往后再不进官门，谁挡活路就跟谁拼命。"
	},
	{
		ID = "wx_bio_146",
		Text = "官府强派河工疏浚淤河，欠税的百姓统统串成绳当苦力使唤，%name%的左肩就是拉百石官船时被麻绳生生勒裂的。没钱找杏林济世堂的大夫正骨，骨头歪着长好，抬手虽略显别扭，腰腿却绷得像一张拉满的牛角弓。大堤决口那夜押夫衙役自顾逃命，%name%捞起根裹铁竹篙，打定主意从此只替给现银的人卖力。"
	}
];

::Wuxia.Config.BackgroundBios["background.tailor"] <- [
	{
		ID = "wx_bio_147",
		Text = "城里别家成衣铺只做嫁衣寿袍，唯独%name%肯接江湖武人的私活——往直裰夹层里缝细铁片、用桐油麻线加固袖口和护心棉。做久了，连各路刀剑惯劈哪个肩缝、冷箭爱钻哪处腋窝都门儿清。可惜县城遭了兵祸，布庄被乱兵抢成空架子，%name%把那把磨得雪亮的铁剪别进腰带，打算去实战里瞧瞧自己手艺到底耐不耐砍。"
	},
	{
		ID = "wx_bio_148",
		Text = "尺子量差了半寸，针脚走歪了三针——寻常客人顶多骂两句扣工钱，偏偏那天订制披风的是城里脾气最暴的藩镇千总。听说千总当场拔刀劈碎了裁衣案，还放话要扒了裁缝皮去补袖口，%name%连烧热的炭熨斗都没顾上倒灰，抓起针囊和两匹素布就翻城逃了。江湖虽险，好歹没人因为袖子窄了两分便要他的脑袋。"
	},
	{
		ID = "wx_bio_149",
		Text = "曾有位满身血痂的山泽猎客，拎着张腥气熏天的苍梧巴蛇青鳞皮闯进小铺，掷下十两银子要%name%裁成护腕与软背心。那蛇皮滑溜坚韧得连钢针都顶弯七根，缝成后拿匕首划上去竟只留一道白印。从此%name%再瞧不上寻常棉布丝绸，听说跟着你这支队伍常能碰见异兽奇革，他背起大剪子便兴冲冲入了伙。"
	},
	{
		ID = "wx_bio_150",
		Text = "旁人都忌讳沾死人晦气，%name%却在城西白事街做了十年寿衣，给淹死的、冻死的、被绿林剁成两截的江湖汉子都量过身、缝过尸。他常眯着眼穿针引线，语气平静得很：活人穿衣图体面，死人穿衣图遮丑，剥开皮囊底下的骨头全一个样。营里要是谁衣甲绽线、皮肉裂口，找%name%拿黑丝线缝上，保准比游医还利索。"
	},
	{
		ID = "wx_bio_151",
		Text = "江南丝坊里能用一根细针在黑缎上绣出金鳞云纹的巧手不多，%name%便是其中一个，只是双目被长年油灯熬得略带微盲，光线稍暗便爱眯眼。丝坊遭贼火烧毁后，他靠替走镖趟子手在腰带鞋底缝暗袋勉强糊口。如今投身行伍，刀法虽生疏，可谁的干粮袋、箭壶皮带出了毛病，经他三针两线一紧，跑百里都不带松的。"
	},
	{
		ID = "wx_bio_152",
		Text = "替一位路过小镇的剑客女侠量肩宽时，%name%本分地拉着布尺低头报数，偏被门外吃醋的师兄撞见，二话不说赏了他两记窝心脚，连铺子招牌都劈成了柴火。躺在冷板凳上揉着青紫肋骨，%name%越想越憋屈：针线再巧，遇上讲拳头不讲理的江湖人照样白挨打。他卖掉织机买了把粗铁刀，决定自己也学着讲讲『拳头理』。"
	}
];

::Wuxia.Config.BackgroundBios["background.vagabond"] <- [
	{
		ID = "wx_bio_153",
		Text = "从关外雪原到岭南湿林，%name%走坏了不下百双草鞋，南北州府的土话都能蹦出两句，官道捷径与荒庙枯井烂熟于心。唯有旁人问起他老家在何处、早年姓甚名谁时，他总咧嘴灌一口劣酒，把话头扯到明早的风向上。在%name%眼里，故乡早就烂在兵荒马乱里了，脚底下能迈出去的泥路，才是眼下唯一实在的东西。"
	},
	{
		ID = "wx_bio_154",
		Text = "四海为家的人最懂得怎么在三更冷雨夜挑一间不漏风的土地庙。上月%name%缩在供桌底下烤地瓜，两伙提刀的江湖客竟冲进庙里杀得血肉横飞，活着的追着残血的冲进雨幕，供案前孤零零落下一只沾血钱袋与半壶烧酒。他心安理得喝干剩酒，暗忖世道乱成这样，独自乱晃迟早成荒冢孤魂，不如找支队伍搭个伴。"
	},
	{
		ID = "wx_bio_155",
		Text = "别人离了热饭便挪不动步，%name%却能在荒山野岭里刨出葛根、烤熟田鼠，连辨认哪丛毒蘑菇吃不得全凭舌尖试出来的老经验。有回在云梦大泽迷路七日，硬是靠嚼芦苇根和生吞溪虾活生生走了出来。这副铁打肠胃与耐寒筋骨，搁在风餐露宿的行军路上，比十个娇生惯养的武馆少爷还要顶用。"
	},
	{
		ID = "wx_bio_156",
		Text = "十年漂泊让%name%养成个古怪习惯——每逢路过荒驿或义庄石碑，总先摸摸墙角有没有前人留下的黑炭暗记。那是散客们互相提防的土规矩：画叉是有剪径山匪，画圈是有湘西尸气，画歪葫芦说明水井有毒。如今墙上的叉和圈越画越多，单人独行眼看走不通了，%name%收起炭条，径直来投你的军帐。"
	},
	{
		ID = "wx_bio_157",
		Text = "去年冬月还在沙州驿路替驼商烤馕看火，今年开春便蹲在洞庭湖岸帮渔船补网，%name%这辈子从没在同一个屋檐下睡满过半年。并非犯了什么滔天血案，只是骨子里坐不住，听见远处驼铃响或马蹄乱，脚板就发痒。至于提刀卖命？在他看来跟扛包拉纤一样，都是换口干粮的营生，无非价钱给得更干脆。"
	},
	{
		ID = "wx_bio_158",
		Text = "昔日孤身横穿小次山老林，%name%夜里攀在老松杈上打盹，亲眼瞧见月色下一头丈许高的白毛朱厌巨猿拖着半截黑熊走过山涧，喉间滚出的低吼震得松针簌簌直落。那晚过后，他彻底熄了独自游山玩水的闲心。这年头荒郊野岭早不是活人该待的地界，还是跟着十来个带刀汉子围着篝火睡觉，心里才稍微踏实几分。"
	},
	{
		ID = "wx_bio_159",
		Text = "%name%那只黑得发亮的破包袱里，既没藏秘籍也没藏金条，只裹着半块打火石、一把豁口铜勺和三根腌咸萝卜。靠着这三样家当与一张不讨人嫌的笑脸，他厚着脸皮蹭过镖局篝火、借过行脚僧禅房，甚至在乱兵营外捡过半锅焦糊麦粥。眼看寒风刺骨，他掂掂干瘪钱袋，笑嘻嘻拍胸脯说愿拿力气换顿热汤。"
	},
	{
		ID = "wx_bio_160",
		Text = "贴身揣着一枚褪色银锁片，%name%自三年前兵灾散家起，便顺着官道一站站打听失散幼妹的下落。从淮阳茶铺问到沙州集市，草鞋磨穿七八层，换来的却总是一声叹息。盘缠早花了个精光，可他仍不肯回头，只求跟着你的队伍往九州各城走下去——哪怕前路刀光血影，只要多走过一座城，便多一分撞见熟面孔的指望。"
	}
];
