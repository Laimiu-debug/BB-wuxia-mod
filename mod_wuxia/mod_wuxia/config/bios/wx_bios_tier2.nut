// 500 Independent Dark-Wuxia Character Biographies - Part 5/5 (Tier 2: 128 bios, wx_bio_373..wx_bio_500)

if (!("BackgroundBios" in ::Wuxia.Config))
	::Wuxia.Config.BackgroundBios <- {};

// 54. 游历世家公子 (8 bios: wx_bio_373 .. wx_bio_380)
::Wuxia.Config.BackgroundBios["background.adventurous_noble"] <- [
	{ ID = "wx_bio_373", Text = "姑苏慕氏剑庄连喝茶都要按嫡庶分三等茶盏，%name%受够了祠堂里那股陈腐檀香，趁夜摸走库房一柄缺口古剑和半卷《孤锋诀》翻墙出逃。谁料江湖并非诗酒风流，头一夜宿在太湖渡口便被洞庭水寇劫光盘缠。好在家传剑术真有几分火候，%name%反手挑翻三名水匪夺船逃生；如今行军吃糙米仍嫌硌牙，可真动起刀兵来，手腕比老刀客还要稳上三分。" },
	{ ID = "wx_bio_374", Text = "河北神枪崔家演武厅摆着三十六杆红缨枪，%name%偏偏挑了最沉的那根白蜡杆。族中叔伯原打算花钱替他在京城捐个锦衣卫闲职，他却在定亲家宴上把媒婆灌得酩酊大醉，连夜策马闯向雁门关外。一场大雪把宝马冻死在乱石滩，%name%扛着断缨银枪步行入关，锦袍早已磨出毛边，衣袖里淡淡的龙涎香混着干涸血腥，闻着既荒唐又扎眼。" },
	{ ID = "wx_bio_375", Text = "两淮盐引堆出来的富贵门庭，花重金请淮阳金刀门与清风剑派宿老轮番喂招，外人总背地嘲笑%name%是银子砌成的花架子。直到扬州画舫雨夜生变，他三剑削断黑风血煞宗分舵主的刀背、护着满船客商脱险，嘲笑声才彻底哑了火。如今流落江湖并非家道中落，纯粹是老爹逼着他学盘盐账，%name%宁可睡在烂泥里拼命，也听不得算盘珠子噼啪作响。" },
	{ ID = "wx_bio_376", Text = "洛阳老宅的朱漆大门早已剥落见木，祠堂里的前朝功臣牌位却比米缸里的陈米还多。%name%当掉祖传最后一枚御赐玉带钩，置办了一口好剑与几瓶上乘金疮药，立志要重振门楣。可沿着中原官道走了三千里，他才彻悟这乱世根本没人认得曾祖父的铁券丹书；唯有剑锋见血、死人倒地之时，四下里那些糙汉才肯老老实实拱手唤他一声公子。" },
	{ ID = "wx_bio_377", Text = "别家少爷出游带着锦衣书童和雕花马车，武夷碧水轩少主%name%肩上却只扛着一篓陈年岩茶和一柄窄刃轻剑。族长原本打发他北上开封打通茶路，他却在半道迷上了同镖师拆招练卸力步法，一路从闽北打到中原。如今整篓贡茶早换成了跌打药膏与烧刀子，%name%托威远总镖局寄回家去的家书只有八个字：『茶已销尽，人尚喘气。』" },
	{ ID = "wx_bio_378", Text = "关中大族送嫡长子去西岳紫霞观养病，病根没全拔净，倒叫%name%练出一身绵长紫气与夺命快剑。初下山游历时，他撞见州府衙役当街鞭打交不起丁税的逃难流民，一时火起，一剑削飞知县大轿顶上的锡葫芦。家里为保宗族只好对外发丧称其暴毙，暗地却每月托商帮悄悄捎来十两纹银，外加母亲亲手纳的两双千层底布鞋。" },
	{ ID = "wx_bio_379", Text = "身上流着半个蜀中唐家堡血脉，%name%却最厌恶暗房里那股腐臭刺鼻的药渣味，偷偷跟着游方道士学了一套青城幽谷观快剑，趁端阳夜色翻墙奔了江湖。嘴上常嫌破庙潮湿、同袍吃相粗鄙，每逢投宿野店却总是头一个掏银针替大伙试毒验水；哪怕战袍早已沾满泥浆血渍，%name%每次擦拭剑锋所用的帕子，仍旧非上好蜀锦不可。" },
	{ ID = "wx_bio_380", Text = "若非那晚在金陵秦淮酒楼多贪了两杯竹叶青，%name%此刻大约还在与名门闺秀吟诗赏剑。偏生他醉后闯错了雅间，与藩镇世子的护卫起了口角，三招两式震落对方四颗门牙。老太爷震怒之下提着枣木家法追出三条长街，%name%索性怀揣半册家传心法跳上北行货船；挨过几顿冷窝头后，那身世家骄气没了影，反倒磨出一股子破釜沉舟的狠劲。" }
];

// 55. 隐杀楼刺客 (8 bios: wx_bio_381 .. wx_bio_388)
::Wuxia.Config.BackgroundBios["background.assassin"] <- [
	{ ID = "wx_bio_381", Text = "幽冥隐杀楼的铁律是收了红帖必见死尸，可那晚潜入太和山下小院，%name%掀开棉被才瞧见目标竟是个替贪官顶缸的盲眼老仆。他默默收匕跃出院墙，转头摸进雇主宅邸割了门房半只耳朵，留下退还的银票扬长而去。自此名号挂上了楼里的清理红单，%name%只得藏身于刀口舔血的江湖行伍之间，借众人兵刃挡一挡背后的索命冷风。" },
	{ ID = "wx_bio_382", Text = "三寸鱼肠短匕刺透琵琶骨而不见外血，曾是会稽鱼肠剑庐最得意的死士手笔。那年%name%奉命暗杀一位内衬玄铁软甲的知府，偏偏一击未穿要害；按庐中旧规，失手者须自断左手无名指以儆效尤。他趁着半夜灯黑，反手剁下看守师兄的手指装盒交差，连夜远遁中原。如今%name%从不坐背对门槛的板凳，连睡熟后的呼吸都轻得像黑猫踩过青瓦。" },
	{ ID = "wx_bio_383", Text = "一柄分水短刺原是从青城幽谷观外门学来的，后来%name%被幽冥隐杀楼重金收买去做『清账人』，专替豪商暗中了结那些赖账不还的冤家。苦干七年好不容易攒够买田养老的银票，他兴冲冲去钱庄兑现，却发现那家钱庄刚倒闭——东家正是他上个月亲手抹了脖子的倒霉鬼。如今身无长物，他看谁都像欠了自己一笔陈年血债。" },
	{ ID = "wx_bio_384", Text = "江湖茶客总以为刺客成天蹲在冷风房梁上啃干饼，%name%却曾在某位藩镇节度使后厨安安稳稳切了两年萝卜丝。直到重阳夜宴端着参汤迈入帅帐，他借放碗的工夫一匕穿喉，踩着屋脊借夜雨遁走。如今转行吃明面上的刀头饭，仍改不了进屋先闻饭菜气味的旧癖，连营地伙夫熬粥多撒了一撮盐，都要被%name%冷冰冰盯上半柱香。" },
	{ ID = "wx_bio_385", Text = "半张脸光滑得长不出一根胡茬，全拜当年潜入神机火器营火药库所赐。那时%name%的短剑已刺透守库千总的心窝，垂死的官将却临终掀翻油灯，滚烫灯油瞬间引燃半屋硝石。他撞穿砖墙滚进水渠侥幸活命，幽冥隐杀楼却嫌这张焦疤脸太过显眼、再难混迹市井易容，只打发三十两遣散银逐他出门，逼得他扛起明刀来挣活命粮饷。" },
	{ ID = "wx_bio_386", Text = "暗杀行当并非只接腌臜买卖，隐杀楼当年也收过少室禅院暗中托付的厚银，遣%name%夜闯黑风血煞宗药炉，连毙三名试药执事。可那些炼体药人临死前喷出的漆黑毒血溅在他右手，蚀烂两根指骨，自此每逢梅雨阴天便钻心奇痒。%name%如今对恩怨情仇毫无兴致，只认白花花的现银，出鞘多少分力气全看银锭成色。" },
	{ ID = "wx_bio_387", Text = "练成幽冥鬼步的同时，也落下听风辨息的古怪病根，哪怕院外枯叶擦过墙角都能把%name%瞬间惊醒。他在大漠鬼市替金主抹过七个黑心掌柜的喉管，从未失手，却藏着个死也不肯承认的弱点——极度怕黑。只要不在潜行刺杀途中，帐篷里非得彻夜点着半截油蜡不可，旁人若多手吹熄灯芯，他袖中寒芒下一瞬便会贴上对方咽喉。" },
	{ ID = "wx_bio_388", Text = "开封城南那家不起眼的老茶栈后院里，十二名幽冥隐杀楼死士昔日皆听%name%号令。谁料一单刺杀巡按御史的红货被人出卖，番子与官军半夜合围封死所有暗巷。他踩着同伙尚温的尸首撞破后窗逃生，左肩胛至今卡着半截没敢深挖的精铁弩镞。逃出鬼门关后，%name%再不信什么兄弟盟誓，世上唯一靠得住的，只有咬得出牙印的足色官银。" }
];

// 56. 西域影刺客 (6 bios: wx_bio_389 .. wx_bio_394)
::Wuxia.Config.BackgroundBios["background.assassin_southern"] <- [
	{ ID = "wx_bio_389", Text = "曾披灰袍伏于玉门关外荒丘，听命于西域圣火明尊教暗堂，以弯刺专断商队头领脚筋。某次奉旨刺杀一名私自给流民分水的绿洲老者，%name%伏在枯井旁瞧见老人把最后半瓢浑水递给哭嚎的孩童，终究没能递出那一刀。他一把火烧掉灰袍一路东逃，如今操着生硬拗口的中原官话，唯有弯匕出鞘化作电光时，才像找回了真正的自己。" },
	{ ID = "wx_bio_390", Text = "沙州驼铃商帮昔年暗出高价，请%name%在月黑风高之夜清扫劫道的瀚海马贼。他能在齐膝深的流沙中踏步无声，短刃抹喉快得连拴在木桩旁的骆驼都不会惊醒。可惜狡兔死走狗烹，东家忌惮他知晓太多私盐暗账，竟在羊肉汤里掺了赤蝎毒粉；%name%吐了三天黑血爬出沙坑，连夜回去把商帮账房连人带契烧成了白地。" },
	{ ID = "wx_bio_391", Text = "随西域影堂长老潜入楼兰流沙古墓窃取前朝金符那夜，同行六名顶尖影刺有五个被青铜机括与干枯尸傀撕成碎块。唯独%name%靠一口龟息闭气死贴石壁裂缝，屏息熬过整整两昼夜才爬出死穴。重见天日时两鬓已霜白一片，他从此发誓永不再接古墓探宝的买卖，宁可留在中原官道上与活人真刀真枪见血。" },
	{ ID = "wx_bio_392", Text = "隔着两丈便能闻见%name%身上浓烈的没药与干薄荷气息，那是用来压住袖中西域蛇脂毒腥臭的土法。他曾替丝路城邦权贵暗杀过三名争位的王子，换来的满袋金币却全葬送在胡姬酒肆与骰宝桌上。如今钱袋里只剩两枚磨平花纹的西域银钱，可那对浸过暗香的曲刃短匕，倒被他磨得比当年还要锋利三分。" },
	{ ID = "wx_bio_393", Text = "大漠狂风掠过耳畔总带着呜呜哨音，全因%name%左耳缺了半截耳垂——那是昔年在圣火总坛偷窥失传经卷受的刑刀。他趁着黄沙蔽日之夜割断看守喉管，卷走半袋风干红枣与一双镔铁分水刺逃入河西走廊。中原乡民瞧他深目高鼻总投以忌惮冷眼，%name%懒得辩解半句，只把江湖上每一场血战都当成替自己赎命的债。" },
	{ ID = "wx_bio_394", Text = "听信行商吹嘘中原处处垂柳画桥、银钱遍地，%name%才应重金之聘东来，替一位江南绸缎豪商除掉生意对头。岂料事成那夜东家翻脸不认人，反手报官诬他是西域潜入的细作。他劈翻两名捕快连夜跃出城垛，在梅雨漏风的破城隍庙里咳了半个月血；%name%恨透了江南黏腻的湿气，却也再回不去炽烫无边的大漠。" }
];

// 57. 塞北狂战悍勇 (8 bios: wx_bio_395 .. wx_bio_402)
::Wuxia.Config.BackgroundBios["background.barbarian"] <- [
	{ ID = "wx_bio_395", Text = "胸膛上斜斜犁着三道发紫旧疤，那是黑水冰原的疯熊留下的见面礼，也是%name%当年在黑水战帮盟赢取敬畏的本钱。偏偏冬猎分肉时，他因替孤儿寡母出头，一记铁拳轰断了酋长小舅子的鼻梁，当场被剥去貂皮大氅赶出雪原。%name%赤膊迎着风雪翻越老岭南下，进了关内只觉得中原烧酒淡如马尿，城里人心思绕得比山路还弯。" },
	{ ID = "wx_bio_396", Text = "狼皮护肩缀着七颗风干白牙，每颗都记着关外一场血战。那年白灾冻死漠北苍狼部大半牲口，长老决意南下劫掠雁门关外村寨，%name%因当众劈碎祭旗的木架、拒杀手无寸铁的农妇，被斥作染了南人怯气的叛徒。他单刀斩断营帐缆绳扬长而去；如今虽替中原人卖命，可一遇硬仗依旧双目充血，冲锋起来比饿极的雪狼还疯。" },
	{ ID = "wx_bio_397", Text = "在长白雪林里跟着辽东劈山盟斧手伐过十年合抱红松，后来厌烦盟中堂主学起官府那套请安送礼的虚架子，%name%拎着重斧独自走了。曾在山坳里与窜出兽巢的斑斓猛虎角力半刻，肋骨被拍断三根却硬把那畜生活活扼死。他大笑时震得破庙梁灰簌簌往下掉，可一旦手指搭上冰冷斧柄，整张脸便沉得像三九天的黑水坚冰。" },
	{ ID = "wx_bio_398", Text = "少年时被关外邪部掳去充当祭坛血奴，偏生这副筋骨生得比老牛皮还厚实，挨了三十记铜钉皮鞭竟硬撑着没咽气，反在半夜咬断生牛筋抢刀杀出营门。%name%说起中原官话磕磕绊绊，更听不懂什么仁义道德，脑袋里只装着一条死规矩：谁管他顿顿吃上油汪汪的烤羊腿、递给他最沉的利刃，他就替谁把对面铁甲砸成烂泥。" },
	{ ID = "wx_bio_399", Text = "路过朔方金瓜力士堂时与教头打赌举三百斤铁瓜锤，%name%不仅单臂举过头顶连晃三圈，落锤时还顺手把人家青砖演武台砸塌半边。教头气得跳脚要扣他盘缠，他抓起腰间铜板撒了一院子哈哈大笑而去。此人平生不知惧字怎么写，独独踏进中原茶楼时手足无措——生怕自己一屁股坐碎人家雕花太师椅还得赔银子。" },
	{ ID = "wx_bio_400", Text = "部族遭铁骑夜袭屠灭那晚，大雪没过膝盖，%name%怀里揣着半皮囊烈烧刀子，提着卷刃大刀死死卡在冰坡后头，连劈七名追兵才力竭昏倒，左耳冻落半只却浑然不觉。南下讨生活后，寻常佣兵瞧他满嘴生蒜臭、打架总爱撕破衣衫赤膊硬扛，皆暗地敬而远之；唯有真正踏过死人堆的老首领，才懂这号疯虎在绝境里值多少银子。" },
	{ ID = "wx_bio_401", Text = "北境马帮押运貂皮那趟，半道正撞上黑风血煞宗驱使的炼体药人，寻常刀剑劈在那些怪物身上竟只溅出腥臭黑汁。%name%见状索性甩掉圆盾双手抡斧，硬生生将两具狂暴药人的膝盖骨砸成碎渣。那一战震裂了他虎口老茧，从此每回挥动重兵前，他必先往掌心吐两口唾沫，嘴里用谁也听不懂的塞外土话把对面祖宗骂上一遍。" },
	{ ID = "wx_bio_402", Text = "莫看%name%膀大腰圆、双臂勒满染血牛皮护腕，每回随队进了中原州府，最痴迷的事竟是蹲在戏台最前排听《挑滑车》，听到激昂处猛拍大腿，一巴掌就能把茶棚长凳拍折。他在关外吃够了硌牙的冻马肉与刮脸黄沙，如今拼着命挣足官银，不过盼着老来能盘下一间带热炕头的土房，再不受半点酋长的鸟气。" }
];

// 58. 山泽猎妖客 (8 bios: wx_bio_403 .. wx_bio_410)
::Wuxia.Config.BackgroundBios["background.beast_hunter"] <- [
	{ ID = "wx_bio_403", Text = "左臂自腕至肩留着四道青紫凹痕，那是三年前在雪岭绝涧追猎小次山朱厌幼兽讨来的记号。%name%出身长白采参客帮外围护猎，闭着眼也能凭粪迹湿冷与树皮抓痕断出凶兽去向，腰间常年拴着雄黄布囊与虎筋硬弓。他从不信什么山神降罚的鬼话，只信把异兽胆囊剖出来送进杏林济世堂，能换回多少足色碎银。" },
	{ ID = "wx_bio_404", Text = "整整七昼夜伏在苍梧渊腥臭腐泥里纹丝不动，只为等一头吞象巴蛇蜕皮虚弱的那半个时辰。那一仗虽未能断掉妖蟒性命，%name%仍凭手中分水叉硬生生剜下三尺玄鳞与一囊剧毒涎液，卖出的银钱原够挥霍两年。偏生小腿溅到一星蛇毒溃烂成洞，大半积蓄全贴给了黑心郎中；如今只要风里飘来一丝沼泽腥气，他指节便会咔吧作响。" },
	{ ID = "wx_bio_405", Text = "南疆五毒奇门把深林巨蛛当镇门活宝豢养，%name%偏提着火油竹筒钻进瘴气毒泽盗猎，专挑月圆夜烧网割取毒囊去黑市换酒钱。结果惹恼五毒堂口，被十余名吹箭手沿山岭追杀三百里，险些死在毒箭之下。吃一堑长一智，如今他不再独来独往，宁可入伙与一群狠人抱团走南闯北，既能分利猎妖，夜里也能安心闭眼。" },
	{ ID = "wx_bio_406", Text = "寻常山民听见深林夜半传出婴儿凄啼，多半吓得双膝发软磕头求饶，%name%却会瞬间张开神臂强弩对准漆黑树冠——那是鹿吴山蛊雕诱杀行人的惯伎。他凭冷箭救过两支迷途药商，也剥过九头食人凶禽的带血翎羽。只是在荒山听得妖啼太多，如今回了人烟稠密的镇子，连街边真娃娃哭闹，他手指都会下意识扣紧机括。" },
	{ ID = "wx_bio_407", Text = "年轻时随老猎师深入青丘荒陵追踪白狐异兽，同行的师兄吸入那股甜腻迷魂香雾后，竟面带痴笑拔刀捅穿了自己小腹。%name%狠心咬破舌尖喷出血雾稳住神智，拖着昏死猎犬拼命滚下山坡才捡回半条命。自此他滴酒不沾带桂花香的酿造，遇着姿容妖冶的女子更要绕开三丈，专挑世上最丑陋凶残的山野孽畜下手。" },
	{ ID = "wx_bio_408", Text = "原是淮水渡口摇橹二十年的老艄公，那年秋汛江心无风翻浪，三艘漕船顷刻粉碎，水底探出的金目狂猿一爪扯断半船水手脊骨。%name%抱着半截断桨漂上芦苇滩，此后变卖家产拜入退隐老手门下苦练三年长叉硬功，发誓总要探明淮水无支祁的老巢；他浑身总泛着洗不净的鱼腥与桐油臭，见了深水绝不肯下河沐浴。" },
	{ ID = "wx_bio_409", Text = "旁人进山猎兽带硬弓套索，%name%背上却总斜绑着一柄浸满黑桐油的厚背阔斧。昔年在都广野撞见夜半自行挪根噬人的建木精怪，同行刀剑劈上去反而震断虎口，唯独他挥斧硬破树心、浇油连烧三天三夜才除大患。自那以后每逢荒村夜宿，%name%瞧见庭院里歪脖老槐树总要上去狠踹两脚，生怕半夜树根悄悄爬进被窝。" },
	{ ID = "wx_bio_410", Text = "炼制奇药洗髓丹少不得凶兽心血与百年毒胆，杏林济世堂掌柜动辄悬红三百两，却从不替死在毒谷里的猎手收尸。%name%吃这碗绝命饭整整八年，亲手在乱石堆下埋过四名过命搭档，自己也熬出一身阴雨天钻骨疼的老寒腿。他常叼着旱烟袋冷笑：山里畜生扑上来之前好歹吼一嗓子，比城里笑盈盈压价的药行东家体面多了。" }
];

// 59. 山泽猎妖客·大荒猎手 (6 bios: wx_bio_411 .. wx_bio_416)
::Wuxia.Config.BackgroundBios["background.beast_slayer"] <- [
	{ ID = "wx_bio_411", Text = "茶楼说书人把钩吾山饕餮编得天花乱坠，%name%听见从不插嘴，只默默挽起裤脚露出一截缺肉见骨的青白小腿。五年前他领着七名成名猎手围杀那头羊身虎齿的贪血凶兽，整座山坳被鲜血染红，最终唯独他拖着半杆断矛滚落悬崖生还。此后他走遍南北寻访悍将，只为攒够一支能随他重上钩吾山讨还血债的硬骨头队伍。" },
	{ ID = "wx_bio_412", Text = "古卷言邽山穷奇性好惩善助恶、专噬心志高洁的君子，%name%便反其道而行，满嘴污言秽语、满袋石灰毒蒺藜与生铁捕兽夹，愣是在邽山乱石口把一头裂风穷奇幼兽活活耗竭放血。他将染血兽皮缝成大氅披在肩头，活像一头披皮恶狼；名门子弟唾骂他行径下作毫无侠风，他冷嗤一声：『讲体面的早进畜生肚子里化粪了。』" },
	{ ID = "wx_bio_413", Text = "右眼窝里塞着一团浸油黑布，那是章莪山独足毕方掠阵时甩落的赤翎讹火烫瞎的。%name%怀里常年贴身藏着半册残缺《山海图志》，每踏入一片荒山必先抓把泥土嗅腥味、看鸦雀惊飞的方向。莫瞧他成了独眼龙，百步之外借风势算箭道、辨妖踪，连白马义从营里最傲气的老弓手见了也要抱拳喊一声先生。" },
	{ ID = "wx_bio_414", Text = "传闻招摇山白耳狌狌通晓往事，最擅呼喊猎人乳名乱其神智、趁隙扑杀。%name%上山前干脆把融化的黄蜂蜡灌满双耳，孤身提着六尺玄铁枪闯进老林，硬是顶着妖风把那人面老妖逼进事先挖好的火炭深坑。事后抠挖蜡丸时震伤耳膜，落下个背风听不清细语的毛病；如今同袍凑在一块窃窃私语，他总疑心旁边藏着山魅。" },
	{ ID = "wx_bio_415", Text = "常羊山古战场雾气终年不散，%name%曾与湘西辰州符水门方士搭伙清剿古冢凶煞，亲眼目睹一具无首铁甲战魂挥斧将合抱古松拦腰斩断。自那一役起，他抛弃轻灵快剑改习沉猛重锤与长戟，行囊里总塞满糯米、朱砂和淬火镇尸钉。在他眼里，活人纵然奸诈总归有血有痛，真正要命的是那些不知惧死、不耗内息的大荒孽物。" },
	{ ID = "wx_bio_416", Text = "别人闯荡大荒为的是异兽内丹与千两赏银，%name%却迷上了将斩获凶兽的碎骨钻孔穿绳，密密麻麻系在腰带上。他在杻阳山寒潭边抡着八棱精铁锤连砸三十七记，震得双掌虎口血肉模糊，方才从鸟首玄龟皇背上崩下一块指节大的乌甲。如今走起路来腰间百骨碰撞叮当作响，夜半静谧时听着竟比赶尸铃还要渗人。" }
];

// 60. 还俗护法武僧 (4 bios: wx_bio_417 .. wx_bio_420)
::Wuxia.Config.BackgroundBios["background.converted_crusader"] <- [
	{ ID = "wx_bio_417", Text = "少室禅院山门外那三块裂了缝的青石碑，皆是%name%在戒律院值守十二载留下的铁掌印。那年大旱饿殍遍野，山下县丞不仅囤粮居奇，还纵容衙役打死讨粥孤儿。他趁黑夜闯进县衙废了狗官双腿，天明独自脱下僧袍跪在达摩堂前领完三十戒棍，自请还俗蓄发；临下山时朗声一笑：『佛祖慈悲，洒家手脏，不如入红尘替天行杀。』" },
	{ ID = "wx_bio_418", Text = "当年奉禅院法旨护送经卷途经太行陉道，恰逢黑风血煞宗匪徒屠戮村寨。%name%一双罗汉铁拳连毙七名恶贼、救下一对孤寡母女，却在破庙照料重伤妇人的半月间动了凡心、破了清戒与酒戒。他没瞒着师父半字，亲手交还度牒与熟铁禅杖步入市井；如今头顶九点戒疤犹在，大碗喝酒大块切肉之余，砸碎恶徒颅骨依旧丝毫不手软。" },
	{ ID = "wx_bio_419", Text = "原是蜀中名刹护寺武僧，精熟点穴封脉与金钟硬功，偏偏眼里揉不得沙子。眼见老住持终日巴结藩镇官绅、将善男信女捐的香火钱拿去修造贴金宝塔，%name%怒掀斋堂长桌被逐出山门。下山后他当掉铜钵换了一副精铁指虎，如今打斗前嘴里仍偶尔漏出半声阿弥陀佛，往往佛号刚落，对面恶霸的胸骨已被他震碎。" },
	{ ID = "wx_bio_420", Text = "湘西荒村那夜飘满尸臭，奉命前来超度冤魂的四名武僧正撞上邪道妖人以符水驱策铁甲尸傀。血战过后，三位同门皆惨死尸爪之下，唯有%name%浴血破围逃回禅院。此后半载他夜夜噩梦不绝，终于悟透木鱼经卷根本渡不了这吃人的末世；他扯断檀木佛珠紧缠拳套，宁做红尘屠夫，绝不再当庙堂里闭目端坐的泥塑。" }
];

// 61. 劫余苦行武僧 (4 bios: wx_bio_421 .. wx_bio_424)
::Wuxia.Config.BackgroundBios["background.crucified"] <- [
	{ ID = "wx_bio_421", Text = "双腕与脚踝各嵌着一道深达筋骨的铁钉旧孔。前年孤身夜探黑风血煞宗救人失手，贼酋将%name%活活钉在寨门枯树上暴晒三日三夜，以为他早晒成了干尸。谁知他硬凭一口少室禅宗龟息强续心脉，趁大雨夜内劲暴吐震裂朽木，抢过哨兵钢刀杀出火海；此后他沉默寡言如哑巴，哪怕肩头吃了一记重砍，连眼皮都不会颤动半分。" },
	{ ID = "wx_bio_422", Text = "湘西邪宗曾掳走%name%充当炼尸药引，用烧红铜印在他背脊烙满镇魂邪符，丢进生石灰深坑活埋。他凭一身千锤百炼的横练铜骨生生熬过七日无水无粮，扒开腐土爬出尸坑时浑身褪下一层白皮，吓得守夜妖道当场失禁跌倒。如今%name%常年裹着粗麻破衲遮掩焦烂脊背，平日温和如老农，唯独撞见尸傀邪祟便双目赤红如烧炭。" },
	{ ID = "wx_bio_423", Text = "因无意撞破地方节度使暗通马贼劫掠官粮的脏事，%name%被秘密投入北岳废矿水牢，双肩琵琶骨遭铁钩穿透悬吊整整三年。矿井塌方那夜，他借乱石震裂锈链、捡起半截断矿镐劈死三名狱卒逃出生天，嗓子却已被烟尘与血水灼成破锣。他从不向人讨半分怜悯，只把三年铁牢熬出的怨毒与定力，统统揉进沉如山岳的掌风里。" },
	{ ID = "wx_bio_424", Text = "西域邪徒曾将%name%反绑在荒漠胡杨刑架上，日头最毒时往他耳鼻灌进滚烫沙砾，逼问少室禅院护体真传。他咬碎两颗后槽牙始终没吐露半个字，直到一场黑沙暴刮断木架，才被路过的沙州驼商割绳救下。历劫之后，%name%赤足踏过碎石寒冰亦浑不觉痛，旁人敬他修成金刚不坏，唯独深夜听见他梦里磨牙，方知胸中那团劫火从未熄灭。" }
];

// 62. 少室护法武僧 (6 bios: wx_bio_425 .. wx_bio_430)
::Wuxia.Config.BackgroundBios["background.crusader"] <- [
	{ ID = "wx_bio_425", Text = "奉少室禅院方丈法旨下山巡查中原邪踪，%name%行囊简朴至极，只有一只紫铜水囊与一双浸过药酒的粗麻缠手。他性子方正古板得像山门前的石狮，路上遇不平事必出手管到底，偏生不通市井人情，头一回住客栈就被黑心掌柜诓走十两香油钱。好在真见了兵刃，他那双金刚铁掌拍下去，披甲悍匪也能当场口吐鲜血。" },
	{ ID = "wx_bio_426", Text = "去年护送禅院高僧舍利南下金陵，行至云梦大泽遭黑风血煞宗药人与水寇前后夹击，七名护法同门仅余%name%一人重伤突围，圣物却落入贼手。他面朝中岳发下重誓，一日不夺回舍利便一日不踏回少室山门。如今借江湖行伍之势四处追索邪派踪迹，每夜入睡前必对着残灯抄写半卷金刚经，压一压胸口翻涌的杀念。" },
	{ ID = "wx_bio_427", Text = "少室寺韦陀堂里棍法稳居前五的精锐，一杆熟铁齐眉棍舞开来风声呼啸、水泼不进。世俗总以为出家人吃素气短，%name%偏偏生得铁塔般魁梧，吐纳间气血浑厚如烘炉。只是他戒律守得极死，行军露宿绝不沾半滴荤腥，宁可干嚼冷馍饮冷水，每逢营地架锅炖肉，大伙总觉得他在火堆对面怒目瞪人。" },
	{ ID = "wx_bio_428", Text = "年逾四十仍留在外院四处奔波，专替少室禅院查勘各地义庄古冢的尸变异象。前年曾在洛阳北邙乱葬岗独斗十余具行尸，以一双铁拳连碎五具尸傀天灵盖，回寺后眉心便多出一块洗之不去的青紫煞印。%name%口中常念降魔先降己心，可若撞见掘人祖坟的摸金贼，他照旧一禅杖先敲昏绑树上，再慢条斯理讲佛理。" },
	{ ID = "wx_bio_429", Text = "辽东兵火连天那年，%name%随师叔下山收敛战死边军遗骸，顺手从马贼屠刀下救出数十户边民，被当地百姓私下称作『铁面活佛』。他修的是少室至刚护体硬功，刀劈铁背如击铜钟，却有个古怪执念——每逢战罢清场，他必亲自替每一个死者合上双眼、默诵三声往生咒，哪怕脚下躺的是罪大恶极的悍匪。" },
	{ ID = "wx_bio_430", Text = "年仅二十五便赤手闯过少室铜人巷，%name%双臂筋骨早被百草药汤与硬木桩打熬得泛起古铜幽光。院中长老嫌他锋芒毕露、好勇斗狠太甚，特意罚他下山云游三年『磨一磨浮躁火气』。谁料这和尚一入江湖反倒如鱼得水，逢着成名刀客便合十讨教切磋，硬生生把化缘云游走成了踢馆挑战。" }
];

// 63. 百胜打擂宗师 (8 bios: wx_bio_431 .. wx_bio_438)
::Wuxia.Config.BackgroundBios["background.gladiator"] <- [
	{ ID = "wx_bio_431", Text = "锁骨下方刺着一圈暗青铁链，那是开封地下铁笼擂台给贱籍拳奴烙的印记。%name%靠一副精铁指虎与毫不讲理的贴身摔打连胜三十七场，踩着十余名好手的断骨残肢才凑足赎身纹银。如今虽已换回自由身，可每逢街头敲响铜锣，他浑身筋肉仍会瞬间绷紧，眼珠不由自主地先往对面路人的膝弯和肋下瞄去。" },
	{ ID = "wx_bio_432", Text = "江南盐商听腻了丝竹昆曲，暗地里在扬州画舫夹层摆起生死血擂看活人互搏。%name%曾凭一口短柄鬼头刀连斩七名塞外力士，替东家赢回两万两盐引，换来的犒赏却只有半坛劣酒和两张发霉烙饼。他趁着深夜砸烂木栅栏，顺走东家挂在舱壁的宝刀纵身入江；自此天高海阔，再不替脑满肠肥的阔佬演猴戏。" },
	{ ID = "wx_bio_433", Text = "玉门关外黑市沙坑里滚爬八载，粗沙混着干血几乎长进了%name%脊背的每一条刀口。他既懂瀚海弯刀掠沙斜斩的狠辣，又在死斗中偷学过少室散手的贴靠肘击，一身招式全无章法，却招招奔着废人关节而去。此人天生嗜赌如命，即便行军走在荒郊野岭，也要拉着身旁伙计押两枚铜板赌天黑前会不会下雨。" },
	{ ID = "wx_bio_434", Text = "原本在洛阳城东一家小武馆教富户少爷蹲马步，只因亲兄在赌坊欠下淮阳金刀门五百两印子钱，%name%不得已按了血指印踏进地下黑擂。七个月里打断九条胳膊、废了三名恶棍才撕掉借据，回到家却发现兄长早卷走仅剩的家具逃得无影无踪。如今他待人客客气气，唯独出手时狠戾异常，仿佛要把对手骨头拆成柴火烧。" },
	{ ID = "wx_bio_435", Text = "川江袍哥盐帮每年端阳在铁索浮桥上设血擂争码头抽成，%name%连霸五年魁首，先后把三条外帮的金牌打手全轰进过浑黄江水。后来新任总舵主忌惮他风头压主，暗中收买杂役在他麻布护腕里缝进淬毒细针。%name%戴上瞬间便觉异样，当众扯下护腕甩在舵主脸上，转身大步走出码头再没回头。" },
	{ ID = "wx_bio_436", Text = "拖着一条似残非残的右腿走进铁笼，总能叫地下赌档庄家开出一赔十的冷门赔率；等生铁栅栏『哐当』落锁，%name%的脚踝立刻稳如生根，三招之内便能将满脸轻蔑的壮汉锁喉放倒。他凭这手装瘸诈赌的把戏生生赢垮三家黑擂庄口，如今仇家遍布中原州府，只得混迹江湖刀客之中避风头，顺带赚点踏实银两。" },
	{ ID = "wx_bio_437", Text = "胸膛上留着七个乌黑凹陷的弹坑，那是昔年大闹藩镇世子私设铁笼时，被护院用三眼火铳近距离轰出来的。铅子卡在肋骨缝里竟未透心肺，%name%抹去嘴角血沫，迎着呛鼻硝烟一记抱摔将恶奴砸断脖颈。此后每逢霜降大雪，胸口旧伤便针扎般作痛，可他反而笑得越发张狂，越是十死无生的绝境越爱往前挤。" },
	{ ID = "wx_bio_438", Text = "纵横南北地下擂台九年未尝一败，连钱塘怒潮帮长老都曾捧着千两礼金请他入帮做客卿。%name%却腻透了围栏外那一张张因血腥而扭曲的富贵嘴脸，攥着满手血银买回卖身死契，在城隍庙香炉前一把火烧了个精光。如今虽常捉襟见肘，上阵前仍改不了旧习——非得将草鞋绑带连勒三道、仰天吐出一口浊气才肯拔兵。" }
];

// 64. 独行披甲悍将 (8 bios: wx_bio_439 .. wx_bio_446)
::Wuxia.Config.BackgroundBios["background.hedge_knight"] <- [
	{ ID = "wx_bio_439", Text = "身上那副鱼鳞重甲打满十几块生铁补丁，每一处凹坑都对应着关外一场死战。昔年辽东兵败，主帅连夜弃城逃命，%name%领着三十亲兵死守孤堡三日三夜，撤回关内却被朝廷御史弹劾『擅弃官仓辎重』革去参将官身。他将铜印丢进护城泥河，穿着这身四十斤冷铁独闯江湖，谁出得起足额军饷，他便替谁踏碎敌阵。" },
	{ ID = "wx_bio_440", Text = "本是太行震岳门掌门座下亲传，重锤与铁布衫练得刚猛无匹，却因性情暴烈酷狠惹下大祸——某回下山清剿山匪，他竟连给匪寨送菜的几户庄民一并当贼屠杀，遭掌门削去辈分逐出门墙。%name%冷哼一声披上全套玄铁札甲独行中原，不在乎世人骂他铁魔煞星，只迷恋重甲硬撼、一锤裂甲的痛快声响。" },
	{ ID = "wx_bio_441", Text = "曾为中原某位藩镇节度使征战七载，夺城破寨屡建头功，偏偏主公兵败身亡后，新主忌惮他军中威望，暗下密令『留甲不留人』。那夜骤雨如倾，%name%提着丈二陌刀从亲兵营中一路劈杀至城门，甲叶缝里灌满温热血水竟硬没倒下。自那以后他独来独往，宁可抱着战盔睡在漏风马厩，也绝不让自己离开盔甲三步远。" },
	{ ID = "wx_bio_442", Text = "人连重甲足有三百来斤，跨下寻常川马走不出十里便口吐白沫打颤，%name%干脆弃马步行，肩扛长戟大步踏遍北境雪原。雁门戍边义勇险遭马贼合围那回，他一人一甲硬生生堵住狭窄山口，连斩六名塞北狂徒护住乡民撤离。平日里他从不吹嘘旧功，唯独烈酒下肚三碗后，爱拿铁护腕敲着木桌破口大骂朝廷克扣边饷。" },
	{ ID = "wx_bio_443", Text = "太行十八寨曾联手设伏劫夺两车皇纲药材，威远总镖局精锐伤亡殆尽之际，恰好受雇压阵的%name%身披重铠挥舞开山大斧冲进匪群，活活劈废四名悍匪当家才保住镖车。事后总镖头愿奉副总镖头之位挽留，他却嫌镖局礼数繁杂还得伺候官老爷笑脸，抓走三百两酬金大步离去；他只接最凶的血战，从不替软骨头收拾烂摊子。" },
	{ ID = "wx_bio_444", Text = "先父原是河北边镇游击将军，兵败获罪抄家后，只留下一屁股战死士卒的抚恤旧债与一副半旧明光铠。%name%烧了举业书稿换上父辈遗甲，仗着河北神枪崔家外传的破阵枪艺与天生神力在江湖专接死契。旁人暗笑他穿着官甲干起亡命悍徒的勾当，他擦拭着胸甲裂痕平静回道：『欠死人孤寡的银子，总得拿命去挣干净。』" },
	{ ID = "wx_bio_445", Text = "见他终日全副铁甲、连铁面罩都不肯摘，江湖人皆当%name%是冷血铁魔。无人知晓他满门曾被黑风血煞宗一夜屠尽，胸口当年挨的那记毒掌至今一到寒夜便溃烂流脓，非得在贴身内衬里塞一把枯艾草才压得住腐臭。他言语稀少得像块荒坟石碑，唯独风里飘来黑风血煞宗名号时，铁手套握紧兵刃的咯吱声叫人不寒而栗。" },
	{ ID = "wx_bio_446", Text = "深信世间一切花哨剑招轻功，终归敌不过全副重甲贴身碾压、一力降十会。%name%昔年曾与清风剑派两位成名好手切磋，任凭对方快剑在自己铁肩甲上划出十几道刺眼火星，硬受一剑反手将人连剑带鞘砸飞两丈。他傲气冲天、开口要价高得离谱，可真到了两军绞杀的生死线，有这尊铁塔顶在最前，连最疯的绿林悍匪都要心虚三分。" }
];

// 65. 前朝大内侍卫 (6 bios: wx_bio_447 .. wx_bio_452)
::Wuxia.Config.BackgroundBios["background.kings_guard"] <- [
	{ ID = "wx_bio_447", Text = "乾清宫丹陛之下那抹手按绣春刀的绯红身影，当年连一品阁老经过亦要微微颔首。京城大火冲天那夜，%name%背着中箭昏迷的同僚撞破西华门突围，回望宫墙时只见金黄琉璃瓦片片塌入火海。如今锦袍玉带早换作粗布短打，连马靴都补了两层牛皮，可他每晚擦拭钢刀时那套一丝不苟的大内仪制，这辈子怕是再也改不回来了。" },
	{ ID = "wx_bio_448", Text = "大内御马监演武场里，三等教头%name%本分授艺十载，专教新晋带刀侍卫松涛内息与贴身快剑。后来夜巡冷宫时，他无意撞破掌印太监私通塞外细作、将边关舆图藏于枯井，反被罗织罪名打入诏狱严刑拷打。幸得旧部重金买通狱卒放他出逃，如今拖着满背烙铁刑疤流落江湖，夜宿破庙听见铁链风吹作响，仍会惊出一身冷汗。" },
	{ ID = "wx_bio_449", Text = "皇城倾覆那日奉密旨护送一位幼年宗室南渡，沿途遭追兵与绿林恶贼连番围杀。%name%左肺穿箭仍硬扛着杀出淮河渡口，等从血泊里昏死醒来，荒滩上只剩半块沾血白玉佩与一艘空荡荡的破乌篷船。自此他顺着江淮官道四处受雇卖命，不为图什么高官厚禄，只盼有朝一日能在乱世人海里寻见另一半玉佩的下落。" },
	{ ID = "wx_bio_450", Text = "在紫禁城当了十余年恪尽职守的一等带刀侍卫，眼睁睁看着权贵奸佞把九边士卒的救命粮饷拿去修戏台、养优伶，%name%胸中最后一点忠义彻底凉透。递了三次告老折子皆遭驳回，他干脆在交班雨夜潜入武库卷走半册前朝枪剑秘录，飞身跃出角楼远走高飞；如今最瞧不起满口忠孝的官绅，反倒觉得直来直去的江湖糙汉顺眼。" },
	{ ID = "wx_bio_451", Text = "宫廷规矩森严，当年替皇子贵胄喂招拆式时只许挨打绝不准还手，%name%硬生生熬出一副铁打的抗击筋骨与炉火纯青的卸力护身法。江山易主、禁苑烟消云散后，他揣着两锭御赐金锞子混入市井；头一回真刀真枪与拦路山匪搏命时竟畅快大笑起来——原来不必收着三分力气、放开手脚劈死恶徒，竟如此痛快淋漓。" },
	{ ID = "wx_bio_452", Text = "哪怕囊中羞涩只得蜷在漏雨破庙的稻草堆里过夜，天刚蒙蒙亮，%name%也必先用冷水抹净面颊、将发髻束得纹丝不乱，再把铜带扣拭得雪亮。昔年他在皇城禁苑挡过幽冥隐杀楼刺客两记绝命短匕，咽喉旁那道三寸淡疤便是明证；如今虽为江湖佣客，但既收了雇主的卖命银，便真把东家当御驾一般寸步不离死守到底。" }
];

// 66. 斩蛟豪侠 (6 bios: wx_bio_453 .. wx_bio_458)
::Wuxia.Config.BackgroundBios["background.lindwurm_slayer"] <- [
	{ ID = "wx_bio_453", Text = "三年前太华山麓赤地千里、井水枯干，乡民皆传绝涧潜伏着六足肥遗毒蛟。州府贴榜悬红千两却无人敢揭，%name%领着六名过命弟兄提白蜡长枪杀入灼人赤瘴，折损五条好汉，唯有他借乱石躲过蚀甲毒雾，一枪挑穿妖蛟软喉。至今每逢伏天酷暑，他胸口那片被旱火瘴烤烂的紫红旧疤仍会火辣辣地发烫。" },
	{ ID = "wx_bio_454", Text = "岭南荒江曾有巨型毒蛟兴浪噬船，%name%浑身涂满湿黄泥与雄黄末，单人独枪在芦苇毒泽缠斗两个时辰，硬拿半截断枪钉死蛟首，自己左膝却遭毒血溅穿腐去大半。乡绅敲锣打鼓抬来『斩蛟豪侠』金字木匾，许诺的五百两赏银却被县衙层层克扣，到手只剩三十两碎银；他当街劈碎木匾生火烤干衣裳，提枪北上另觅活路。" },
	{ ID = "wx_bio_455", Text = "南岭深潭屠戮恶蛟那回误吸一口毒热煞气，五脏六腑险些化作脓水，幸得%name%急智剖开尚温的蛟腹生吞半颗蛟胆，以毒攻毒方从鬼门关挣回一命。自那之后他周身汗气透着股古怪铁腥，寻常毒蛇毒虫见他皆退避三舍，连南疆五毒奇门的迷烟都奈何不得；只是每到雷雨交加之夜骨缝奇痒难熬，非灌二斤烈烧酒不可。" },
	{ ID = "wx_bio_456", Text = "江湖豪客皆爱显摆传世宝剑，%name%却将一截漆黑柔韧的毒蛟背筋紧紧缠满枪杆，既防打滑，亦是当年独斗岭南毒蛟的铁证。那一战他连震断三杆精铁枪，全凭威远枪法一招回马透心才绝处逢生；如今城中茶馆说书先生把他的事迹吹得如天神下凡，却不知这位斩蛟名侠连补双防潮皮靴的铜钱都得精打细算。" },
	{ ID = "wx_bio_457", Text = "洞庭北岸亲手斩杀噬舟毒蛟后，姑苏与淮阳数家豪门争相遣人送帖，愿奉厚禄请%name%入府充当供奉门客。他去赴过两场洗尘宴，瞧见那帮锦衣公子哥一边摸着剥下来的蛟皮大呼小叫、一边对下人颐指气使，心里直犯恶心，半夜扛起长枪翻墙而去；在他看来，跟满嘴油滑的贵人周旋，远不如回臭泥潭再捅一头蛟龙省心。" },
	{ ID = "wx_bio_458", Text = "外人总以为屠蛟靠的是不要命的蛮勇，唯有%name%把活命诀窍刻进了骨头里：长兵卡距、避开毒血泼溅、先断尾势再攻七寸。当年亲眼目睹身旁一位身披重甲的豪杰被蛟血活活融穿胸铠，惨叫着化作枯骨，从此他行事谨慎得近乎刻薄；平日里为几钱药费能跟药铺伙计磨半天嘴皮，真遇上山岳般的凶兽，全场最稳的手必属于他。" }
];

// 67. 大漠弯刀客 (8 bios: wx_bio_459 .. wx_bio_466)
::Wuxia.Config.BackgroundBios["background.nomad"] <- [
	{ ID = "wx_bio_459", Text = "腰畔那口弯刀弯如初三新月，刀背刻满七道深浅不一的记杀缺口。%name%昔年在瀚海弯刀盟替大头领护过三年戈壁私盐道，岂料头领见财起意，竟屠尽曾施水救过他一命的绿洲驼户。他趁夜割断头领坐骑马缰、一把火烧光粮草帐篷一路东逃；中原人嫌他浑身羊膻气味冲鼻，却无人敢小觑他那记贴地掠沙的绝命回锋刀。" },
	{ ID = "wx_bio_460", Text = "左手小指与无名指早年被西域马贼齐根削去，丝毫不碍%name%右手单刀劈风断骨。他在沙州驼铃商帮护镖十二载，走遍死亡戈壁每一条暗井商路，闭着眼也能嗅出沙暴何时压境。如今年过而立厌倦了满嘴咯牙的黄沙与滚烫日头，东来中原卖刀糊口，只盼攒足银子买间窗外看得见青杨绿柳的小院安稳度日。" },
	{ ID = "wx_bio_461", Text = "曾是西域圣火明尊教外围护法刀卫，因偷喝教规严禁的胡地葡萄酒，又于心不忍私放一名被掳的中原女俘，被执事绑在骆驼尾后拖行三里丢进乱石戈壁等死。%name%硬靠啃食带刺仙人掌熬过四昼夜爬到官驿，自此再不信什么圣火光明，世间唯一不会背叛他的，只有手里这口吹毛断发的镔铁弯刀。" },
	{ ID = "wx_bio_462", Text = "楼兰摸金商会昔年重金雇过%name%护送三口前朝青铜古箱，一路在流沙残垣里同苏醒尸傀及劫宝马贼血战五昼夜，出发时二十名好手活着走出戈壁的不到四个。分账时商帮管事竟想塞两块赝品残玉敷衍了事，他一刀削飞对方头巾，抓走应得的那袋银饼转身便走；他爱财极甚，却从不昧同袍半文卖命钱。" },
	{ ID = "wx_bio_463", Text = "闲来无事爱抱一把断了半根弦的旧胡琵琶瞎弹，可真拔刀出鞘，快得能把掠过眼前的荒漠毒蜂一劈两半。%name%原是瀚海小部族次子，部族在争夺绿洲水井的血战里覆灭殆尽，唯独他牵着一匹瞎眼瘦马逃进边关集镇。如今即便寒夜宿在漏风破草棚，怀里最紧护着的仍是那块擦刀用的羊脂油布。" },
	{ ID = "wx_bio_464", Text = "瀚海绿林吃过五年黑饭，摸透了大漠每一支马贼的暗语旗号与避风巢穴，后来收了河西商会的重金改行『洗沙』，专挑昔日结仇的马贼窝点夜袭下狠手。%name%步法诡谲飘忽、重心压得极低，宛如荒沙上贴地疾行的毒蝎，真碰上硬茬子更毫不讲究体面，扬一把沙土迷目便递出贴肋弯刀。" },
	{ ID = "wx_bio_465", Text = "发妻当年在绿洲集市被一名中原窜逃出来的邪派恶徒掳走，%name%背着一皮囊干馕与一口新月弯刀，从凉州风雪一直追查到江淮烟雨，最终却只在荒村破庙里寻得一具早已被野狗啃残的冰冷骸骨。大仇手刃之后，他胸口像被掏空了一大块，反倒不知该往何处归去，只得跟着四海漂泊的刀客以杀伐熬完余生。" },
	{ ID = "wx_bio_466", Text = "中原只要一下起连绵冷秋雨，%name%便裹紧那件掉毛破羊皮袄缩在炭火堆旁大骂老天爷漏了底，骂得最凶时连草鞋都不肯往泥水坑里踩半步。可只要战鼓一响、弯刀离鞘，那股大漠孤狼般的凶暴煞气立刻扑面而来，三步贴身、斜劈连斩，狠辣得叫敌人完全忘了这汉子方才还在火堆边不停打喷嚏。" }
];

// 68. 守誓侠客 (8 bios: wx_bio_467 .. wx_bio_474)
::Wuxia.Config.BackgroundBios["background.oathtaker"] <- [
	{ ID = "wx_bio_467", Text = "太和玄门恩师坐化前紧握%name%双手，嘱托他走遍九州寻回早年被邪派盗走的半册《太和玄虚剑谱》。七年寒暑晃眼即过，失书依旧杳无音讯，师兄弟们早寄信劝他回丹江云顶接任执事，他却将重誓刻在枣木牌上日夜贴身佩戴。世人背地笑他死脑筋，可每当他仗剑挡在素昧平生的乡民身前，连悍匪都忍不住脊背发直。" },
	{ ID = "wx_bio_468", Text = "北岳雄关的风雪见证过一桩血誓——当年与结义兄长对天饮酒，立誓『匪患未绝，不归故里』。谁知才过三年，兄长便受了藩镇节度使招安，穿着蟒袍在酒楼笑劝%name%识些时务。他一言不发，当众拔剑借桌角震断半截剑锋掷入酒盅，拂袖冒雪而去；如今换了新剑，人也瘦如枯竹，却独自把那句旧誓扛到了今日。" },
	{ ID = "wx_bio_469", Text = "年轻气盛时在西岳紫霞观下山历练，因客栈里一句冲撞错杀了一名无辜镖师，事后纵然倾尽家财抚恤遗孤，夜里合眼仍见血影。%name%在华山老君犁沟绝壁前长跪七昼夜，立誓此生护持百名良善行旅以赎前愆，每救一人便在剑柄密缠一道白麻绳；如今剑柄已缠六十三道，沾满暗红旧血，握在手里比千斤铁碑还沉。" },
	{ ID = "wx_bio_470", Text = "北岳守塞堂遭关外马贼与内鬼里应外合屠灭那夜，奄奄一息的老堂主将一块滚烫血铁令塞入%name%怀中，嘱咐他『莫叫恶徒安枕，莫负乱世孤弱』。他揣着这块沉甸甸的铁令独步江湖十载，穿烂四十双麻草鞋，哪怕饿得剥榆树皮充饥，也绝不肯接一单助纣为虐、欺凌乡里的脏银买卖。" },
	{ ID = "wx_bio_471", Text = "曾在姑苏书院读过几年圣贤书，后来又拜入嵩阳铁剑门修成一手沉稳刚猛的重剑直刺，偏生脾气像茅坑石头般又臭又硬。%name%立誓『诺出如山，绝不反悔』，早年替一家落魄米铺作保借债，东家连夜卷款跑路，他愣是替人押镖卖命两年还清本息；与这等死理侠客背靠背死战，你永不必提防身后挨冷刀。" },
	{ ID = "wx_bio_472", Text = "白马义从营护送救灾粮草途经官道，竟被贪功的藩镇官军当作乱党围杀殆尽，老营主临断气前嘶声吼道：『活下来的，替北地百姓留一口正气！』%name%从死人堆里爬出，折箭发誓终身不入公门、不拜权贵，唯凭胸中一口不平气与手里青锋行走末世；他平日沉默寡言不爱酗酒，每次遇强敌冲阵却永远抢在最前头。" },
	{ ID = "wx_bio_473", Text = "结义兄弟丧命于南疆五毒奇门毒瘴之前，气息微弱托付%name%代为照料洛阳城外失明老母。他点头应誓，此后整整十年省吃俭用，卖命挣来的血汗银十有八九皆托威远总镖局定期送往洛阳。直到去年老母安详闭目，他方才卸下重担重入刀剑江湖，只是每逢初一十五，仍改不了对着洛阳方向焚香默祷的旧习。" },
	{ ID = "wx_bio_474", Text = "江湖同道皆嘲笑%name%守的那条怪誓蠢透了顶——放走的降匪回头多半照旧祸害百姓。可他早年亲见藩镇破城后活埋数千降卒，心中由此刻下铁誓：『剑不斩跪徒，刃不加缚人。』若真撞见屡教不改的恶贼跪地求饶，他宁可把钢刀踢回对方脚边逼其再战，再堂堂正正一剑枭首，固执得连敌人都心里发毛。" }
];

// 69. 破寨悍侠 (6 bios: wx_bio_475 .. wx_bio_480)
::Wuxia.Config.BackgroundBios["background.orc_slayer"] <- [
	{ ID = "wx_bio_475", Text = "满脸纵横刀疤像紫黑蜈蚣从额角爬到下颌，全是这些年在荒山匪窟里同炼体药人贴身硬撼挣来的。那些灌满烈毒药汤的邪派巨汉刀劈难入、力能裂石，%name%偏偏专挑其肘膝骨节缝隙下重刀，三年里连端三座黑风血煞宗分舵。他恨透了邪宗拿活人炼药的勾当，每破一寨必先亲手劈碎黑丹炉才肯坐下喘气。" },
	{ ID = "wx_bio_476", Text = "一夜冲天大火把自家村寨烧成了白灰，%name%从滚烫炭堆里扒出三十斤开山重斧，孤身在太行群峰间辗转三载，连闯七处恶匪关隘，专劈包铁寨门与重装大当家。辽东劈山盟听闻凶名遣人相邀入盟做客卿，他嫌门派规矩拖沓婉言谢绝；如今每当听见山贼叫骂，他浑身骨节便噼啪作响，手痒得非劈开个豁口不可。" },
	{ ID = "wx_bio_477", Text = "在太行震岳门苦熬八年锤功，下山后偏不去大户人家守院护镖，专接官府与商帮无人敢签的『拔钉子』死契——专门清剿盘踞险关的重装悍匪与发狂药人。%name%常说轻剑细刀砍重甲无异隔靴搔痒，唯有重锤连甲带骨一并震成肉泥最省事；代价是双肘落下顽固暗伤，阴雨夜疼得非把胳膊泡进滚烫姜水里才睡得着。" },
	{ ID = "wx_bio_478", Text = "北境边关与黑水战帮硬撼厮杀整整十载，%name%在死人堆里磨出一套专克蛮力冲撞的架枪破甲狠招。关外巨汉抡着大斧咆哮扑来之际，新卒往往腿软后撤，唯独他敢逆锋踏前一步借势点喉。退伍归乡后见中原恶寨林立，他索性扛起旧枪踏入江湖，管你是黑风血煞还是绿林豪雄，全当关外蛮子一视同仁照捅不误。" },
	{ ID = "wx_bio_479", Text = "左耳少了半片耳廓，那是当年落入邪派地牢、险些被按进滚烫药缸炼成痴傻铁傀时留下的。%name%趁看守执事贪杯昏睡，硬用碎碗片割断麻绳，抢过一把厚背斩骨刀在幽暗甬道连劈五具药人与两名教徒杀出血路。自那起他只要望见筋肉异常暴突、眼神浑浊的炼体怪物，胸中杀意便如沸油泼火，连自己性命都浑然不顾。" },
	{ ID = "wx_bio_480", Text = "从不标榜什么替天行道、匡扶社稷，%name%热衷攻破山寨纯因恶匪窝里油水丰厚、州府赏格诱人。他将绿林老巢的死穴摸得门清——夜袭烧粮草、强弩点暗哨、集火劈死头目溃散众心，先后领着亡命散兵连挑四座险寨。可惜挣来的赏银总留不过十日，一进县城便输光在赌坊酒肆，输得精光再去寻下一座倒霉匪窝。" }
];

// 70. 铁血戒律侠 (4 bios: wx_bio_481 .. wx_bio_484)
::Wuxia.Config.BackgroundBios["background.paladin"] <- [
	{ ID = "wx_bio_481", Text = "『行刑执律』四字在中原正道无人敢轻易接下，%name%却背着这副冷血担子走了八年，专司清理勾结邪宗、残害良善的名门败类。那年查实昔日授业恩师暗贩毒丹害死十余村人，他红着眼眶亲手一剑穿心；自此旧同门皆视他作六亲不认的冷血怪物，再无人肯同桌饮酒。他从不辩白半句，只把戒律刻进骨髓，剑锋所向绝不论亲疏。" },
	{ ID = "wx_bio_482", Text = "踏平三处湘西尸傀邪坛、亲眼见过活剥人皮炼阵的惨状后，%name%的心肠早已淬得比玄铁还冷硬。他为自己立下三条铁律：绝不沾邪功、绝不收脏银、绝不留妖人活口。有回同行顺手揣走邪教祭坛上一只银盏，被他当场一剑劈成两截扔进臭沟；大伙私下怕他如活阎王，却又暗自庆幸这煞星站在自己这头。" },
	{ ID = "wx_bio_483", Text = "左臂皮肉以烧红钢针刺满密密麻麻的师门戒铭，发誓此生不贪财色、不违公义、临敌绝不后退半步。藩镇叛卒屠掠乡野那年，%name%孤身横剑独守石桥，身受七创、铁甲结满暗红血冰仍立而不倒，硬生生撑到援兵赶至。他不懂变通圆滑，更听不懂市井荤笑话，可在这礼崩乐坏的末世里，这根死板硬骨头竟比赤金还金贵。" },
	{ ID = "wx_bio_484", Text = "师门满门遭叛徒勾结黑风血煞宗夜袭屠戮，唯有%name%重伤滚落寒崖得以残生。他将染血戒律卷轴缝进贴身皮袄，十年间千里独行，亲手手刃四名当年凶手，如今只剩最后一名仇魁隐匿于乱世藩镇麾下。他眼底早已熄灭了所有风花雪月，唯余一口沉静得近乎骇人的寒冽杀机，与一丝不苟、分毫不让的森严正气。" }
];

// 71. 受雇名刀客 (8 bios: wx_bio_485 .. wx_bio_492)
::Wuxia.Config.BackgroundBios["background.sellsword"] <- [
	{ ID = "wx_bio_485", Text = "『看宅一日三两，护货过岭五十，要砍成名悍匪头目得先付一半定银。』%name%自淮阳金刀门出师单干十载，怀里那本蓝布小账记得比钱庄老掌柜还细。世人嘲他掉进钱眼、毫无侠气，可江湖上谁也挑不出他半点字号毛病——只要定银称足分量入袋，哪怕对面横着神机火器营的火铳阵，他也绝不早退半步。" },
	{ ID = "wx_bio_486", Text = "原是洛阳长风镖局金牌老镖师，因义气替故友私押一趟没走官批的红货，被总镖头按帮规扫地出门。%name%也不恼恨，揣着一口厚背雁翎刀流连南北茶肆专接硬活。他刀法沉稳厚重，最擅在乱军中卡位护住脆弱的弓弩同袍；唯一改不掉的毛病是每回结完赏钱，必先赊两斤老花雕配五香驴肉，吃饱喝足才肯谈下一单生意。" },
	{ ID = "wx_bio_487", Text = "替两淮盐商守过仓、替州府知县剿过山匪、替川江盐帮撑过场，甚至帮神机火器营暗押过三车硫磺硝石。%name%在刀口混迹二十年，赖以长命的绝学并非刀有多快，而是鼻子比老猎犬还灵——只要嗅出一丁点东家想赖账、或者拿雇佣刀客当炮灰填坑的苗头，他准保在天黑前卷起铺盖跑得干干净净。" },
	{ ID = "wx_bio_488", Text = "浑身上下大小旧创二十七处，江湖同道皆送%name%外号『半条命』。最险一回被南疆五毒吹箭擦破肋肉，毒气顷刻发黑攻心，他硬是用篝火烧红短匕，死咬木棍亲手剜下一大块腐肉熬出鬼门关。自此他雇佣价码连翻三倍，嘴边常挂着一句冷话：『买我的快刀好商量，要买我剩下的半条命，得另加足色银子。』" },
	{ ID = "wx_bio_489", Text = "两鬓早已染霜，却还套着一身磨亮的旧铁叶甲在刀剑堆里讨活计。旁人只道%name%老来贪财嗜杀，无人知晓他每隔半年必绕道扬州，站在城西一家小裁缝铺斜对角远远看一眼已为人妇的女儿，托货郎悄悄塞去五十两银票便悄然隐去。女儿一直以为亲爹早战死辽东，他觉得这样挺好，免得自己满身血腥气脏了孩子门槛。" },
	{ ID = "wx_bio_490", Text = "洞庭连环水寨吃过几年水饭，后来%name%洗净案底专做富豪护院与黑道调停的买卖。他左手短刀封门锁腕、右手长刀掠颈断喉，曾在太湖画舫上以一敌五保住雇主一家老小，自己仅划破半截袖口。此人张口闭口都是市井荤话，偏偏对兵器挑剔得要命，哪怕刚砍完人累得喘粗气，也绝不容刀刃留半星血锈。" },
	{ ID = "wx_bio_491", Text = "清风剑派外堂昔日颇具声望的一柄好剑，只因念及同门情谊替师兄顶了私售灵丹的黑锅，惨遭执法长老当众废籍逐下山来。心冷如灰后，%name%彻底扯下名门正派的体面外衣，改做明码标价的雇佣刀客；如今他剑路早已混入绿林断筋狠招，再无昔日飘逸雅态，取人性命却比从前利落三分。" },
	{ ID = "wx_bio_492", Text = "队伍只要在城镇停脚，十有八九能从乌烟瘴气的牌九桌边把%name%揪出来，且多半已输得只剩一件贴身中衣。偏生此人一旦握紧刀柄便判若两人，双目清冷如水、手腕稳若青松，连黑风血煞宗的成名头目都曾饮恨于他三招快刀之下。雇主们对他又爱又恨，只得把工钱拆成碎铜钱按日发放，省得一夜全归了赌坊。" }
];

// 72. 退隐剑宗名宿 (8 bios: wx_bio_493 .. wx_bio_500)
::Wuxia.Config.BackgroundBios["background.swordmaster"] <- [
	{ ID = "wx_bio_493", Text = "三十年前在西岳南峰连败七名同辈英豪，江湖皆尊称%name%一声『一剪寒风』。如今年过花甲，双膝每逢梅雨阴寒便咯吱作痛，气血早不如壮年浑厚，可那双布满褐斑的枯手只要搭上三尺青锋，剑影依旧快得叫后生晚辈摸不着边际。退隐松林十载如今忽又出山，只因老妻病故后那间茅屋实在太静，静得教老头儿发慌。" },
	{ ID = "wx_bio_494", Text = "太湖孤岛的涛声听足了二十载，反倒叫%name%将姑苏慕氏繁复的『回风拆招』削去七成，只留最简练索命的几式点刺。当年他因痴迷剑理荒废庄中庶务，被族里精明的后辈联手架空发配看守剑冢；去岁惊雷劈断岛上老松，老剑痴索性背起旧剑撑舟离岛，盼在入土前再会几名配得上出剑的真英雄。" },
	{ ID = "wx_bio_495", Text = "曾在西岳紫霞观剑术称雄一时，只因在长安闹市一剑挑断藩镇权贵爱将的手筋，招致官军与幽冥隐杀楼联手悬赏追杀。%name%被迫易名隐居终南山麓砍柴烧炭十五年，直到今春山村遭黑风马贼洗劫，他随手折了根青竹竿挑翻四名悍匪，惊觉指尖剑意未朽，遂连夜扒开灶底挖出油布包着的旧剑，再踏这浑浊尘世。" },
	{ ID = "wx_bio_496", Text = "当年嵩阳铁剑门声威正盛时，%name%曾与昆仑玄冰宫长老雪夜约战于太行断崖，三百招后虽险胜半式，本命重剑却受寒劲冻裂寸断，经脉亦埋下玄阴暗疾。此后他封剑隐于洛阳深巷，靠替茶馆拍醒木说旧武林轶事糊口；近来胸中寒毒日益难压，老郎中言需重金买奇药续命，他苦笑一声，只得重执三尺青锋挣这最后几两药钱。" },
	{ ID = "wx_bio_497", Text = "在终南活死人庐幽谷枯修阴柔剑意半生，头发早白得宛如冬雪，身形削瘦得仿佛一阵山风就能刮倒。%name%自己都快忘却当年为何避世入谷，只记得走出山林那日满坡秋叶落尽，摸遍补丁长袍竟掏不出买一碗热汤面的铜钱。莫笑他走快两步便轻咳喘气，但凡有人不长眼逼入三步之内，没人能在那柄无声细剑下走过两合。" },
	{ ID = "wx_bio_498", Text = "年轻时在青城幽谷观犯下色戒，携佳人私奔下山竟酿成同门血案，从此愧颜远遁。五十载风霜雪雨熬尽，红颜早已化作江南一抔黄土，唯独腰间那口青钢剑被%name%磨得比当年细瘦一圈。平日里他总蜷在辎重车角咳嗽打盹，活像个行将就木的老药农，唯有贼刃劈至面门那瞬，一抹雪亮剑光方叫敌手明白何谓剑宗余威。" },
	{ ID = "wx_bio_499", Text = "四十岁那年自负中原无敌，意气风发赴会稽鱼肠剑庐挑战铸剑老祖，却在第三十七招遭对方三寸短匕挑断左足跟腱。惨败之后%name%躲进乡野破酒坊连喝十年闷酒，反倒从醉眼昏花中悟透以静制动、后发先至的绝妙剑理。如今他一瘸一拐连追个毛贼都气喘吁吁，却能稳立原地连卸三柄狂刀不退半寸。" },
	{ ID = "wx_bio_500", Text = "江湖旧闻皆传%name%昔年原是太和玄门掌门的不二人选，却在继任前夕撞破几位师兄暗通阉党、谋害忠良的丑事，一怒之下当众削断道冠弃剑下山。如今年过六旬，他最爱缩在酒肆角落喝着浑浊米酒，冷言毒舌嘲讽那些满口仁义的新锐弟子；自知气血衰败、时日无多，宁可死在乱世血雨里，也不愿老死在满是算计的名门高堂。" }
];
