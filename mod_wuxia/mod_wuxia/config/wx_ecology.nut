// Non-destructive Shan Hai Jing Bestiary Trophy Mapping (item IDs stay 100% vanilla so all recipes work seamlessly)
::Wuxia.Config.TrophyMap <- {
	["misc.unhold_heart"]        = { Name = "朱厌心头赤血核", Desc = "取自《山海经》凶猿朱厌胸腔的炽热血核，生机狂烈，是百工丹房炼制「洗髓丹」与山海宝甲的主材。" },
	["misc.unhold_hide"]         = { Name = "朱厌白首厚革", Desc = "刀剑难伤的朱厌巨猿坚韧厚皮，既可缝制山海重铠，亦可提取护脉胶质炼制「护脉丹」。" },
	["misc.unhold_bones"]        = { Name = "朱厌千钧铁骨", Desc = "沉重如玄铁的朱厌巨骨，百工巧匠常用来锻造异兽重铠或熬炼筋骨药膏。" },
	["misc.lindwurm_bones"]      = { Name = "肥遗毒蛟龙脊骨", Desc = "太华肥遗毒蛟通体最精粹的脊柱龙骨，蕴含惊人髓力，可入炉炼制「洗髓丹」或锻造山海防具。" },
	["misc.lindwurm_blood"]      = { Name = "肥遗蚀铁紫毒血", Desc = "触铁即蚀的霸道肥遗真血，须以寒玉瓶封存，百工可用于淬炼神兵宝甲。" },
	["misc.lindwurm_scales"]     = { Name = "肥遗赤黑重鳞", Desc = "水火难侵的肥遗毒蛟逆鳞，缀于衣甲之上可成刀枪不入的山海鳞铠。" },
	["misc.spider_silk"]         = { Name = "鬼面赤蛛天韧丝", Desc = "采自毒谷赤蛛腹囊的雪白柔韧蛛丝，轻若无物且含微寒药性，可织轻甲或辅炼「凝神丸」。" },
	["misc.poison_gland"]        = { Name = "异兽五毒腺囊", Desc = "完整的山海毒虫腺囊，以毒攻毒之法可配朱厌厚革炼制「护脉丹」，亦可淬炼奇宝。" },
	["misc.ghoul_brain"]         = { Name = "狍鸮颅内髓珠", Desc = "北山食人贪兽狍鸮（饕餮支裔）颅内凝结的奇异髓珠，去秽存菁后可一次炼出两枚「凝神丸」。" },
	["misc.ghoul_horn"]          = { Name = "狍鸮弯钩凶角", Desc = "老狍鸮额顶倒弯利角，质若精钢，常作猎妖凭证与百工兽胄辅材。" },
	["misc.ghoul_teeth"]         = { Name = "狍鸮裂骨虎齿", Desc = "《北山经》载狍鸮『虎齿人爪』，其锯齿凶牙可换重赏或镶嵌凶兵。" },
	["misc.werewolf_pelt"]       = { Name = "阴山天狗苍裘", Desc = "剥自阴山异种苍狼的厚实毛皮，御寒挡刃，可缝制山海轻皮甲。" },
	["misc.hyena_fur"]           = { Name = "西山蛊雕斑革", Desc = "西山食人狂兽蛊雕的粗粝斑纹兽革，轻便坚韧，极宜裁作逐风轻衣。" },
	["misc.serpent_skin"]        = { Name = "苍梧巴蛇青鳞皮", Desc = "吞鹿巴蛇蜕下的大片青黑鳞皮，柔韧滑溜刀箭难穿，乃裁制巴蛇鳞冠之上品。" },
	["misc.glistening_scales"]   = { Name = "巴蛇微光逆鳞", Desc = "暗处泛着幽泽的巴蛇腹下细鳞，市肆与百工坊收价不菲。" },
	["misc.heart_of_the_forest"] = { Name = "都广建木万年灵心", Desc = "建木树精核心凝结的苍翠神木心，生机不绝，可打造建木生机宝甲。" },
	["misc.glowing_resin"]       = { Name = "建木琥珀灵脂", Desc = "都广建木断枝渗出的莹润灵脂，气味清冽醒神，百工用以浸润甲叶减重。" },
	["misc.witch_hair"]          = { Name = "青丘妖魅惑心发", Desc = "缠绕狐媚异香的雪白长发，配合九尾幻丹可炼制定魂异宝。" },
	["misc.parched_skin"]        = { Name = "古墓血魔枯蜕", Desc = "自前朝血影剑魔残躯剥落的干枯皮膜，阴寒刺骨。" },
	["misc.shimmering_ashes"]    = { Name = "幽冥剑魔灵烬", Desc = "古墓剑魔溃散后留下的微光骨烬，蕴含精纯阴煞。" },
	["misc.petrified_scream"]    = { Name = "荒冢凝魄寒晶", Desc = "夺魄怨灵消散时凝结的惨白晶石，握之如坠冰窟。" },
	["misc.third_eye"]           = { Name = "讹兽梦魇诡眼", Desc = "幽谷梦魇讹兽眉心不腐的第三只妖眼，暗合奇门定魂之术。" }
};

// 4 Major Late-Game Jianghu Crises mapped onto vanilla Crisis keys
::Wuxia.Config.CrisisLore <- {
	greenskins = { Title = "武林大势：药人战帮联军犯境", Summary = "邪派炼体总瓢把子与五毒奇门合流，驱使成群血狂药人席卷各州村镇！" },
	undead     = { Title = "武林大势：前朝古墓与湘西尸变", Summary = "地脉阴气暴涨，前朝镇陵金甲卫破封而出，湘西赶尸邪宗趁乱驱尸屠城！" },
	civilwar   = { Title = "武林大势：藩镇节度使世家纷争", Summary = "朝纲失统，各地藩镇节度使与门阀世家陈兵厮杀，江湖各派皆被卷入战火！" },
	holywar    = { Title = "武林大势：南北武林道统大战", Summary = "南北群雄与西域军镇因圣迹道统反目成仇，大军压境血染关隘！" }
};
